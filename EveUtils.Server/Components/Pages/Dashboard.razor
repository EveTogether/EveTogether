@page "/"
@rendermode InteractiveServer
@attribute [Authorize(Policy = PanelPermissions.DashboardView)]
@using EveUtils.Server.Components.Overview
@using EveUtils.Server.DataExplorer

<div class="explorer">
    <div class="crumbs">Overview / <b>Dashboard</b></div>
    <div class="ph">
        <h2>Server data</h2>
        <span class="meta">What exists, what is live right now, and what needs cleaning up.</span>
    </div>
    <div class="listcol">
        <div class="ov">
            @if (_overview is { } overview)
            {
                <div class="kpis">
                    <OverviewTileCard Label="Characters" Tile="overview.Characters" Href="@DataLinks.List(DataEntity.Characters)" />
                    <OverviewTileCard Label="Fleets" Tile="overview.Fleets" Href="@DataLinks.List(DataEntity.Fleets)" />
                    <OverviewTileCard Label="Compositions" Tile="overview.Compositions" Href="@DataLinks.List(DataEntity.Compositions)" />
                    <OverviewTileCard Label="Shared fits" Tile="overview.SharedFits" Href="@DataLinks.List(DataEntity.SharedFits)" />
                    <OverviewTileCard Label="Runs" Tile="overview.RunGroups" Href="@DataLinks.List(DataEntity.Runs)" />
                    <OverviewTileCard Label="Sessions" Tile="overview.Sessions" Href="@DataLinks.List(DataEntity.Sessions)" />
                </div>
            }
            <div class="ovgrid">
                <div class="ovcol">
                    @if (_overview is { } data)
                    {
                        <AttentionList Items="data.Attention" />
                    }
                    else if (_canViewData)
                    {
                        <p class="dim loading">Loading…</p>
                    }
                </div>
                <div class="ovcol">
                    <RightNow ShowFleets="_canViewData" />
                    @if (_overview is not null)
                    {
                        <RelationMap Overview="_overview" />
                    }
                    <Card Title="Server" Pad="true">
                        <p class="dim fplabel">TLS cert fingerprint — pin this in the client during pairing (TOFU):</p>
                        <p class="fp">@Fingerprint</p>
                        <div class="switchrow">
                            <div class="lbl"><span class="c">fit.sync</span> — allow clients to share fittings via this server</div>
                            <label class="switch"><input type="checkbox" aria-label="fit.sync" @bind="FitSyncEnabled" /><span class="track"><span class="knob"></span></span></label>
                        </div>
                        <div class="switchrow">
                            <div class="lbl"><span class="c">fit.manage</span> — allow clients to delete fits from the shared library</div>
                            <label class="switch"><input type="checkbox" aria-label="fit.manage" @bind="FitManageEnabled" /><span class="track"><span class="knob"></span></span></label>
                        </div>
                    </Card>
                </div>
            </div>
        </div>
    </div>
</div>
