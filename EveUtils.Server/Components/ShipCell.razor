@using EveUtils.Shared.Modules.Sde
@inject ISdeAccessor Sde
@* A ship type as the panel shows it: icon + SDE name, id as selectable mono text and in the tooltip. A type the SDE
   does not know (stale build, unavailable store) is marked rather than left blank. *@
<span class="ent" title="@Tooltip">
    <img class="ent-img" src="https://images.evetech.net/types/@TypeId/icon?size=64" width="26" height="26" loading="lazy" alt="" onerror="this.style.visibility='hidden'" />
    @if (_known)
    {
        <span class="ent-name bright">@_name</span>
    }
    else
    {
        <span class="ent-name unresolved">⚠ Not in SDE</span>
    }
    <code class="idchip">@TypeId</code>
</span>

@code {
    [Parameter, EditorRequired] public int TypeId { get; set; }

    private string _name = string.Empty;
    private bool _known;

    private string Tooltip => _known ? $"{_name} · type id {TypeId}" : $"Type {TypeId} is not in the loaded SDE";

    protected override void OnParametersSet() => _known = Sde.TryGetTypeName(TypeId, out _name!);
}
