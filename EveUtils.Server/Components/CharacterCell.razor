@* A character as the panel shows it: portrait + name, with the id kept as selectable mono text and in the tooltip.
   The portrait is loaded by the admin's browser from images.evetech.net; the server never fetches it. With an Href the
   name opens that character's own record; list rows drop the id chip because the tooltip and the pane already carry it. *@
<span class="ent" title="@Tooltip">
    <img class="ent-img round" src="https://images.evetech.net/characters/@Id/portrait?size=64" width="26" height="26" loading="lazy" alt="" onerror="this.style.visibility='hidden'" />
    @if (Href is not null)
    {
        <RecordLink Href="@Href"><span class="ent-name @(Name is null ? "unresolved" : null)">@(Name ?? "Unknown character")</span></RecordLink>
    }
    else
    {
        <span class="ent-name @(Name is null ? "unresolved" : "bright")">@(Name ?? "Unknown character")</span>
    }
    @if (ShowId)
    {
        <code class="idchip">@Id</code>
    }
</span>

@code {
    [Parameter, EditorRequired] public long Id { get; set; }
    [Parameter] public string? Name { get; set; }
    [Parameter] public string? Href { get; set; }
    [Parameter] public bool ShowId { get; set; } = true;

    private string Tooltip => Name is null ? $"Name could not be resolved · character id {Id}" : $"{Name} · character id {Id}";
}
