@using EveUtils.Server.DataExplorer
<span class="pill @Class">@Label(Status)</span>

@code {
    [Parameter, EditorRequired] public SessionPanelStatus Status { get; set; }

    public static string Label(SessionPanelStatus status) => status switch
    {
        SessionPanelStatus.Live => "Live",
        SessionPanelStatus.Idle => "Idle",
        _ => "Lapsing",
    };

    private string Class => Status switch
    {
        SessionPanelStatus.Live => "live",
        SessionPanelStatus.Idle => "off",
        _ => "warn",
    };
}
