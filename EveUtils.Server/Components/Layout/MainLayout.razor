@inherits LayoutComponentBase
@using System.Security.Claims
@inject NavigationManager Navigation

<div class="appshell">
    <header class="topbar">
        <div class="brand">
            <img class="badge" src="img/eve-together-badge.png" alt="EVE Together" />
            <span class="nm">EVE <b>TOGETHER</b></span>
            <span class="env">Server</span>
        </div>
        <AuthorizeView>
            <Authorized>
                <div class="acct">
                    <span class="perm">
                        @_PermissionChip(context.User, PanelPermissions.DataView, "DATA · VIEW", "Data · View", null)
                        @_PermissionChip(context.User, PanelPermissions.DataDelete, "DATA · DELETE", "Data · Delete", "del")
                    </span>
                    <span class="who">
                        <span class="u">@context.User.Identity?.Name</span>
                        <span class="r">@(context.User.IsSuperAdmin() ? "Administrator · superadmin" : "Admin")</span>
                    </span>
                    <a class="acctlink" href="/account/password">Password</a>
                    <form method="post" action="/account/logout" class="navlogout">
                        <AntiforgeryToken />
                        <button type="submit">Sign out</button>
                    </form>
                </div>
            </Authorized>
        </AuthorizeView>
    </header>
    <div class="body">
        <AuthorizeView>
            <Authorized>
                <nav class="sidebar">
                    <div class="seclbl">Overview</div>
                    <NavLink href="/" Match="NavLinkMatch.All" ActiveClass="active" title="Dashboard"><NavIcon Name="dashboard" /><span class="t">Dashboard</span></NavLink>
                    <NavLink href="/esi" ActiveClass="active" title="ESI metrics"><NavIcon Name="esi" /><span class="t">ESI metrics</span></NavLink>
                    <NavLink href="/logs" ActiveClass="active" title="Logs"><NavIcon Name="logs" /><span class="t">Logs</span></NavLink>
                    <AuthorizeView Policy="@PanelPermissions.DataView" Context="data">
                        <DataNav />
                    </AuthorizeView>
                    <div class="seclbl">Access</div>
                    <NavLink href="/allowed" ActiveClass="active" title="Allowed-list"><NavIcon Name="allowed" /><span class="t">Allowed-list</span></NavLink>
                    <NavLink href="/api-keys" ActiveClass="active" title="API keys"><NavIcon Name="keys" /><span class="t">API keys</span></NavLink>
                    <div class="seclbl">Administration</div>
                    <NavLink href="/users" ActiveClass="active" title="Users"><NavIcon Name="users" /><span class="t">Users</span></NavLink>
                    <NavLink href="/roles" ActiveClass="active" title="Roles"><NavIcon Name="roles" /><span class="t">Roles</span></NavLink>
                    <NavLink href="/backup" ActiveClass="active" title="Backup"><NavIcon Name="backup" /><span class="t">Backup</span></NavLink>
                    <div class="seclbl">Live</div>
                    <a href="/stream/dps" target="_blank" title="DPS stream"><NavIcon Name="live" /><span class="t">DPS stream ↗</span></a>
                </nav>
            </Authorized>
        </AuthorizeView>
        <main class="content">
            @Body
        </main>
    </div>
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is null)
            return;

        var user = (await AuthState).User;
        if (user.Identity?.IsAuthenticated == true && user.HasClaim(AdminClaims.MustChangePassword, "true"))
        {
            var path = new Uri(Navigation.Uri).AbsolutePath;
            if (!path.Equals("/account/password", StringComparison.OrdinalIgnoreCase))
                Navigation.NavigateTo("/account/password");
        }
    }

    /// <summary>A missing permission stays in the bar, struck through, so the split between looking and deleting is always
    /// visible rather than discovered at a disabled button.</summary>
    private static RenderFragment _PermissionChip(ClaimsPrincipal user, string code, string label, string name, string? tone) => __builder =>
    {
        var has = user.HasPanelPermission(code);
        <span class="pchip @(has ? $"has {tone}" : "no")" title="@(has ? $"You have {name}" : $"You do not have {name}")"
              aria-label="@(has ? $"{name}: granted" : $"{name}: not granted")">@label</span>
    };
}
