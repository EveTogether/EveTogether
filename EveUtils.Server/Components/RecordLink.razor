@* A link to another record from inside a list row or a detail pane. It stops the click from also selecting the row it
   sits in, which would otherwise navigate twice. *@
<a class="lnk" href="@Href" title="@Title" @onclick:stopPropagation="true">@ChildContent</a>

@code {
    [Parameter, EditorRequired] public string Href { get; set; } = string.Empty;
    [Parameter] public string? Title { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
