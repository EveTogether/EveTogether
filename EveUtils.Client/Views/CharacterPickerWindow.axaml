<v:ChromedWindow xmlns="https://github.com/avaloniaui" xmlns:v="using:EveUtils.Client.Views"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dlg="using:EveUtils.Client.Dialogs"
        xmlns:sh="using:EveUtils.Client.Views.Shared"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        mc:Ignorable="d" d:DesignWidth="440" d:DesignHeight="420"
        x:Class="EveUtils.Client.Views.CharacterPickerWindow"
        x:Name="Root"
        Width="440" SizeToContent="Height" MaxHeight="640"
        WindowStartupLocation="CenterOwner"
        Title="Choose character">

    <!-- Styles live on the content root, never on the window: ModuleHostService lifts Content out to dock a module
         and anything left on the window stays behind (ET-42/ET-156). This dialog is modal and never docked, but the
         rule is cheap to keep. -->
    <DockPanel Margin="16">
        <DockPanel.Styles>
            <!-- A disabled option is still shown (Enabled binds ListBoxItem.IsEnabled below) but cannot be
                 focused/selected — the padding moves onto CharacterPickRowView's own root Border instead, so the
                 row card owns its own edge. -->
            <Style Selector="ListBox.picklist ListBoxItem" x:DataType="dlg:CharacterPickRowViewModel">
                <Setter Property="Padding" Value="0"/>
                <Setter Property="IsEnabled" Value="{Binding Enabled}"/>
            </Style>
            <!-- The theme's own lighter-bar selected look is exactly what ET-184 replaces; the row card carries
                 the selected state instead (CharacterPickRowView). -->
            <Style Selector="ListBox.picklist ListBoxItem:selected /template/ ContentPresenter">
                <Setter Property="Background" Value="Transparent"/>
            </Style>
        </DockPanel.Styles>

        <TextBlock x:Name="PromptText" DockPanel.Dock="Top"
                   FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,12"
                   Foreground="{StaticResource TextBrightBrush}"/>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"
                    Spacing="8" Margin="0,12,0,0">
            <Button Content="Cancel" Click="OnCancel"/>
            <Button Content="Choose →" Click="OnConfirm" Classes="accent"/>
        </StackPanel>

        <!-- Search (ET-16 D-point-8): only once scrolling stops being the faster way to find a name
             (CharacterPickerSearch.SearchThreshold). -->
        <TextBox x:Name="SearchBox" DockPanel.Dock="Top" Margin="0,0,0,8" FontSize="11"
                  PlaceholderText="{Binding SearchWatermark, ElementName=Root}"
                  Text="{Binding SearchText, ElementName=Root, Mode=TwoWay}"
                  IsVisible="{Binding ShowSearch, ElementName=Root}"/>

        <Border Classes="panel">
            <ListBox x:Name="OptionList" Classes="picklist" ItemsSource="{Binding FilteredOptions, ElementName=Root}"
                     SelectionMode="Single" Margin="6"
                     DoubleTapped="OnConfirm">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="dlg:CharacterPickRowViewModel">
                        <sh:CharacterPickRowView IsMultiSelect="{Binding IsMultiSelect, ElementName=Root}"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </DockPanel>
</v:ChromedWindow>
