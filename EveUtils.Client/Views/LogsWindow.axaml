<v:ChromedWindow xmlns="https://github.com/avaloniaui" xmlns:v="using:EveUtils.Client.Views"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:EveUtils.Client.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="640" d:DesignHeight="560"
        x:Class="EveUtils.Client.Views.LogsWindow"
        x:Name="LogsRoot"
        x:DataType="vm:ClientLogViewModel"
        Width="640" Height="560"
        WindowStartupLocation="CenterOwner"
        Title="App Logs">

    <DockPanel Margin="16">

        <!-- Header -->
        <StackPanel DockPanel.Dock="Top" Spacing="3" Margin="0,0,0,12">
            <TextBlock Text="APP LOGS" FontWeight="Bold" FontSize="16"
                       Foreground="{StaticResource TextBrightBrush}"/>
            <TextBlock Text="Captured warnings and errors (newest first). Updates live."
                       FontSize="11" Foreground="{DynamicResource TextAccentBrush}"/>
        </StackPanel>

        <!-- Footer: Refresh / Clear / Close -->
        <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto,Auto,*,Auto" Margin="0,12,0,0">
            <Button Grid.Column="0" Content="Refresh" Command="{Binding RefreshCommand}" ToolTip.Tip="F5 / Ctrl+R"/>
            <Button Grid.Column="1" Content="Clear" Command="{Binding ClearCommand}" Classes="danger" Margin="8,0,0,0"/>
            <Button Grid.Column="3" Content="Close" Click="OnClose" Classes="accent"/>
        </Grid>

        <TabControl x:Name="LogTabs">
        <TabItem Header="LOG">
        <Panel>
            <TextBlock Text="No entries logged." IsVisible="{Binding IsEmpty}"
                       Foreground="{DynamicResource TextAccentBrush}"/>

            <ScrollViewer IsVisible="{Binding !IsEmpty}">
                <ItemsControl ItemsSource="{Binding Entries}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ClientLogRowViewModel">
                            <Border Classes="panel" Padding="10,8" Margin="0,0,0,6">
                                <StackPanel Spacing="5">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="{Binding TimeText}" FontSize="10"
                                                       Foreground="{DynamicResource TextAccentBrush}"/>
                                            <TextBlock Text="{Binding LevelText}" FontSize="10" FontWeight="Bold"
                                                       Foreground="{Binding LevelBrush}"/>
                                            <TextBlock Text="{Binding Category}" FontSize="10"
                                                       Foreground="{DynamicResource TextAccentBrush}"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="Copy" FontSize="10" Padding="8,2"
                                                VerticalAlignment="Center"
                                                ToolTip.Tip="Copy this entry to the clipboard"
                                                Command="{Binding #LogsRoot.((vm:ClientLogViewModel)DataContext).CopyEntryCommand}"
                                                CommandParameter="{Binding}"/>
                                    </Grid>
                                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap"
                                               Foreground="{StaticResource TextBrightBrush}"/>
                                    <Expander Header="Exception" IsVisible="{Binding HasException}">
                                        <TextBlock Text="{Binding ExceptionText}" TextWrapping="Wrap" FontSize="10"
                                                   Foreground="{DynamicResource TextAccentBrush}"/>
                                    </Expander>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Panel>
        </TabItem>

        <!-- ── Item names the EVE static data does not know yet (ET-460) ── -->
        <TabItem Header="UNRECOGNISED ITEMS" IsVisible="{Binding Unrecognised, Converter={x:Static ObjectConverters.IsNotNull}}">
            <DockPanel DataContext="{Binding Unrecognised}" x:DataType="vm:UnrecognisedItemsLogViewModel" Margin="0,8,0,0">
                <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,8">
                    <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextAccentBrush}"
                               Text="Item names that were copied or typed in but that the EVE static data does not know yet, such as new event items. They count as 0 until the data knows them, then they are recognised and priced by themselves."/>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Content="Re-price unrecognised items" Classes="accent"
                                Command="{Binding RepriceCommand}" IsEnabled="{Binding !IsBusy}"/>
                        <CheckBox Content="Show resolved" IsChecked="{Binding ShowResolved, Mode=TwoWay}"/>
                        <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" FontSize="11"
                                   Foreground="{DynamicResource TextAccentBrush}"/>
                    </StackPanel>
                </StackPanel>
                <TextBlock Text="{Binding EmptyText}" IsVisible="{Binding IsEmpty}" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextAccentBrush}"/>
                <ScrollViewer IsVisible="{Binding !IsEmpty}">
                    <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:UnrecognisedItemRowViewModel">
                                <Border Classes="panel" Padding="10,8" Margin="0,0,0,6">
                                    <StackPanel Spacing="3">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" TextWrapping="Wrap"
                                                       Foreground="{StaticResource TextBrightBrush}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding QuantityText}"
                                                       Foreground="{StaticResource TextBrightBrush}"/>
                                        </Grid>
                                        <TextBlock FontSize="10" Foreground="{DynamicResource TextAccentBrush}">
                                            <Run Text="{Binding RunsText}"/>
                                            <Run Text=" · "/>
                                            <Run Text="{Binding FirstSeenText}"/>
                                            <Run Text=" · "/>
                                            <Run Text="{Binding SourcesText}"/>
                                        </TextBlock>
                                        <TextBlock FontSize="10" Text="{Binding ResolvedText}" IsVisible="{Binding IsResolved}"
                                                   Foreground="{DynamicResource TextAccentBrush}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </TabItem>
        </TabControl>
    </DockPanel>
</v:ChromedWindow>
