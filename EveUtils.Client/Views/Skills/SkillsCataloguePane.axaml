<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vs="using:EveUtils.Client.ViewModels.Skills"
             xmlns:sk="using:EveUtils.Client.Views.Skills"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="700"
             x:Class="EveUtils.Client.Views.Skills.SkillsCataloguePane"
             x:DataType="vs:SkillsCatalogueViewModel">

    <!-- CATALOGUE (ET-16), laid out as mockup v5 screen a: filter and search, the 3 × 8 block of groups (a bar for the
         share of levels trained), the picked group's skills in two columns, and the shared 400 px detail pane. -->
    <UserControl.Styles>
        <Style Selector="ListBox.tiles, ListBox.skilllist">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style Selector="ListBox.tiles ListBoxItem, ListBox.skilllist ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="ListBox.tiles ListBoxItem:selected /template/ ContentPresenter, ListBox.skilllist ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Border.tile">
            <Setter Property="Margin" Value="0,0,6,4"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Background" Value="#0DFFFFFF"/>
        </Style>
        <Style Selector="Border.tile.selected">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
        </Style>
        <Style Selector="Border.tile:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
        </Style>
        <Style Selector="Border.tile.empty TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
        </Style>
        <Style Selector="Border.skillrow">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Border.skillrow.selected">
            <Setter Property="Background" Value="{DynamicResource BgRowSelectedBrush}"/>
        </Style>
        <Style Selector="Border.skillrow:pointerover">
            <Setter Property="Background" Value="{DynamicResource BgRowHoverBrush}"/>
        </Style>
        <Style Selector="Border.queuechip">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Border.queuechip > TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
            <Setter Property="FontSize" Value="9.5"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBrightBrush}"/>
        </Style>
    </UserControl.Styles>

    <Grid ColumnDefinitions="*,400">
        <DockPanel Grid.Column="0">
            <!-- Filter + search + totals. -->
            <Grid DockPanel.Dock="Top" ColumnDefinitions="150,260,*" ColumnSpacing="8" Margin="14,10,14,8">
                <ComboBox Grid.Column="0" FontSize="11" HorizontalAlignment="Stretch" ItemsSource="{Binding FilterOptions}"
                          SelectedItem="{Binding SelectedFilter, Mode=TwoWay}"/>
                <TextBox Grid.Column="1" FontSize="11" PlaceholderText="⌕ Search all skills" Text="{Binding SearchText, Mode=TwoWay}"/>
                <TextBlock Grid.Column="2" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" Text="{Binding SummaryText}"/>
            </Grid>

            <!-- Every group, 3 columns, no scroll of its own. -->
            <Border DockPanel.Dock="Top" Padding="14,0,8,8" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource DividerBrush}">
                <ListBox Classes="tiles" ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup, Mode=TwoWay}"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="3"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vs:SkillGroupTileViewModel">
                            <Border Classes="tile" Classes.selected="{Binding IsSelected}" Classes.empty="{Binding IsEmpty}">
                                <Panel>
                                    <ProgressBar Minimum="0" Maximum="1" Value="{Binding TrainedShare}" Height="20" MinHeight="0"
                                                 CornerRadius="0" Background="Transparent" Foreground="{DynamicResource AccentBrush}"
                                                 Opacity="0.35" VerticalAlignment="Stretch"/>
                                    <Grid ColumnDefinitions="*,Auto" Margin="6,0" VerticalAlignment="Center">
                                        <TextBlock Grid.Column="0" FontSize="11" Foreground="{StaticResource TextBrightBrush}"
                                                   TextTrimming="CharacterEllipsis" Text="{Binding Name}"/>
                                        <TextBlock Grid.Column="1" FontFamily="{StaticResource MonoFont}" FontSize="10"
                                                   Foreground="{StaticResource TextBrush}" Text="{Binding CountText}"/>
                                    </Grid>
                                </Panel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- The group's (or the search's) skills, two columns. -->
            <TextBlock DockPanel.Dock="Top" Margin="14,10,14,6" FontSize="10.5">
                <Run FontSize="10" LetterSpacing="1.8" Foreground="{DynamicResource TextAccentBrush}" Text="{Binding ListTitle}"/><Run Text="   "/><Run Text="{Binding ListSummary}"/>
            </TextBlock>
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" Padding="14,0,2,8">
                <ListBox Classes="skilllist" ItemsSource="{Binding Skills}" SelectedItem="{Binding SelectedSkillRow, Mode=TwoWay}">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="2"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vs:SkillRowViewModel">
                            <Border Classes="skillrow" Classes.selected="{Binding IsSelected}" ToolTip.Tip="{Binding Description}">
                                <Grid ColumnDefinitions="56,*,Auto" ColumnSpacing="8">
                                    <sk:SkillPipsView Grid.Column="0" VerticalAlignment="Center" CurrentLevel="{Binding CurrentLevel}"
                                                      QueuedLevel="{Binding QueuedLevel}" TrainingLevel="{Binding TrainingLevel}"
                                                      IsInjected="{Binding IsInjected}"/>
                                    <TextBlock Grid.Column="1" FontSize="11.5" Foreground="{StaticResource TextBrightBrush}"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding Name}"/>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <TextBlock FontSize="10.5" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center"
                                                   Text="{Binding StatusText}"/>
                                        <Border Classes="queuechip" IsVisible="{Binding HasQueueChip}">
                                            <TextBlock Text="{Binding QueueChipText}"/>
                                        </Border>
                                        <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="10.5" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource AccentBrightBrush}" Text="{Binding TimeText}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </ScrollViewer>
        </DockPanel>

        <Border Grid.Column="1" BorderThickness="1,0,0,0" BorderBrush="{DynamicResource BorderBrush}"
                Background="{StaticResource DrawerSurfaceBrush}">
            <Panel>
                <TextBlock Classes="hint" Margin="14" TextWrapping="Wrap" HorizontalAlignment="Center"
                           VerticalAlignment="Center" Text="Pick a skill to see its detail."
                           IsVisible="{Binding SelectedDetail, Converter={x:Static ObjectConverters.IsNull}}"/>
                <Panel IsVisible="{Binding SelectedDetail, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <sk:SkillDetailPane DataContext="{Binding SelectedDetail}"/>
                </Panel>
            </Panel>
        </Border>
    </Grid>
</UserControl>
