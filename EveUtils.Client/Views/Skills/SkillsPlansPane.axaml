<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vs="using:EveUtils.Client.ViewModels.Skills.Plans"
             xmlns:sk="using:EveUtils.Client.Views.Skills"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="700"
             x:Class="EveUtils.Client.Views.Skills.SkillsPlansPane"
             x:DataType="vs:SkillsPlansViewModel"
             x:Name="PlansRoot">

    <UserControl.Styles>
        <Style Selector="Border.planrow">
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}"/>
        </Style>
        <Style Selector="Border.milestone">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
        </Style>
        <Style Selector="TextBlock.summarylabel">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}"/>
        </Style>
        <Style Selector="TextBlock.summaryvalue">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrightBrush}"/>
        </Style>
    </UserControl.Styles>

    <DockPanel Margin="14,10">
        <!-- PLAN choice + plan actions + add actions -->
        <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto,Auto" ColumnSpacing="8" Margin="0,0,0,10">
            <TextBlock Grid.Column="0" Classes="label" FontSize="10" VerticalAlignment="Center" Text="PLAN"/>
            <ComboBox Grid.Column="1" MinWidth="180" ItemsSource="{Binding Plans}" SelectedItem="{Binding SelectedPlan, Mode=TwoWay}"
                      DisplayMemberBinding="{Binding Name}"/>
            <Button Grid.Column="2" Content="RENAME" Command="{Binding RenamePlanCommand}" IsEnabled="{Binding SelectedPlan, Converter={x:Static ObjectConverters.IsNotNull}}"/>
            <Button Grid.Column="3" Content="DELETE" Command="{Binding DeletePlanCommand}" IsEnabled="{Binding SelectedPlan, Converter={x:Static ObjectConverters.IsNotNull}}"/>
            <Button Grid.Column="5" Content="+ SKILL" Command="{Binding AddSkillCommand}"/>
            <Button Grid.Column="6" Content="+ FROM FIT…" Command="{Binding AddFromFitCommand}"/>
            <Button Grid.Column="7" Content="+ FROM ITEM…" Command="{Binding AddFromItemCommand}"/>
        </Grid>

        <Button DockPanel.Dock="Top" HorizontalAlignment="Left" Margin="0,0,0,10" Content="+ NEW PLAN" Command="{Binding CreatePlanCommand}"/>

        <TextBlock DockPanel.Dock="Top" Classes="hint" Margin="0,0,0,10" TextWrapping="Wrap"
                   IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                   Text="{Binding StatusMessage}"/>

        <!-- Summary + ORDER -->
        <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto" ColumnSpacing="24" Margin="0,0,0,10">
            <StackPanel Grid.Column="0">
                <TextBlock Classes="summarylabel" Text="TOTAL"/>
                <TextBlock Classes="summaryvalue" Text="{Binding TotalTimeText}"/>
            </StackPanel>
            <StackPanel Grid.Column="1">
                <TextBlock Classes="summarylabel" Text="LEVELS"/>
                <TextBlock Classes="summaryvalue" Text="{Binding LevelsText}"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Classes="summarylabel" Text="FLYABLE AFTER"/>
                <TextBlock Classes="summaryvalue" Text="{Binding FlyableAfterText}"/>
            </StackPanel>
            <TextBlock Grid.Column="4" Classes="label" FontSize="10" VerticalAlignment="Center" Text="ORDER"/>
            <Button Grid.Column="5" Content="FLY FIRST" Command="{Binding SetOrderModeCommand}"
                    CommandParameter="{x:Static vs:SkillPlanOrderMode.FlyFirst}"/>
            <Button Grid.Column="6" Content="SHORTEST FIRST" Command="{Binding SetOrderModeCommand}"
                    CommandParameter="{x:Static vs:SkillPlanOrderMode.ShortestFirst}"/>
        </Grid>

        <!-- COPY AS TEXT / IMPORT FROM TEXT -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
            <Button Content="COPY AS TEXT" Command="{Binding CopyAsTextCommand}"/>
            <Button Content="IMPORT FROM TEXT" Command="{Binding ImportFromTextCommand}"/>
        </StackPanel>

        <!-- WHAT IF (ET-358) -->
        <Border DockPanel.Dock="Bottom" Margin="0,10,0,0"
                IsVisible="{Binding WhatIf, Converter={x:Static ObjectConverters.IsNotNull}}">
            <sk:SkillsWhatIfPane DataContext="{Binding WhatIf}"/>
        </Border>

        <!-- The row table -->
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vs:SkillPlanDisplayRow">
                        <Panel>
                            <Border Classes="milestone" IsVisible="{Binding IsMilestone}">
                                <TextBlock FontWeight="Bold" Text="{Binding MilestoneText}"/>
                            </Border>
                            <Border Classes="planrow" IsVisible="{Binding !IsMilestone}">
                                <Grid ColumnDefinitions="*,60,80,80,60,Auto" ColumnSpacing="8">
                                    <TextBlock Grid.Column="0" FontSize="11.5" TextTrimming="CharacterEllipsis" Text="{Binding SkillName}"/>
                                    <TextBlock Grid.Column="1" FontSize="11" Text="{Binding LevelText}"/>
                                    <TextBlock Grid.Column="2" Classes="hint" FontSize="10.5" Text="{Binding TimeText}"/>
                                    <TextBlock Grid.Column="3" Classes="hint" FontSize="10.5" Text="{Binding TotalText}"/>
                                    <TextBlock Grid.Column="4" Classes="hint" FontSize="10" Text="{Binding FromText}"/>
                                    <Button Grid.Column="5" Content="✕" Padding="4,0"
                                            Command="{Binding #PlansRoot.((vs:SkillsPlansViewModel)DataContext).RemoveRowCommand}"
                                            CommandParameter="{Binding}"/>
                                </Grid>
                            </Border>
                        </Panel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
