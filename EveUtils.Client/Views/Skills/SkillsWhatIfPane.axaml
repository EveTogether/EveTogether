<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vw="using:EveUtils.Client.ViewModels.Skills.WhatIf"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="220"
             x:Class="EveUtils.Client.Views.Skills.SkillsWhatIfPane"
             x:DataType="vw:SkillsWhatIfViewModel">

    <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DividerBrush}" Padding="0,10,0,0">
        <DockPanel>
            <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,8">
                <TextBlock Grid.Column="0" Classes="label" FontSize="10" VerticalAlignment="Center" Text="WHAT IF"/>
                <Button Grid.Column="2" Content="SHARE" Command="{Binding ShareCommand}"/>
            </Grid>

            <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                <TextBlock FontSize="11" Text="{Binding OtherCharactersFlyTodayLine}"/>
                <TextBlock FontSize="11" Text="{Binding OtherCharactersSoonestLine}"/>
            </StackPanel>

            <ItemsControl ItemsSource="{Binding Scenarios}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vw:WhatIfScenario">
                        <Grid ColumnDefinitions="*,120,120" ColumnSpacing="8" Margin="0,0,0,4">
                            <TextBlock Grid.Column="0" FontSize="11.5" Text="{Binding Name}"/>
                            <TextBlock Grid.Column="1" FontSize="11" Text="{Binding Date, StringFormat='{}{0:ddd d MMM yyyy}'}"/>
                            <TextBlock Grid.Column="2" Classes="hint" FontSize="10.5" Text="{Binding TimeSaved, StringFormat='saves {0}'}"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DockPanel>
    </Border>
</UserControl>
