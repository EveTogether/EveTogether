<v:ChromedWindow xmlns="https://github.com/avaloniaui" xmlns:v="using:EveUtils.Client.Views"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:EveUtils.Client.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        mc:Ignorable="d" d:DesignWidth="720" d:DesignHeight="620"
        x:Class="EveUtils.Client.Views.PresetImportWindow"
        x:DataType="vm:PresetImportViewModel"
        x:Name="ImportRoot"
        Width="720" Height="620" MinWidth="560" MinHeight="460"
        WindowStartupLocation="CenterOwner"
        Title="Read a preset">

    <DockPanel Margin="16" x:Name="ImportRootPanel">

        <DockPanel.Styles>
            <Style Selector="Border.importrow">
                <Setter Property="Background" Value="{StaticResource BgRowBrush}"/>
                <Setter Property="Padding" Value="8,4"/>
                <Setter Property="Margin" Value="0,0,0,3"/>
            </Style>
            <Style Selector="TextBlock.rowid">
                <Setter Property="FontSize" Value="10"/>
                <Setter Property="Opacity" Value="0.45"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Foreground" Value="{StaticResource TextBrightBrush}"/>
            </Style>
        </DockPanel.Styles>

        <StackPanel DockPanel.Dock="Top" Spacing="3" Margin="0,0,0,10">
            <TextBlock Text="READ A PRESET" FontWeight="Bold" FontSize="15"
                       Foreground="{StaticResource TextBrightBrush}"/>
            <TextBlock FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextAccentBrush}"
                       Text="Nothing is written until you have seen every line below and pressed apply. The whole profile is backed up first, as with every other copy in this tool."/>
        </StackPanel>

        <!-- Running clients: the same block as the tool, for the same reason. -->
        <Border DockPanel.Dock="Top" IsVisible="{Binding ClientsRunning}" Margin="0,0,0,10" Padding="12,8"
                Background="#33CC4444" BorderBrush="{StaticResource RedBrush}" BorderThickness="1">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <mi:MaterialIcon Grid.Column="0" Classes="icon-lg" Kind="AlertOutline"
                           Foreground="{StaticResource RedBrush}"/>
                <TextBlock Grid.Column="1" Text="{Binding ClientWarning}" Margin="10,0" TextWrapping="Wrap"
                           FontSize="12" VerticalAlignment="Center" Foreground="{StaticResource TextBrightBrush}"/>
                <Button Grid.Column="2" Content="CHECK AGAIN" FontSize="10" VerticalAlignment="Center"
                        Command="{Binding CheckClientsCommand}"/>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Top" Classes="panel" Padding="11,9" Margin="0,0,0,10">
            <Grid RowDefinitions="Auto,5,Auto,5,Auto" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding PresetHeader}" FontSize="12"
                           FontWeight="SemiBold" TextWrapping="Wrap" IsVisible="{Binding HasPreset}"
                           Foreground="{StaticResource TextBrightBrush}"/>
                <Button Grid.Row="0" Grid.Column="1" Content="CHOOSE PRESET FILE…" FontSize="10" Click="OnChoose"/>

                <!-- Date and build it was made with: an old preset can hold settings from an older EVE. -->
                <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding PresetOrigin}"
                           FontSize="11" Opacity="0.7" IsVisible="{Binding HasPreset}"/>
                <TextBlock Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" FontSize="11" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextAccentBrush}"
                           Text="{Binding TargetProfile, StringFormat='Into: {0}'}"/>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Top" IsVisible="{Binding HasVersionWarning}" Margin="0,0,0,10" Padding="12,8"
                Background="#33CC4444" BorderBrush="{StaticResource RedBrush}" BorderThickness="1">
            <TextBlock Text="{Binding VersionWarning}" TextWrapping="Wrap" FontSize="12"
                       Foreground="{StaticResource TextBrightBrush}"/>
        </Border>

        <Border DockPanel.Dock="Bottom" Padding="11,7" Margin="0,10,0,0" Background="#22000000"
                BorderThickness="1" BorderBrush="{DynamicResource BorderStrongBrush}">
            <StackPanel Spacing="6">
                <TextBlock Text="{Binding PlanSummary}" FontSize="11" IsVisible="{Binding HasPreset}"
                           Foreground="{StaticResource TextBrightBrush}"/>
                <TextBlock Text="{Binding Status}" FontSize="11" TextWrapping="Wrap" Opacity="0.85"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                    <Button Content="Close" Click="OnClose" MinWidth="70"/>
                    <Button Classes="accent" Content="APPLY TO THIS MACHINE" MinWidth="180"
                            IsEnabled="{Binding CanApply}" Command="{Binding ApplyCommand}"
                            ToolTip.Tip="Backs the whole profile up, then writes exactly the lines above."/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Panel>
            <TextBlock FontSize="11" Opacity="0.5" TextWrapping="Wrap" IsVisible="{Binding !HasPreset}"
                       Text="No preset opened yet. Choose the .etpreset file you saved on the other machine."/>
            <ScrollViewer IsVisible="{Binding HasPreset}">
                <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:PresetImportRowViewModel">
                            <Border Classes="importrow">
                                <Grid ColumnDefinitions="70,*,Auto,240" ColumnSpacing="8">
                                    <TextBlock Grid.Column="0" Text="{Binding KindLabel}" FontSize="9"
                                               VerticalAlignment="Center" Opacity="0.55"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="{Binding SourceLabel}" FontSize="12"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{StaticResource TextBrightBrush}"/>
                                            <TextBlock Classes="rowid" Text="{Binding IdDisplay}"
                                                       IsVisible="{Binding ShowId}"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding LastModifiedDisplay}" FontSize="10" Opacity="0.5"/>
                                    </StackPanel>

                                    <!-- What this line does, said in a word before the target it does it to. -->
                                    <Border Grid.Column="2" Classes="chip" VerticalAlignment="Center"
                                            Classes.warn="{Binding IsOverwrite}" Classes.ok="{Binding IsNew}"
                                            Classes.dim="{Binding IsSkip}">
                                        <TextBlock Text="{Binding ActionDisplay}"/>
                                    </Border>
                                    <ComboBox Grid.Column="3" FontSize="11" HorizontalAlignment="Stretch"
                                              VerticalAlignment="Center"
                                              ItemsSource="{Binding Options}" SelectedItem="{Binding SelectedOption}"
                                              ToolTip.Tip="Where this goes on this machine. Character ids are the same everywhere in EVE, so the match is usually right — change it if it is not.">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:PresetTargetOption">
                                                <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Panel>
    </DockPanel>
</v:ChromedWindow>
