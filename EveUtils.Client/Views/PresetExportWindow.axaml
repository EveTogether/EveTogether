<v:ChromedWindow xmlns="https://github.com/avaloniaui" xmlns:v="using:EveUtils.Client.Views"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:EveUtils.Client.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="620" d:DesignHeight="620"
        x:Class="EveUtils.Client.Views.PresetExportWindow"
        x:DataType="vm:PresetExportViewModel"
        x:Name="ExportRoot"
        Width="620" Height="620" MinWidth="480" MinHeight="460"
        WindowStartupLocation="CenterOwner"
        Title="Save a preset">

    <DockPanel Margin="16" x:Name="ExportRootPanel">

        <!-- On the content root rather than the window: the same rule the tool itself follows. -->
        <DockPanel.Styles>
            <Style Selector="Border.presetrow">
                <Setter Property="Background" Value="{StaticResource BgRowBrush}"/>
                <Setter Property="Padding" Value="8,0"/>
                <Setter Property="Margin" Value="0,0,0,2"/>
                <Setter Property="Height" Value="26"/>
            </Style>
            <Style Selector="TextBlock.rowid">
                <Setter Property="FontSize" Value="10"/>
                <Setter Property="Opacity" Value="0.45"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Foreground" Value="{StaticResource TextBrightBrush}"/>
            </Style>
            <Style Selector="TextBlock.stamp">
                <Setter Property="FontSize" Value="10"/>
                <Setter Property="Opacity" Value="0.6"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
        </DockPanel.Styles>

        <StackPanel DockPanel.Dock="Top" Spacing="3" Margin="0,0,0,10">
            <TextBlock Text="SAVE A PRESET" FontWeight="Bold" FontSize="15"
                       Foreground="{StaticResource TextBrightBrush}"/>
            <TextBlock FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextAccentBrush}"
                       Text="One file you can carry to another PC. Pick a well-set-up account and character as your starting point there — or take the whole profile."/>
        </StackPanel>

        <Border DockPanel.Dock="Top" Classes="panel" Padding="11,9" Margin="0,0,0,10">
            <Grid RowDefinitions="Auto,7,Auto" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                <TextBlock Grid.Row="0" Grid.Column="0" Classes="label" Text="NAME" VerticalAlignment="Center"/>
                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding PresetName}" FontSize="12"
                         VerticalContentAlignment="Center"
                         PlaceholderText="default"
                         ToolTip.Tip="The name this preset carries inside it, so you can keep several apart."/>
                <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding ProfileName}" FontSize="11"
                           VerticalAlignment="Center" Opacity="0.7"/>

                <CheckBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" IsChecked="{Binding WholeProfile}"
                          FontSize="11" Content="Everything in this profile — every character and every account"/>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom" Padding="11,7" Margin="0,10,0,0" Background="#22000000"
                BorderThickness="1" BorderBrush="{DynamicResource BorderStrongBrush}">
            <StackPanel Spacing="6">
                <TextBlock Text="{Binding Summary}" FontSize="11" TextWrapping="Wrap"
                           Foreground="{StaticResource TextBrightBrush}"/>
                <TextBlock Text="{Binding Status}" FontSize="11" TextWrapping="Wrap" Opacity="0.85"/>
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                    <TextBlock Grid.Column="0" FontSize="10" Opacity="0.6" TextWrapping="Wrap"
                               Text="{x:Static vm:PresetExportViewModel.ContentsNote}"/>
                    <Button Grid.Column="1" Content="Close" Click="OnClose" MinWidth="70"/>
                    <Button Grid.Column="2" Classes="accent" Content="SAVE PRESET…" Click="OnSave"
                            IsEnabled="{Binding CanExport}" MinWidth="130"/>
                </Grid>
            </StackPanel>
        </Border>

        <Grid RowDefinitions="Auto,*,10,Auto,*" IsEnabled="{Binding !WholeProfile}">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6" Margin="0,0,0,4">
                <TextBlock Grid.Column="0" Classes="panel-title" Text="CHARACTER SETTINGS" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="ALL" FontSize="10" Command="{Binding SelectAllCommand}"/>
                <Button Grid.Column="2" Content="NONE" FontSize="10" Command="{Binding SelectNoneCommand}"/>
            </Grid>
            <ScrollViewer Grid.Row="1">
                <ItemsControl ItemsSource="{Binding Characters}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:PresetEntryRowViewModel">
                            <Border Classes="presetrow">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsIncluded}" Margin="0,0,4,0"
                                              MinHeight="0" MinWidth="0" Padding="0"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}" FontSize="12"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{StaticResource TextBrightBrush}"/>
                                        <TextBlock Classes="rowid" Text="{Binding IdDisplay}" IsVisible="{Binding ShowId}"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Classes="stamp" Text="{Binding LastModifiedDisplay}"
                                               ToolTip.Tip="When EVE last wrote this file"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock Grid.Row="3" Classes="panel-title" Text="ACCOUNT SETTINGS" Margin="0,0,0,4"/>
            <ScrollViewer Grid.Row="4">
                <ItemsControl ItemsSource="{Binding Accounts}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:PresetEntryRowViewModel">
                            <Border Classes="presetrow">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsIncluded}" Margin="0,0,4,0"
                                              MinHeight="0" MinWidth="0" Padding="0"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}" FontSize="12"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{StaticResource TextBrightBrush}"/>
                                        <TextBlock Classes="rowid" Text="{Binding IdDisplay}" IsVisible="{Binding ShowId}"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Classes="stamp" Text="{Binding LastModifiedDisplay}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</v:ChromedWindow>
