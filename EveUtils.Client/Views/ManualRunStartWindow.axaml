<v:ChromedWindow xmlns="https://github.com/avaloniaui" xmlns:v="using:EveUtils.Client.Views"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:EveUtils.Client.ViewModels.Runs"
        xmlns:sde="using:EveUtils.Shared.Modules.Sde.Dtos"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="520"
        x:Class="EveUtils.Client.Views.ManualRunStartWindow"
        x:DataType="vm:ManualRunStartViewModel"
        Width="520" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner"
        Title="NEW RUN">

    <!-- A dialog, not a module: the filling-in moment, after which the run lives in the activity window. Its height
         comes from what is in it (SizeToContent) — a fixed one left two thirds of the window empty (ET-163 nazorg).
         The heading and the close button are ChromedWindow's own titlebar, so there is none in the content. -->
    <StackPanel Margin="16" Spacing="10">

        <StackPanel Spacing="3">
            <TextBlock Classes="label" Text="CHARACTER(S)"/>
            <!-- Multi-select (ET-221): opens the same character picker every other multi-toon start path in the
                 app uses, rather than a second selection widget invented here. -->
            <Button Command="{Binding PickCharactersCommand}" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Left">
                <TextBlock Text="{Binding CharacterSummaryText}"/>
            </Button>
        </StackPanel>

        <StackPanel Spacing="3">
            <TextBlock Classes="label" Text="ACTIVITY"/>
            <ComboBox ItemsSource="{Binding ActivityKinds}" SelectedItem="{Binding SelectedActivityKind}"
                      HorizontalAlignment="Stretch"/>
        </StackPanel>

        <!-- Only a site is named by the catalogue. An abyssal pocket is not in it at all, so the field is gone
             rather than left empty: a required field that can never be filled is what kept START grey. -->
        <StackPanel Spacing="3" IsVisible="{Binding NeedsSite}">
            <TextBlock Classes="label" Text="SITE"/>
            <TextBox PlaceholderText="Search the site catalogue…" Text="{Binding SiteQuery}"/>
            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" MaxHeight="160"
                    IsVisible="{Binding HasSiteResults}">
                <ListBox ItemsSource="{Binding SiteResults}" SelectedItem="{Binding SelectedOption}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:SdeSitePickerOption">
                            <TextBlock Text="{Binding Label}" FontSize="11"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
            <TextBlock Text="{Binding SelectedSite.Name, StringFormat='Selected: {0}'}"
                       IsVisible="{Binding HasSelectedSite}" FontSize="11"
                       Foreground="{DynamicResource TextAccentBrush}"/>
        </StackPanel>

        <!-- A mission is named by a typed name, not a catalogue lookup (ET-255) — freely typed either way. Picking
             a suggestion (ET-265, ET-173) only fills in the exact catalogue name; the SDE Mission table carries no
             level of its own, so that still comes from the optional agent below, same as a clipboard-started
             mission. -->
        <StackPanel Spacing="3" IsVisible="{Binding NeedsMissionName}">
            <TextBlock Classes="label" Text="MISSION NAME"/>
            <TextBox PlaceholderText="e.g. Worlds Collide" Text="{Binding MissionName}"/>
            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" MaxHeight="120"
                    IsVisible="{Binding HasMissionResults}">
                <ListBox ItemsSource="{Binding MissionResults}" SelectedItem="{Binding SelectedMissionResult}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="sde:SdeMission">
                            <TextBlock Text="{Binding Name}" FontSize="11"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <TextBlock Classes="label" Text="AGENT (OPTIONAL)" Margin="0,6,0,0"/>
            <TextBox PlaceholderText="Exact agent name" Text="{Binding MissionAgentName}"/>

            <TextBlock Classes="label" Text="REWARDS (OPTIONAL)" Margin="0,6,0,0"/>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="8" RowDefinitions="Auto,Auto" RowSpacing="6">
                <StackPanel Grid.Row="0" Grid.Column="0" Spacing="2">
                    <TextBlock Text="ISK" FontSize="11"/>
                    <NumericUpDown Minimum="0" FormatString="0" Value="{Binding MissionIsk, Mode=TwoWay}"/>
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="1" Spacing="2">
                    <TextBlock Text="LP" FontSize="11"/>
                    <NumericUpDown Minimum="0" FormatString="0" Value="{Binding MissionLoyaltyPoints, Mode=TwoWay}"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="0" Spacing="2">
                    <TextBlock Text="Bonus ISK" FontSize="11"/>
                    <NumericUpDown Minimum="0" FormatString="0" Value="{Binding MissionBonusIsk, Mode=TwoWay}"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" Spacing="2">
                    <!-- What remains right now, not the mission's own full window (ET-237, confirmed by Jithran):
                         the timer counts down from this. -->
                    <TextBlock Text="Bonus remaining" FontSize="11"/>
                    <TimePicker SelectedTime="{Binding MissionBonusWindowRemaining}" HorizontalAlignment="Stretch"/>
                </StackPanel>
            </Grid>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,4,0,0">
                <TextBox Grid.Column="0" PlaceholderText="Item (optional)" Text="{Binding MissionItemName}"/>
                <NumericUpDown Grid.Column="1" Width="110" Minimum="0" FormatString="0"
                               Value="{Binding MissionItemQuantity, Mode=TwoWay}"/>
            </Grid>
        </StackPanel>

        <!-- Mining has no site behind it at all (ET-229, ET-265) — a belt or a system typed in is a courtesy, so
             the field stays optional. -->
        <StackPanel Spacing="3" IsVisible="{Binding HasOptionalLocationName}">
            <TextBlock Classes="label" Text="LOCATION (OPTIONAL)"/>
            <TextBox PlaceholderText="e.g. a belt or system name" Text="{Binding LocationName}"/>
        </StackPanel>

        <StackPanel Spacing="3" IsVisible="{Binding CanBackdate}">
            <!-- No STARTTIME field on purpose: starting now means the starttime is now. BACKDATE is the one
                 exception, for a run typed in after the fact (ET-163) — so the toggle sits with the two time
                 fields it governs rather than on its own. Absent for an abyssal: that run is handed over standing
                 by, so there is no start time here for an earlier moment to move. -->
            <TextBlock Classes="label" Text="BACKDATE"/>
            <ToggleButton Content="Earlier moment" IsChecked="{Binding IsBackdated}" HorizontalAlignment="Left"/>
            <!-- Under the toggle, not beside it: the two pickers together are wider than the dialog, so a single
                 row ran the time field off the edge (caught by the render, not by any assertion). -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="8" IsVisible="{Binding IsBackdated}" Margin="0,3,0,0">
                <DatePicker Grid.Column="0" SelectedDate="{Binding BackdatedDate}" HorizontalAlignment="Stretch"/>
                <TimePicker Grid.Column="1" SelectedTime="{Binding BackdatedTime}" HorizontalAlignment="Stretch"/>
            </Grid>
        </StackPanel>

        <!-- Only a refusal lands here. A start that worked says so by the activity window coming up on the run;
             a line reading "Run started on …" in a dialog that is already gone said it twice and showed it never. -->
        <TextBlock Text="{Binding Status}" IsVisible="{Binding StatusIsError}" FontSize="11" TextWrapping="Wrap"
                   Foreground="{StaticResource RedBrush}"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,4,0,0">
            <Button Content="Cancel" Click="OnClose"/>
            <Button Content="{Binding StartButtonText}" Classes="accent" Command="{Binding StartCommand}"/>
        </StackPanel>

    </StackPanel>
</v:ChromedWindow>
