<v:ChromedWindow xmlns="https://github.com/avaloniaui" xmlns:v="using:EveUtils.Client.Views"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vr="using:EveUtils.Client.ViewModels.Runs"
        xmlns:ctl="using:EveUtils.Client.Controls"
        xmlns:sys="using:System"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="758" d:DesignHeight="720"
        x:Class="EveUtils.Client.Views.RunsWindow"
        x:DataType="vr:RunsOverviewViewModel"
        Width="758" Height="720" MinWidth="420" MinHeight="320"
        WindowStartupLocation="CenterOwner"
        Title="Runs">

    <!-- One layout, drawn from the space it is handed and never from the window: ModuleHostService moves this very
         Content between a docked tab (758px) and a floating window, and there is no pop-out variant beside it.
         758 is the width this is designed at — see RunsOverviewViewModel for why that, and not the window as it
         happens to stand. Nothing folds behind a "⋯": the chips wrap onto a second line instead, because a reward
         that disappears at the default width is exactly what ET-161 AC-3 forbids. -->
    <DockPanel>

        <!-- On the content root, not on the window: Window.Styles stay behind with the (never shown) window once
             the module host re-parents this content into a tab. -->
        <DockPanel.Styles>
            <!-- The day band. Not a stored thing — an evening is the rows already on screen added up. -->
            <Style Selector="ToggleButton.dayband">
                <Setter Property="Background" Value="{StaticResource BgRowBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                <Setter Property="Padding" Value="14,7"/>
                <Setter Property="CornerRadius" Value="0"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            </Style>
            <!-- State ink goes on the presenter: the stock Fluent theme fills :pointerover and :checked with its own
                 accent there, and a rule one level up (Background on the ToggleButton itself, above) loses to it.
                 Without this, an expanded day band turned solid accent blue and the dim date/summary text — tuned
                 for the near-transparent BgRowBrush — nearly disappeared into it (ET-198). Same brushes and the same
                 "hover on an active row stays active" rule as Button.fleetrow.open in FleetsWindow.axaml. -->
            <Style Selector="ToggleButton.dayband:pointerover /template/ ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource BgRowHoverBrush}"/>
            </Style>
            <Style Selector="ToggleButton.dayband:checked /template/ ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource BgRowSelectedBrush}"/>
            </Style>
            <Style Selector="ToggleButton.dayband:checked:pointerover /template/ ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource BgRowSelectedBrush}"/>
            </Style>
            <Style Selector="TextBlock.daytitle">
                <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
                <Setter Property="FontSize" Value="10"/>
                <Setter Property="LetterSpacing" Value="1.8"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <!-- The whole row is the way into the detail (ET-162), so it is a button that fills its column rather
                 than a link somewhere inside it. -->
            <Style Selector="Button.activityrow">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="CornerRadius" Value="0"/>
                <Setter Property="Padding" Value="0,8,14,8"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            </Style>
            <Style Selector="Button.activityrow:pointerover /template/ ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource BgRowHoverBrush}"/>
            </Style>
            <Style Selector="Button.caretbtn">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="14,8,6,8"/>
                <Setter Property="VerticalAlignment" Value="Top"/>
            </Style>
            <Style Selector="TextBlock.caret.expanded">
                <Setter Property="RenderTransform" Value="rotate(90deg)"/>
            </Style>

            <Style Selector="TextBlock.rowfigure">
                <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
                <Setter Property="Foreground" Value="{StaticResource TextBrightBrush}"/>
                <Setter Property="FontSize" Value="11.5"/>
                <Setter Property="TextAlignment" Value="Right"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style Selector="TextBlock.rowfigure.dim">
                <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
            </Style>
            <Style Selector="TextBlock.rowsite">
                <Setter Property="Foreground" Value="{StaticResource TextBrightBrush}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style Selector="TextBlock.rowkind">
                <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
                <Setter Property="FontSize" Value="9.5"/>
                <Setter Property="LetterSpacing" Value="1.4"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <!-- One line under the figures, never wrapped: it explains the row, it does not double its height. -->
            <Style Selector="TextBlock.rowsub">
                <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
                <Setter Property="FontSize" Value="9.5"/>
                <Setter Property="TextWrapping" Value="NoWrap"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
        </DockPanel.Styles>

        <!-- The narrowest a running-card may get. A MINIMUM, not a size: FillGridPanel divides whatever is left
             over the columns that fit. A card here carries far less than a Fleets lane (no role chip, no second
             text line, no second button, no foot chips) plus one thing Fleets' lane does not — the portrait — so
             it earns a smaller floor than Fleets' 236, not a bigger one; see RunsOverviewViewModel for why 758 is
             the width this screen is designed at. -->
        <DockPanel.Resources>
            <sys:Double x:Key="RunningCardMinWidth">190</sys:Double>
        </DockPanel.Resources>

        <!-- ══ Header ══ -->
        <Border DockPanel.Dock="Top" Padding="14,12" BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource BorderBrush}">
            <StackPanel Spacing="2">
                <Grid ColumnDefinitions="Auto,Auto">
                    <TextBlock Grid.Column="0" Classes="panel-title" FontSize="13" Text="RUNS"/>
                    <Border Grid.Column="1" Classes="chip dim" Margin="8,0,0,0"
                            IsVisible="{Binding FleetFilterText, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <TextBlock Text="{Binding FleetFilterText}"/>
                    </Border>
                </Grid>
                <TextBlock x:Name="OverviewStatus" Classes="hint" Margin="0" TextWrapping="Wrap"
                           IsVisible="{Binding StatusMessage, Converter={x:Static ObjectConverters.IsNotNull}}"
                           Text="{Binding StatusMessage}"/>
            </StackPanel>
        </Border>

        <!-- ══ Sources ══ Local first, then a tab per coupled server — the fit browser's strip. No coupled server
             means no server tab and no strip at all, rather than a lone "Local" tab explaining nothing. -->
        <Border DockPanel.Dock="Top" Padding="14,0" BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource BorderBrush}"
                IsVisible="{Binding HasServerTabs}">
            <ListBox x:Name="SourceTabs" ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab}"
                     Background="Transparent" BorderThickness="0" Padding="0">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="vr:RunsTabViewModel">
                        <TextBlock Text="{Binding Header}" FontSize="11" Padding="8,7"
                                   TextTrimming="CharacterEllipsis" MaxWidth="160"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- ══ Running ══ one lane per local character, running or not. A pilot sitting still keeps their lane and
             their START: a toon that drops out of the band is a toon you forget (AC-6). Built for n lanes; today
             at most one of them carries a run, because RunningRunLookup answers only for exactly one (ET-130).
             Local only: a running clock belongs to this machine, not to a server. -->
        <Border DockPanel.Dock="Top" Padding="14,10" BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource BorderBrush}"
                IsVisible="{Binding IsLocalTabSelected}">
            <StackPanel Spacing="5">
                <TextBlock Classes="label" Text="RUNNING"/>
                <!-- Cards, as many per row as fit at RunningCardMinWidth, filling the width — the same grid Fleets'
                     own "who is active right now" band uses (FillGridPanel, ET-108), and the same card style
                     (Border.statuscard and friends, Themes/EveUtils.axaml) rather than a second one grown next to
                     it (ET-200). The portrait is the one thing this card carries that Fleets' lane does not; it is
                     added here, on top of the shared style, rather than forked into it. -->
                <ItemsControl x:Name="LaneList" ItemsSource="{Binding Lanes}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ctl:FillGridPanel MinItemWidth="{StaticResource RunningCardMinWidth}"
                                                ColumnSpacing="6" RowSpacing="6"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vr:RunningLaneViewModel">
                            <!-- IsRunning maps to the shared style's default-vs-idle pair the same way Fleets uses
                                 it: the state worth drawing the eye to (a fleet active right now / a run tracking
                                 right now) is the bright default, "nothing running" is the quiet .idle look. -->
                            <Border Classes="statuscard" Classes.idle="{Binding !IsRunning}">
                                <Grid ColumnDefinitions="Auto,*">
                                    <Border Grid.Column="0" Classes="statuscardedge" Classes.idle="{Binding !IsRunning}"/>
                                    <Grid Grid.Column="1" ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                        <!-- Hex ESI portrait + glyph fallback: same shape and the same 64px cache key
                                             as the fleet roster leaf and the character picker (ET-184) — reusing the
                                             existing portrait route rather than standing up a new one. -->
                                        <Panel Grid.Column="0" Width="34" Height="39" VerticalAlignment="Top">
                                            <Panel.Clip>
                                                <PathGeometry Figures="M17,0 L34,9.75 L34,29.25 L17,39 L0,29.25 L0,9.75 Z"/>
                                            </Panel.Clip>
                                            <Border Background="{DynamicResource AccentSoftBrush}"
                                                    IsVisible="{Binding !HasPortrait}">
                                                <TextBlock Text="{Binding Initial}" FontSize="14" FontWeight="Bold"
                                                           Foreground="{DynamicResource AccentBrightBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <Image Source="{Binding Portrait}" Stretch="UniformToFill"
                                                   IsVisible="{Binding HasPortrait}"/>
                                        </Panel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Classes="statuscardname" Text="{Binding CharacterText}"/>
                                            <TextBlock Classes="statuscardwhat" Margin="0,2,0,0" Text="{Binding StateText}"/>
                                            <!-- FontSize 15, not the shared style's default 19: that size is tuned
                                                 for Fleets' wider lane, and this card is deliberately narrower
                                                 (less information belongs on it) — the same reduction Fleets' own
                                                 .slim variant makes when it runs short of room, applied here as a
                                                 fixed size rather than a second condition to compute. -->
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6" Margin="0,5,0,0">
                                                <TextBlock Grid.Column="0" Classes="statuscardclock" FontSize="15"
                                                           Text="{Binding ClockText}"/>
                                                <Button Grid.Column="1" Classes="rowaction" VerticalAlignment="Bottom"
                                                        MinWidth="56" Content="{Binding ActionText}"
                                                        Command="{Binding ActCommand}"/>
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="LanesEmpty" Classes="hint" Margin="0" TextWrapping="Wrap"
                           IsVisible="{Binding LanesEmptyText, Converter={x:Static ObjectConverters.IsNotNull}}"
                           Text="{Binding LanesEmptyText}"/>
            </StackPanel>
        </Border>

        <!-- ══ Unfinished ══ stopped and then left there. Its own band, above the days and never a row inside one:
             a run that was never saved must not count towards an evening's total (ET-179 AC-3). Gone entirely once
             the last one is dealt with — an empty band would be a permanent reminder of nothing. Local only, like
             RUNNING: a run still owing a decision owes it on this machine. -->
        <Border DockPanel.Dock="Top" Padding="14,10" BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource BorderBrush}"
                IsVisible="{Binding ShowUnfinishedBand}">
            <StackPanel Spacing="5">
                <TextBlock Classes="label" Text="UNFINISHED"/>
                <TextBlock Classes="hint" Margin="0" TextWrapping="Wrap"
                           Text="Stopped, but never saved or thrown away. A day after it stopped, a run here is saved as it stands."/>
                <ScrollViewer MaxHeight="180" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="UnfinishedList" ItemsSource="{Binding UnfinishedRuns}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vr:UnfinishedRunViewModel">
                                <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="10" Margin="0,3">
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock FontSize="11.5" TextTrimming="CharacterEllipsis"
                                                   Foreground="{StaticResource TextBrightBrush}"
                                                   Text="{Binding TitleText}"/>
                                        <TextBlock Classes="rowsub" Text="{Binding StoppedText}"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Classes="rowfigure" Text="{Binding DurationText}"/>
                                    <TextBlock Grid.Column="2" Classes="rowfigure" Classes.dim="{Binding TotalIskUnknown}"
                                               Text="{Binding TotalIskText}"/>
                                    <!-- Disabled rather than hidden for an abyssal whose pocket already collapsed
                                         (ET-254 AC-5, CanResume): SAVE and DELETE still apply to it, so the row
                                         keeps its usual shape instead of one button's absence shifting the rest. -->
                                    <Button Grid.Column="3" Classes="rowaction" MinWidth="62"
                                            Content="RESUME" Command="{Binding ResumeCommand}"
                                            ToolTip.Tip="Reopen the run window on this run and pick the clock back up"/>
                                    <Button Grid.Column="4" Classes="rowaction" MinWidth="62"
                                            Content="SAVE" Command="{Binding SaveCommand}"/>
                                    <Button Grid.Column="5" Classes="rowaction" MinWidth="62"
                                            Content="DELETE" Command="{Binding DeleteCommand}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </Border>

        <!-- ══ Month ══ the page (ET-233): one month at a time, previous/next either side, its own total — the
             same source the day bands below already sum, so the two can never disagree. Shown for every source
             (Local, a fleet filter, a server tab): all three page the same way. -->
        <Border DockPanel.Dock="Top" Padding="14,10" BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource BorderBrush}">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                <Button Grid.Column="0" Classes="rowaction" Content="&#x25C0;" MinWidth="30"
                        Command="{Binding PreviousMonthCommand}" ToolTip.Tip="Previous month"/>
                <TextBlock Grid.Column="1" Classes="panel-title" FontSize="12" Margin="10,0"
                           VerticalAlignment="Center" Text="{Binding MonthHeaderText}"/>
                <TextBlock Grid.Column="2" Classes="sectionsummary" VerticalAlignment="Center"
                           Text="{Binding SelectedTab.MonthSummaryText}"/>
                <Button Grid.Column="3" Classes="rowaction" Content="&#x25B6;" MinWidth="30"
                        Command="{Binding NextMonthCommand}" ToolTip.Tip="Next month"/>
            </Grid>
        </Border>

        <!-- ══ Finished activities ══ one row per activity, under the day it belongs to. The days belong to the
             selected source: Local holds every activity, a server tab the ones published to it. -->
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
          <StackPanel>
            <TextBlock x:Name="TabStatus" Classes="hint" Margin="14,10" TextWrapping="Wrap"
                       IsVisible="{Binding SelectedTab.StatusMessage, Converter={x:Static ObjectConverters.IsNotNull}}"
                       Text="{Binding SelectedTab.StatusMessage}"/>
            <ItemsControl x:Name="DayList" ItemsSource="{Binding SelectedTab.Days}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vr:RunsDayViewModel">
                        <StackPanel>
                            <ToggleButton Classes="dayband" IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                                          ToolTip.Tip="Show or hide this day's activities">
                                <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="10">
                                    <TextBlock Classes="caret" Classes.expanded="{Binding IsExpanded}" Text="&#x25B6;"/>
                                    <TextBlock Grid.Column="1" Classes="daytitle" Text="{Binding DayText}"/>
                                    <TextBlock Grid.Column="2" Classes="sectionsummary" Text="{Binding SummaryText}"/>
                                </Grid>
                            </ToggleButton>
                            <ItemsControl ItemsSource="{Binding Rows}" IsVisible="{Binding IsExpanded}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vr:ActivityOverviewRowViewModel">
                                        <StackPanel>
                                            <Grid ColumnDefinitions="Auto,*,Auto"
                                                  Background="Transparent">
                                                <Button Grid.Column="0" Classes="caretbtn"
                                                        Command="{Binding ToggleCommand}"
                                                        ToolTip.Tip="Show the runs behind this activity">
                                                    <TextBlock Classes="caret" Classes.expanded="{Binding IsExpanded}"
                                                               Text="&#x25B6;"/>
                                                </Button>
                                                <!-- Outside the row button, not inside it: the row opens the detail,
                                                     and a publish that fired because someone aimed for the detail is
                                                     exactly the click this data must not have. -->
                                                <StackPanel Grid.Column="2" VerticalAlignment="Top" Margin="0,8,14,0"
                                                            Spacing="4">
                                                    <Button Classes="rowaction" Content="PUBLISH"
                                                            IsVisible="{Binding CanPublish}"
                                                            Command="{Binding PublishCommand}"
                                                            ToolTip.Tip="Send this activity's runs to a coupled server"/>
                                                    <!-- Only after an automatic publish failed: it tries again without
                                                         asking, as the save that queued it did. -->
                                                    <Button Classes="rowaction" Content="RETRY"
                                                            IsVisible="{Binding HasPublishFailure}"
                                                            Command="{Binding RetryPublishCommand}"
                                                            ToolTip.Tip="{Binding PublishFailureText}"/>
                                                </StackPanel>
                                                <Button Grid.Column="1" Classes="activityrow"
                                                        Command="{Binding OpenDetailCommand}">
                                                    <StackPanel Spacing="3">
                                                        <!-- The two figures the eye runs down a column for stay on
                                                             the first line at every width; what explains them goes
                                                             under it. -->
                                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
                                                            <TextBlock Classes="rowfigure dim" Text="{Binding TimeText}"/>
                                                            <!-- Name and kind in one run of text, so the kind stays
                                                                 against the name at every width instead of drifting
                                                                 to the far side of a star column, and the two trim
                                                                 together when the name is long. -->
                                                            <TextBlock Grid.Column="1" Classes="rowsite"
                                                                       TextTrimming="CharacterEllipsis">
                                                                <Run Text="{Binding SiteText}"/>
                                                                <Run Text="{Binding KindText}" FontSize="9.5"
                                                                     Foreground="{StaticResource TextDimBrush}"/>
                                                            </TextBlock>
                                                            <TextBlock Grid.Column="2" Classes="rowfigure"
                                                                       Text="{Binding DurationText}"/>
                                                            <TextBlock Grid.Column="3" Classes="rowfigure"
                                                                       IsVisible="{Binding HasNet}"
                                                                       Text="{Binding NetText}"/>
                                                            <!-- Never a "0 ISK" where nothing was captured: a zero
                                                                 reads as a valuation that came out at nothing. -->
                                                            <TextBlock Grid.Column="3" Classes="rowsub"
                                                                       IsVisible="{Binding !HasNet}"
                                                                       Text="{Binding NoNetText}"/>
                                                        </Grid>
                                                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                                                            <TextBlock Classes="rowsub" Text="{Binding CrewText}"/>
                                                            <!-- Only on a row nobody committed themselves: an
                                                                 activity that was auto-saved a day after it stopped
                                                                 must not read as one a pilot stood behind. -->
                                                            <TextBlock Grid.Column="1" Classes="rowsub"
                                                                       IsVisible="{Binding HasAutoSavedRun}"
                                                                       Text="{Binding AutoSavedText}"/>
                                                            <!-- A run knows where it stands towards a server, so the
                                                                 row says it. A fit row has no such line because a fit
                                                                 keeps no trace of having been shared. -->
                                                            <TextBlock Grid.Column="1" Classes="rowsub"
                                                                       Margin="0,0,64,0" HorizontalAlignment="Right"
                                                                       IsVisible="{Binding HasSyncText}"
                                                                       Text="{Binding SyncText}"/>
                                                            <TextBlock Grid.Column="2" Classes="rowsub"
                                                                       Text="{Binding EnemiesText}"/>
                                                        </Grid>
                                                        <!-- Wraps rather than truncates: the strip grows a line, it
                                                             never drops a reward form. -->
                                                        <ItemsControl ItemsSource="{Binding Chips}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <WrapPanel/>
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate DataType="vr:ActivityRewardChipViewModel">
                                                                    <Border Classes="chip" Margin="0,2,6,0"
                                                                            Classes.dim="{Binding IsKnownKind}"
                                                                            Classes.warn="{Binding IsUnknownKind}">
                                                                        <TextBlock Text="{Binding Text}"/>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </Button>
                                            </Grid>
                                            <!-- The deelruns: six pilots on one site are six rows here and one row
                                                 above, which is the whole of AC-5. -->
                                            <Border Classes="sectionbody" IsVisible="{Binding IsExpanded}">
                                                <StackPanel>
                                                    <ItemsControl ItemsSource="{Binding SubRuns}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate DataType="vr:ActivityRunRowViewModel">
                                                                <Grid Classes="kv" ColumnDefinitions="*,Auto,Auto"
                                                                      ColumnSpacing="10">
                                                                    <StackPanel>
                                                                        <TextBlock Text="{Binding CharacterText}"
                                                                                   FontSize="11.5"
                                                                                   Foreground="{StaticResource TextBrightBrush}"/>
                                                                        <TextBlock Classes="rowsub"
                                                                                   Text="{Binding StandingText}"/>
                                                                    </StackPanel>
                                                                    <TextBlock Grid.Column="1" Classes="rowsub"
                                                                               Text="{Binding TimeSourceText}"/>
                                                                    <TextBlock Grid.Column="2" Classes="rowfigure"
                                                                               Text="{Binding DurationText}"/>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <TextBlock Classes="hint" Margin="0" TextWrapping="Wrap"
                                                               IsVisible="{Binding SubRunsStatus, Converter={x:Static ObjectConverters.IsNotNull}}"
                                                               Text="{Binding SubRunsStatus}"/>
                                                </StackPanel>
                                            </Border>
                                            <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource DividerBrush}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
    </DockPanel>
</v:ChromedWindow>
