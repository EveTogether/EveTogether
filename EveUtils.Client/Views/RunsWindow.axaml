<v:ChromedWindow xmlns="https://github.com/avaloniaui" xmlns:v="using:EveUtils.Client.Views"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vr="using:EveUtils.Client.ViewModels.Runs"
        xmlns:ctl="using:EveUtils.Client.Controls"
        xmlns:vw="using:EveUtils.Client.Views.Runs"
        xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="758" d:DesignHeight="720"
        x:Class="EveUtils.Client.Views.RunsWindow"
        x:DataType="vr:RunsOverviewViewModel"
        Width="758" Height="720" MinWidth="420" MinHeight="320"
        WindowStartupLocation="CenterOwner"
        Title="Runs">

    <!-- One layout, drawn from the space it is handed and never from the window: ModuleHostService moves this very
         Content between a docked tab (1303) and a floating window (758), and both are the same compact list with more
         or less room for a site's name (ET-290). A row has one height at every width: what does not fit trims, chips
         included, and the activity pane (ET-291) is where all of it can be read.

         Three layers, and the content root is this Grid (ET-291). Layer 0 is the screen itself, whose last undocked
         child is the list beside the pane's own column. Layer 1 dims that screen and layer 2 is the drawer over it,
         both only below the breakpoint. They are siblings of the DockPanel and not a second undocked child of it
         (ET-285), and they are Borders in this very Grid rather than a Popup or the OverlayLayer: those hang off a
         TopLevel, and this content is re-parented between a tab and a window under them. -->
    <Grid x:Name="RunsRoot">

        <!-- On the content root, not on the window: Window.Styles stay behind with the (never shown) window once
             the module host re-parents this content into a tab. -->
        <Grid.Styles>
            <!-- ══ The list ══ one ListBox over the tab's flat Items: day headers, activity rows, pilots' runs. -->
            <Style Selector="ListBox.runslist">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="0"/>
            </Style>
            <Style Selector="ListBox.runslist ListBoxItem">
                <Setter Property="Padding" Value="0"/>
                <Setter Property="MinHeight" Value="0"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            </Style>
            <!-- Every state fill goes on the presenter, and every state Fluent paints there is named: a rule one level up
                 loses to Fluent's accent blue, which is what turned the old day band solid blue (ET-198). Hover and
                 selection cover the whole row this way — caret and sync cell included — not only the part a button
                 happens to occupy. -->
            <Style Selector="ListBox.runslist ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="Transparent"/>
            </Style>
            <Style Selector="ListBox.runslist ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource BgRowHoverBrush}"/>
            </Style>
            <Style Selector="ListBox.runslist ListBoxItem:pressed /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource BgRowHoverBrush}"/>
            </Style>
            <Style Selector="ListBox.runslist ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource BgRowSelectedBrush}"/>
            </Style>
            <Style Selector="ListBox.runslist ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource BgRowSelectedBrush}"/>
            </Style>
            <Style Selector="ListBox.runslist ListBoxItem:selected:pressed /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource BgRowSelectedBrush}"/>
            </Style>
            <Style Selector="ListBox.runslist ListBoxItem:selected:focus-within /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource BgRowSelectedBrush}"/>
            </Style>

            <!-- Secondary text is dim at rest and lifts to the text colour on hover and selection: dim on those fills
                 measured 3.3–4.4:1 in the v2 contrast check, the text colour 8.6 and up. Every secondary text and glyph
                 in a row inherits that ink from the row's own button, so one rule per row switches all of them — a rule
                 per text would be an ancestor watch per text, built again for every row the list scrolls in. -->
            <Style Selector="Button.activityrow">
                <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
            </Style>
            <Style Selector="ListBoxItem:pointerover Button.activityrow, ListBoxItem:selected Button.activityrow">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            </Style>

            <!-- The row and the day header are buttons that fill their item: a click opens the detail (ET-162) or folds
                 the day. Their own fills stay out of it — the item's presenter above draws hover for the whole row. -->
            <Style Selector="Button.activityrow, Button.dayband, Button.caretbtn, Button.syncaction, Button.avatar">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="CornerRadius" Value="0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="MinHeight" Value="0"/>
            </Style>
            <Style Selector="Button.activityrow, Button.dayband">
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            </Style>
            <Style Selector="Button.activityrow:pointerover /template/ ContentPresenter, Button.activityrow:pressed /template/ ContentPresenter, Button.dayband:pointerover /template/ ContentPresenter, Button.dayband:pressed /template/ ContentPresenter, Button.caretbtn:pointerover /template/ ContentPresenter, Button.caretbtn:pressed /template/ ContentPresenter, Button.avatar:pointerover /template/ ContentPresenter, Button.avatar:pressed /template/ ContentPresenter">
                <Setter Property="Background" Value="Transparent"/>
            </Style>
            <Style Selector="Button.activityrow:pointerover /template/ ContentPresenter, Button.activityrow:pressed /template/ ContentPresenter">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            </Style>
            <Style Selector="Button.activityrow:pressed, Button.dayband:pressed, Button.caretbtn:pressed, Button.avatar:pressed">
                <Setter Property="RenderTransform" Value="none"/>
            </Style>

            <Style Selector="TextBlock.caret">
                <Setter Property="FontSize" Value="9"/>
                <Setter Property="Foreground" Value="{DynamicResource TextAccentBrush}"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style Selector="TextBlock.caret.expanded">
                <Setter Property="RenderTransform" Value="rotate(90deg)"/>
            </Style>
            <Style Selector="Button.caretbtn:pointerover TextBlock.caret, Button.dayband:pointerover TextBlock.caret">
                <Setter Property="Foreground" Value="{DynamicResource AccentBrightBrush}"/>
            </Style>

            <!-- Day header -->
            <Style Selector="Border.dayhead">
                <Setter Property="Background" Value="{StaticResource BgRowBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                <Setter Property="Height" Value="28"/>
            </Style>
            <Style Selector="TextBlock.dayweek">
                <Setter Property="Foreground" Value="{StaticResource TextBrightBrush}"/>
                <Setter Property="FontSize" Value="10"/>
                <Setter Property="LetterSpacing" Value="1.8"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style Selector="TextBlock.daydate">
                <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
                <Setter Property="FontSize" Value="10"/>
                <Setter Property="LetterSpacing" Value="1.8"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style Selector="TextBlock.daysum">
                <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
                <Setter Property="Foreground" Value="{StaticResource TextBrightBrush}"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="TextAlignment" Value="Right"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <!-- Activity row -->
            <Style Selector="TextBlock.rowtime">
                <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style Selector="TextBlock.rowsite">
                <Setter Property="Foreground" Value="{StaticResource TextBrightBrush}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            </Style>
            <Style Selector="TextBlock.rowline">
                <Setter Property="FontSize" Value="9.5"/>
                <Setter Property="TextWrapping" Value="NoWrap"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style Selector="TextBlock.rowkind">
                <Setter Property="LetterSpacing" Value="1"/>
            </Style>
            <Style Selector="TextBlock.rowfigure">
                <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
                <Setter Property="Foreground" Value="{StaticResource TextBrightBrush}"/>
                <Setter Property="FontSize" Value="11.5"/>
                <Setter Property="TextAlignment" Value="Right"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            </Style>
            <Style Selector="TextBlock.rowfigure.dim">
                <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
            </Style>
            <Style Selector="TextBlock.rowsmall">
                <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
                <Setter Property="FontSize" Value="10"/>
                <Setter Property="TextAlignment" Value="Right"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style Selector="TextBlock.rownone">
                <Setter Property="FontSize" Value="9.5"/>
                <Setter Property="TextAlignment" Value="Right"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            </Style>
            <!-- One line under the figures, never wrapped: it explains the row, it does not double its height. -->
            <Style Selector="TextBlock.rowsub">
                <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
                <Setter Property="FontSize" Value="9.5"/>
                <Setter Property="TextWrapping" Value="NoWrap"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style Selector="ctl|IconGlyph.typeicon">
                <Setter Property="Width" Value="14"/>
                <Setter Property="Height" Value="14"/>
                <Setter Property="Foreground" Value="{DynamicResource TextAccentBrush}"/>
            </Style>
            <Style Selector="ctl|IconGlyph.syncstate">
                <Setter Property="Width" Value="13"/>
                <Setter Property="Height" Value="13"/>
            </Style>
            <Style Selector="ctl|IconGlyph.syncstate.attention">
                <Setter Property="Foreground" Value="{DynamicResource AccentBrightBrush}"/>
            </Style>
            <Style Selector="ctl|IconGlyph.syncstate.failed">
                <Setter Property="Foreground" Value="{StaticResource RedBrush}"/>
            </Style>
            <!-- ══ The drawer (ET-291) ══ the pane over the list below the breakpoint. Opaque, edged in the bright
                 accent so the edge reads against the scrim in every theme (border-s measured 2.3:1 on Minmatar in
                 the v2 check, against the 3:1 a border owes), and slid in from the right. It stays in the tree while
                 it is shut, translated off its own width: a transition can then carry it both ways, and the render
                 harness takes the transitions off to capture an end state rather than wait for one. -->
            <Style Selector="Border.drawer">
                <Setter Property="Width" Value="430"/>
                <Setter Property="HorizontalAlignment" Value="Right"/>
                <Setter Property="Background" Value="{StaticResource DrawerSurfaceBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrightBrush}"/>
                <Setter Property="BorderThickness" Value="1,0,0,0"/>
                <Setter Property="BoxShadow" Value="-18 0 36 0 #99000000"/>
                <Setter Property="RenderTransform" Value="translateX(430px)"/>
                <Setter Property="IsHitTestVisible" Value="False"/>
                <Setter Property="Transitions">
                    <Transitions>
                        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.22"/>
                    </Transitions>
                </Setter>
            </Style>
            <Style Selector="Border.drawer.open">
                <Setter Property="RenderTransform" Value="none"/>
                <Setter Property="IsHitTestVisible" Value="True"/>
            </Style>
            <Style Selector="Border.scrim">
                <Setter Property="Background" Value="{StaticResource ScrimBrush}"/>
                <Setter Property="Opacity" Value="0"/>
                <Setter Property="IsHitTestVisible" Value="False"/>
                <Setter Property="Transitions">
                    <Transitions>
                        <DoubleTransition Property="Opacity" Duration="0:0:0.2"/>
                    </Transitions>
                </Setter>
            </Style>
            <Style Selector="Border.scrim.open">
                <Setter Property="Opacity" Value="1"/>
                <Setter Property="IsHitTestVisible" Value="True"/>
            </Style>
            <!-- The drawer's own top bar: what it holds, the key that shuts it, and the ✕. -->
            <Style Selector="Border.dbar">
                <Setter Property="Background" Value="{StaticResource BgHeaderBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                <Setter Property="Padding" Value="14,6,6,6"/>
            </Style>
            <Style Selector="Border.dlabel">
                <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                <Setter Property="Padding" Value="7,2,7,3"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style Selector="Border.dlabel > TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource TextAccentBrush}"/>
                <Setter Property="FontSize" Value="10"/>
                <Setter Property="LetterSpacing" Value="1.8"/>
            </Style>
            <!-- The same ink the pane's own labels use on this opaque surface: TextDimBrush at 10 px measured 4.41:1
                 off a render, under the 4.5 a key hint owes as much as any other text. -->
            <Style Selector="TextBlock.kbd">
                <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
                <Setter Property="Foreground">
                    <SolidColorBrush Color="#FFA0958A"/>
                </Setter>
                <Setter Property="FontSize" Value="10"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style Selector="Button.drawerclose">
                <Setter Property="Width" Value="32"/>
                <Setter Property="Height" Value="32"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="MinHeight" Value="0"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource TextBrightBrush}"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>
            <Style Selector="Button.drawerclose:pointerover /template/ ContentPresenter, Button.drawerclose:focus-visible /template/ ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource TextBrightBrush}"/>
            </Style>

            <!-- The pane's own column beside the list, ruled off from it. -->
            <Style Selector="Border.panecolumn">
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                <Setter Property="BorderThickness" Value="1,0,0,0"/>
            </Style>

            <!-- ══ RUNNING ══ -->
            <Style Selector="TextBlock.runwho">
                <Setter Property="Foreground" Value="{StaticResource TextBrightBrush}"/>
                <Setter Property="FontSize" Value="11.5"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style Selector="TextBlock.runsite">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            </Style>
            <Style Selector="TextBlock.runclock">
                <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
                <Setter Property="Foreground" Value="{DynamicResource AccentBrightBrush}"/>
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="TextAlignment" Value="Right"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style Selector="TextBlock.runidle">
                <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <!-- An idle character's avatar: a 28 px target around a 22 px hex, ringed in the bright accent on hover and
                 on keyboard focus. -->
            <Style Selector="Button.avatar">
                <Setter Property="Width" Value="28"/>
                <Setter Property="Height" Value="28"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>
            <Style Selector="Button.avatar:pointerover ctl|HexPortrait, Button.avatar:focus-visible ctl|HexPortrait">
                <Setter Property="Ring" Value="{DynamicResource AccentBrightBrush}"/>
            </Style>

            <!-- ══ The range line (ET-292) ══ its totals keep the month bar's weight (ET-266) — bolder and bigger than
                 the day headers' summary below, so the two never look like the same kind of text. ISK carries .isk on
                 top for the heavier weight. -->
            <Style Selector="TextBlock.monthfigure">
                <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
                <Setter Property="Foreground" Value="{StaticResource TextBrightBrush}"/>
                <Setter Property="FontSize" Value="12.5"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style Selector="TextBlock.monthfigure.isk">
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="FontWeight" Value="Bold"/>
            </Style>
            <Style Selector="TextBlock.monthfigure.sep">
                <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
                <Setter Property="FontWeight" Value="Normal"/>
            </Style>
            <Style Selector="StackPanel.rangetotals">
                <Setter Property="HorizontalAlignment" Value="Right"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style Selector="Grid.rangeline.narrow StackPanel.rangetotals">
                <Setter Property="Grid.Row" Value="1"/>
                <Setter Property="HorizontalAlignment" Value="Left"/>
                <Setter Property="Margin" Value="0,6,0,0"/>
            </Style>
            <Style Selector="Grid.rangeline.narrow TextBlock.monthfigure">
                <Setter Property="FontSize" Value="11.5"/>
            </Style>
            <Style Selector="Grid.rangeline.narrow TextBlock.monthfigure.isk">
                <Setter Property="FontSize" Value="13.5"/>
            </Style>
            <Style Selector="TextBlock.rangetitle">
                <Setter Property="Foreground" Value="{StaticResource TextBrightBrush}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="Medium"/>
                <Setter Property="LetterSpacing" Value="2.2"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style Selector="Button.rangenav">
                <Setter Property="Width" Value="26"/>
                <Setter Property="Height" Value="24"/>
                <Setter Property="MinHeight" Value="0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="FontSize" Value="10"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                <Setter Property="CornerRadius" Value="0"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style Selector="Button.rangenav:pointerover /template/ ContentPresenter, Button.rangenav:focus-visible /template/ ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource BgRowHoverBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource TextBrightBrush}"/>
            </Style>
            <Style Selector="Button.rangenav:disabled /template/ ContentPresenter">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{StaticResource TextDimSmallBrush}"/>
            </Style>
            <Style Selector="Button.rangeclear">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="4,0"/>
                <Setter Property="MinHeight" Value="0"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Foreground" Value="{StaticResource TextDimSmallBrush}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style Selector="Button.rangeclear:pointerover /template/ ContentPresenter, Button.rangeclear:focus-visible /template/ ContentPresenter">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{StaticResource TextBrightBrush}"/>
            </Style>
            <!-- The strip spans the band below the breakpoint; the filters (RO-4) go under it. -->
            <Style Selector="Grid#Band.narrow > vw|RunsActivityStrip">
                <Setter Property="Grid.ColumnSpan" Value="3"/>
            </Style>
            <Style Selector="Grid#Band.narrow > Border.filterblock">
                <Setter Property="Grid.Row" Value="1"/>
            </Style>

            <!-- ══ TYPES / CHARACTERS filter blocks (ET-293) ══ a label, only while something in it is off an
                 "n of m" and SHOW ALL, and a ColumnFlowPanel of tiles that stretches to the strip's own height. -->
            <Style Selector="TextBlock.filtersummary">
                <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
                <Setter Property="FontSize" Value="10"/>
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style Selector="Button.showall">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="MinHeight" Value="0"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <ControlTemplate>
                        <ContentPresenter x:Name="PART_ContentPresenter" Background="Transparent"
                                          Content="{TemplateBinding Content}"/>
                    </ControlTemplate>
                </Setter>
            </Style>
            <Style Selector="TextBlock.showalltext">
                <Setter Property="FontSize" Value="10"/>
                <Setter Property="Foreground" Value="{DynamicResource AccentBrightBrush}"/>
            </Style>
            <Style Selector="Button.showall:pointerover TextBlock.showalltext">
                <Setter Property="Foreground" Value="{DynamicResource AccentBrightBrush}"/>
                <Setter Property="TextDecorations" Value="Underline"/>
            </Style>

            <!-- One tile: a 13×13 check box, a type icon or a character's own HexPortrait, the full name — never
                 trimmed below the panel's own last-resort tooltip fallback — and the count, mono and right-aligned. -->
            <Style Selector="Button.tile">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="MinHeight" Value="0"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="CornerRadius" Value="0"/>
                <!-- ItemsControl centres its generated containers vertically by default (ET-293 gotcha): without
                     this, every tile sat at its own content height instead of filling the row ColumnFlowPanel gave
                     it, and the block never reached the strip's own height. -->
                <Setter Property="VerticalAlignment" Value="Stretch"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <ControlTemplate>
                        <ContentPresenter x:Name="PART_ContentPresenter" Background="Transparent"
                                          Content="{TemplateBinding Content}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </ControlTemplate>
                </Setter>
            </Style>
            <Style Selector="Border.tilefill">
                <Setter Property="Background" Value="#04FFFFFF"/>
                <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
            </Style>
            <Style Selector="Button.tile.on Border.tilefill">
                <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            </Style>
            <Style Selector="Button.tile:pointerover Border.tilefill">
                <Setter Property="Background" Value="{DynamicResource BgRowHoverBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
            </Style>
            <Style Selector="Button.tile.on:pointerover Border.tilefill">
                <Setter Property="Background" Value="{DynamicResource BgRowSelectedBrush}"/>
            </Style>
            <Style Selector="Border.tileaccent">
                <Setter Property="Width" Value="2"/>
                <Setter Property="HorizontalAlignment" Value="Left"/>
                <Setter Property="Background" Value="{DynamicResource AccentBrightBrush}"/>
            </Style>
            <Style Selector="Border.tilefocus">
                <Setter Property="BorderThickness" Value="0"/>
            </Style>
            <Style Selector="Button.tile:focus-visible Border.tilefocus">
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrightBrush}"/>
            </Style>
            <Style Selector="Border.tilecheck">
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="BorderBrush" Value="{StaticResource TextDimBrush}"/>
                <Setter Property="Background" Value="Transparent"/>
            </Style>
            <Style Selector="Button.tile.on Border.tilecheck">
                <Setter Property="Background" Value="{DynamicResource AccentBrightBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrightBrush}"/>
            </Style>
            <Style Selector="mi|MaterialIcon.tileicon">
                <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
            </Style>
            <Style Selector="Button.tile.on mi|MaterialIcon.tileicon">
                <Setter Property="Foreground" Value="{DynamicResource TextAccentBrush}"/>
            </Style>
            <Style Selector="ctl|HexPortrait.tileportrait">
                <Setter Property="Opacity" Value=".45"/>
            </Style>
            <Style Selector="Button.tile.on ctl|HexPortrait.tileportrait">
                <Setter Property="Opacity" Value="1"/>
            </Style>
            <Style Selector="TextBlock.tilename">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            </Style>
            <Style Selector="Button.tile.on TextBlock.tilename, Button.tile:pointerover TextBlock.tilename">
                <Setter Property="Foreground" Value="{StaticResource TextBrightBrush}"/>
            </Style>
            <Style Selector="TextBlock.tilecount">
                <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style Selector="Button.tile.on TextBlock.tilecount">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            </Style>
        </Grid.Styles>

        <DockPanel x:Name="RunsContent">

        <!-- ══ Header ══ -->
        <Border DockPanel.Dock="Top" Padding="14,12" BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource BorderBrush}">
            <StackPanel Spacing="2">
                <Grid ColumnDefinitions="Auto,Auto">
                    <TextBlock Grid.Column="0" Classes="panel-title" FontSize="13" Text="RUNS"/>
                    <Border Grid.Column="1" Classes="chip dim" Margin="8,0,0,0"
                            IsVisible="{Binding FleetFilterText, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <TextBlock Text="{Binding FleetFilterText}"/>
                    </Border>
                </Grid>
                <TextBlock x:Name="OverviewStatus" Classes="hint" Margin="0" TextWrapping="Wrap"
                           IsVisible="{Binding StatusMessage, Converter={x:Static ObjectConverters.IsNotNull}}"
                           Text="{Binding StatusMessage}"/>
            </StackPanel>
        </Border>

        <!-- ══ Sources ══ Local first, then a tab per coupled server — the fit browser's strip. No coupled server
             means no server tab and no strip at all, rather than a lone "Local" tab explaining nothing. -->
        <Border DockPanel.Dock="Top" Padding="14,0" BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource BorderBrush}"
                IsVisible="{Binding HasServerTabs}">
            <ListBox x:Name="SourceTabs" ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab}"
                     Background="Transparent" BorderThickness="0" Padding="0">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="vr:RunsTabViewModel">
                        <TextBlock Text="{Binding Header}" FontSize="11" Padding="8,7"
                                   TextTrimming="CharacterEllipsis" MaxWidth="160"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- ══ Running ══ a line per running group (ET-290): the faces on it, who, the site, its type and system, and
             one clock from the group's earliest stored start. Under it, one line with every local character that has
             nothing running as an avatar — a click opens the start screen fixed on that character — and START RUN ▾
             for the general start. Local only: a running clock belongs to this machine, not to a server. -->
        <Border DockPanel.Dock="Top" Padding="14,4" BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource BorderBrush}"
                IsVisible="{Binding IsLocalTabSelected}">
            <StackPanel>
                <ItemsControl x:Name="RunningList" ItemsSource="{Binding RunningGroups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vr:RunningGroupViewModel">
                            <Grid Height="34" ColumnDefinitions="66,64,110,*,74,64" ColumnSpacing="10">
                                <TextBlock Grid.Column="0" Classes="label" Text="RUNNING" VerticalAlignment="Center"
                                           IsVisible="{Binding IsFirst}"/>
                                <ctl:HexStack Grid.Column="1" Size="22" Overlap="7" HorizontalAlignment="Left"
                                              VerticalAlignment="Center" Faces="{Binding Faces}"
                                              ToolTip.Tip="{Binding WhoTooltip}"/>
                                <TextBlock Grid.Column="2" Classes="runwho" Text="{Binding WhoText}"
                                           ToolTip.Tip="{Binding WhoTooltip}"/>
                                <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                    <TextBlock Classes="runsite" Text="{Binding SiteText}"/>
                                    <TextBlock Classes="rowsub" Text="{Binding KindText}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="4" Classes="runclock" Text="{Binding ClockText}"/>
                                <Button Grid.Column="5" Classes="rowaction" VerticalAlignment="Center" Content="OPEN"
                                        Command="{Binding OpenCommand}" ToolTip.Tip="Open the run window"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Grid MinHeight="28" ColumnDefinitions="66,*,96" ColumnSpacing="10">
                    <TextBlock Grid.Column="0" Classes="label" Text="RUNNING" VerticalAlignment="Center"
                               IsVisible="{Binding !HasRunning}"/>
                    <DockPanel Grid.Column="1">
                        <TextBlock DockPanel.Dock="Left" Classes="runidle" Margin="0,0,10,0" Text="nothing running"
                                   IsVisible="{Binding !HasRunning}"/>
                        <ItemsControl x:Name="IdleAvatars" ItemsSource="{Binding IdleLanes}" VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vr:RunningLaneViewModel">
                                    <Button Classes="avatar" Command="{Binding ActCommand}"
                                            ToolTip.Tip="{Binding StartTooltip}">
                                        <ctl:HexPortrait Size="22" Source="{Binding Face.Portrait}"
                                                         Initial="{Binding Face.Initial}"/>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                    <Button Grid.Column="2" Classes="rowaction" VerticalAlignment="Center" HorizontalAlignment="Right"
                            Command="{Binding OpenRunStartCommand}" ToolTip.Tip="Start a run for one or more characters">
                        <StackPanel Orientation="Horizontal" Spacing="3">
                            <TextBlock Text="START RUN" VerticalAlignment="Center"/>
                            <mi:MaterialIcon Classes="icon-sm" Kind="MenuDown"/>
                        </StackPanel>
                    </Button>
                </Grid>
                <TextBlock x:Name="LanesEmpty" Classes="hint" Margin="0,0,0,4" TextWrapping="Wrap"
                           IsVisible="{Binding LanesEmptyText, Converter={x:Static ObjectConverters.IsNotNull}}"
                           Text="{Binding LanesEmptyText}"/>
            </StackPanel>
        </Border>

        <!-- ══ Unfinished ══ stopped and then left there. Its own band, above the days and never a row inside one:
             a run that was never saved must not count towards an evening's total (ET-179 AC-3). Gone entirely once
             the last one is dealt with — an empty band would be a permanent reminder of nothing. Local only, like
             RUNNING: a run still owing a decision owes it on this machine. -->
        <Border DockPanel.Dock="Top" Padding="14,10" BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource BorderBrush}"
                IsVisible="{Binding ShowUnfinishedBand}">
            <StackPanel Spacing="5">
                <TextBlock Classes="label" Text="UNFINISHED"/>
                <TextBlock Classes="hint" Margin="0" TextWrapping="Wrap"
                           Text="Stopped, but never saved or thrown away. A day after it stopped, a run here is saved as it stands."/>
                <ScrollViewer MaxHeight="180" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="UnfinishedList" ItemsSource="{Binding UnfinishedRuns}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vr:UnfinishedRunViewModel">
                                <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="10" Margin="0,3">
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock FontSize="11.5" TextTrimming="CharacterEllipsis"
                                                   Foreground="{StaticResource TextBrightBrush}"
                                                   Text="{Binding TitleText}"/>
                                        <TextBlock Classes="rowsub" Text="{Binding StoppedText}"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Classes="rowfigure" VerticalAlignment="Center"
                                               Text="{Binding DurationText}"/>
                                    <TextBlock Grid.Column="2" Classes="rowfigure" VerticalAlignment="Center"
                                               Classes.dim="{Binding TotalIskUnknown}" Text="{Binding TotalIskText}"/>
                                    <!-- Disabled rather than hidden for an abyssal whose pocket already collapsed
                                         (ET-254 AC-5, CanResume): SAVE and DELETE still apply to it, so the row
                                         keeps its usual shape instead of one button's absence shifting the rest. -->
                                    <Button Grid.Column="3" Classes="rowaction" MinWidth="62"
                                            Content="RESUME" Command="{Binding ResumeCommand}"
                                            ToolTip.Tip="Reopen the run window on this run and pick the clock back up"/>
                                    <Button Grid.Column="4" Classes="rowaction" MinWidth="62"
                                            Content="SAVE" Command="{Binding SaveCommand}"/>
                                    <Button Grid.Column="5" Classes="rowaction" MinWidth="62"
                                            Content="DELETE" Command="{Binding DeleteCommand}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </Border>

        <!-- ══ Range line and band (ET-292) ══ the month in view, or the day or week picked in the strip, with its
             totals — ET-266's weight on them kept: mono 12.5 semibold, the ISK 15 bold. Under it the band: the activity
             strip in a 400 px column beside the two filter columns RO-4 fills, and across the whole width below the
             breakpoint. Shown for every source (Local, a fleet filter, a server tab): all three page the same way. -->
        <Border DockPanel.Dock="Top" Padding="14,10,14,12" BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource BorderBrush}">
            <StackPanel Spacing="10">
                <!-- Wide, the totals sit on the line itself; narrow, on a line of their own under it. -->
                <Grid x:Name="RangeLine" Classes="rangeline" Classes.narrow="{Binding IsNarrow}" RowDefinitions="26,Auto">
                    <DockPanel Grid.Row="0">
                        <Button x:Name="RangePrevious" DockPanel.Dock="Left" Classes="rangenav" Content="&#x25C0;"
                                Command="{Binding PreviousCommand}" ToolTip.Tip="{Binding PreviousTooltip}"/>
                        <TextBlock x:Name="RangeTitle" DockPanel.Dock="Left" Classes="rangetitle" Margin="10,0,0,0"
                                   Text="{Binding RangeTitleText}"/>
                        <Button x:Name="RangeClear" DockPanel.Dock="Left" Classes="rangeclear" Margin="4,0,0,0"
                                Content="&#x2715;" IsVisible="{Binding IsRangePicked}"
                                Command="{Binding ClearRangeCommand}" ToolTip.Tip="Back to the whole month"/>
                        <Button x:Name="RangeNext" DockPanel.Dock="Left" Classes="rangenav" Margin="10,0,0,0"
                                Content="&#x25B6;" Command="{Binding NextCommand}" ToolTip.Tip="{Binding NextTooltip}"/>
                        <!-- Kept for SUMMARY (RO-5) and PUBLISH n LOCAL (RO-6): the totals end where they begin. -->
                        <StackPanel x:Name="RangeActions" DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8"/>
                        <Panel/>
                    </DockPanel>
                    <StackPanel x:Name="RangeTotals" Classes="rangetotals" Orientation="Horizontal"
                                Spacing="10">
                        <TextBlock Classes="monthfigure" Text="{Binding RangeCountText}"/>
                        <TextBlock Classes="monthfigure sep" Text="&#x00B7;"/>
                        <TextBlock Classes="monthfigure" Text="{Binding RangeFlownText}"/>
                        <TextBlock Classes="monthfigure sep" Text="&#x00B7;"/>
                        <ctl:IskSourceBar Width="90" Height="8" VerticalAlignment="Center" Isk="{Binding RangeIsk}"/>
                        <!-- 10 px of air before the edge or ▶ (ET-266): the heaviest figure never touches a control. -->
                        <TextBlock x:Name="RangeNet" Classes="monthfigure isk" Margin="0,0,10,0"
                                   Text="{Binding RangeNetText}"/>
                    </StackPanel>
                </Grid>

                <Grid x:Name="Band" Classes.narrow="{Binding IsNarrow}" ColumnDefinitions="400,*,*" ColumnSpacing="28"
                      RowDefinitions="Auto,Auto" RowSpacing="10">
                    <Grid.Resources>
                        <!-- ET-293: a check box, a type icon or a character's HexPortrait, the full name and the
                             count — shared between the TYPES and CHARACTERS ItemsControl below. -->
                        <DataTemplate x:Key="FilterTileTemplate" DataType="vr:RunFilterTileViewModel">
                            <Button Classes="tile" Classes.on="{Binding IsOn}" Focusable="True"
                                    PointerReleased="_OnFilterTilePointerReleased" KeyDown="_OnFilterTileKeyDown"
                                    ToolTip.Tip="{Binding Name}">
                                <Panel>
                                    <Border Classes="tilefill"/>
                                    <Border Classes="tileaccent" IsVisible="{Binding IsOn}"/>
                                    <Border Classes="tilefocus"/>
                                    <Grid ColumnDefinitions="13,Auto,*,Auto" ColumnSpacing="6" Margin="6,0,8,0">
                                        <Border Grid.Column="0" Classes="tilecheck" Width="13" Height="13"
                                                VerticalAlignment="Center">
                                            <mi:MaterialIcon Kind="Check" Width="10" Height="10"
                                                              Foreground="#FF0C100E" IsVisible="{Binding IsOn}"/>
                                        </Border>
                                        <mi:MaterialIcon Grid.Column="1" Classes="tileicon" Width="16" Height="16"
                                                          Kind="{Binding Icon}"
                                                          IsVisible="{Binding Icon, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                                        <ctl:HexPortrait Grid.Column="1" Classes="tileportrait" Size="20"
                                                          Source="{Binding Face.Portrait}" Initial="{Binding Face.Initial}"
                                                          IsVisible="{Binding Face, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                                        <TextBlock Grid.Column="2" Classes="tilename" Text="{Binding Name}"/>
                                        <TextBlock Grid.Column="3" Classes="tilecount" Text="{Binding Count}"/>
                                    </Grid>
                                </Panel>
                            </Button>
                        </DataTemplate>
                    </Grid.Resources>

                    <vw:RunsActivityStrip x:Name="ActivityStrip" Grid.Column="0" DataContext="{Binding Strip}"/>

                    <Border Grid.Column="1" Classes="filterblock" DataContext="{Binding TypeFilter}">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,6" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="6">
                                <TextBlock Grid.Column="0" Classes="label" Text="{Binding Label}"/>
                                <TextBlock Grid.Column="2" Classes="filtersummary" Text="{Binding SummaryText}"
                                           IsVisible="{Binding HasSummary}"/>
                                <Button Grid.Column="3" Classes="showall" Command="{Binding ShowAllCommand}"
                                        IsVisible="{Binding HasSummary}">
                                    <TextBlock Classes="showalltext" Text="show all"/>
                                </Button>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding Tiles}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <ctl:ColumnFlowPanel MaxColumns="2" ColumnSpacing="10" RowSpacing="4" MinRowHeight="28"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <StaticResource ResourceKey="FilterTileTemplate"/>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="2" Classes="filterblock" DataContext="{Binding CharacterFilter}">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,6" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="6">
                                <TextBlock Grid.Column="0" Classes="label" Text="{Binding Label}"/>
                                <TextBlock Grid.Column="2" Classes="filtersummary" Text="{Binding SummaryText}"
                                           IsVisible="{Binding HasSummary}"/>
                                <Button Grid.Column="3" Classes="showall" Command="{Binding ShowAllCommand}"
                                        IsVisible="{Binding HasSummary}">
                                    <TextBlock Classes="showalltext" Text="show all"/>
                                </Button>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding Tiles}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <ctl:ColumnFlowPanel MaxColumns="2" ColumnSpacing="10" RowSpacing="4" MinRowHeight="28"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <StaticResource ResourceKey="FilterTileTemplate"/>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DockPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ══ Finished activities ══ the one undocked child (ET-285): the list, and the pane's own column beside it.
             The column is explicit and never Auto; its width is set from the content root's bounds in the code-behind
             (400 wide, 0 below the breakpoint, where the very same pane is the drawer instead). The days belong to the
             selected source: Local holds every activity, a server tab the ones published to it. -->
        <Grid x:Name="ListAndPane">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="0"/>
            </Grid.ColumnDefinitions>
            <Grid.DataTemplates>
                <!-- A day: caret, the weekday bright and the date dim, and its summary — still there while it is
                     folded (ET-199 AC-4). A click anywhere on it folds or unfolds it. -->
                <DataTemplate DataType="vr:RunsDayViewModel">
                    <Button Classes="dayband" Command="{Binding ToggleCommand}"
                            ToolTip.Tip="Show or hide this day's activities">
                        <Border Classes="dayhead">
                            <Grid Margin="14,0" ColumnDefinitions="18,*,24" ColumnSpacing="8">
                                <TextBlock Grid.Column="0" Classes="caret" Classes.expanded="{Binding IsExpanded}"
                                           Text="&#x25B6;"/>
                                <DockPanel Grid.Column="1">
                                    <TextBlock DockPanel.Dock="Left" Classes="dayweek" Text="{Binding WeekdayText}"/>
                                    <TextBlock DockPanel.Dock="Left" Classes="daydate" Margin="8,0,12,0"
                                               Text="{Binding DateText}"/>
                                    <TextBlock DockPanel.Dock="Right" Classes="daysum" Margin="8,0,0,0" MinWidth="60"
                                               Text="{Binding NetText}"/>
                                    <ctl:IskSourceBar DockPanel.Dock="Right" Width="48" Height="6" Margin="8,0,0,0"
                                                      VerticalAlignment="Center" Isk="{Binding Isk}"/>
                                    <TextBlock Classes="daysum" Text="{Binding CountAndFlownText}"/>
                                </DockPanel>
                            </Grid>
                        </Border>
                    </Button>
                </DataTemplate>

                <!-- An activity: 36 px, one control. The row button selects it and the pane reads it (ET-291); the
                     detail screen is a double-click, ↵ or the pane's own OPEN DETAIL. The caret sits on top of the
                     row rather than inside it, so a click aimed at the row can never fold a group. -->
                <DataTemplate DataType="vr:ActivityOverviewRowViewModel">
                    <Border Height="36" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource DividerBrush}">
                        <Panel>
                            <Button Classes="activityrow" Command="{Binding SelectCommand}">
                                <Grid Margin="14,0" ColumnDefinitions="18,40,18,*,84,100,24" ColumnSpacing="8">
                                    <TextBlock Grid.Column="1" Classes="rowtime" Text="{Binding TimeText}"/>
                                    <ctl:IconGlyph Grid.Column="2" Classes="typeicon" Kind="{Binding TypeIcon}"
                                                   ToolTip.Tip="{Binding TypeText}"/>
                                    <StackPanel Grid.Column="3" VerticalAlignment="Center" Spacing="1">
                                        <TextBlock Classes="rowsite" Text="{Binding SiteText}"/>
                                        <DockPanel Height="15">
                                            <TextBlock DockPanel.Dock="Left" Classes="rowline rowkind"
                                                       Text="{Binding TypeText}"/>
                                            <TextBlock DockPanel.Dock="Left" Classes="rowline" Margin="7,0,0,0"
                                                       ToolTip.Tip="{Binding SystemTooltip}" Text="{Binding SystemLineText}"/>
                                            <!-- Only on a row nobody committed themselves (ET-179): an activity auto-saved
                                                 a day after it stopped must not read as one a pilot stood behind. -->
                                            <Border DockPanel.Dock="Left" Classes="chip dim" Margin="7,0,0,0"
                                                    IsVisible="{Binding HasAutoSavedRun}">
                                                <TextBlock Text="{Binding AutoSavedText}"/>
                                            </Border>
                                            <ItemsControl Margin="7,0,0,0" ItemsSource="{Binding Chips}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <ctl:ChipLinePanel Spacing="4"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="vr:ActivityRewardChipViewModel">
                                                        <Border Classes="chip" Classes.dim="{Binding IsKnownKind}"
                                                                Classes.warn="{Binding IsUnknownKind}">
                                                            <TextBlock Text="{Binding Text}"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </DockPanel>
                                    </StackPanel>
                                    <!-- One pilot by name, several as a stack of faces; every name on hover. -->
                                    <Panel Grid.Column="4" ToolTip.Tip="{Binding CrewText}">
                                        <TextBlock Classes="rowline" HorizontalAlignment="Right" FontSize="10"
                                                   TextTrimming="CharacterEllipsis"
                                                   IsVisible="{Binding !HasCrewStack}" Text="{Binding SoloCrewText}"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="3"
                                                    VerticalAlignment="Center" IsVisible="{Binding HasCrewStack}">
                                            <ctl:HexStack Size="16" Overlap="5" VerticalAlignment="Center"
                                                          Faces="{Binding CrewFaces}"/>
                                            <TextBlock Classes="rowsmall" Text="{Binding CrewCountText}"/>
                                        </StackPanel>
                                    </Panel>
                                    <StackPanel Grid.Column="5" VerticalAlignment="Center">
                                        <TextBlock Classes="rowfigure" IsVisible="{Binding HasNet}" Text="{Binding NetText}"/>
                                        <!-- Never a "0 ISK" where nothing was valued: a zero reads as a valuation that
                                             came out at nothing. A dash instead where none of this pilot's own
                                             characters flew it (ET-296) — the why is on hover, there is no room for
                                             it on the row. -->
                                        <TextBlock Classes="rownone" IsVisible="{Binding !HasNet}"
                                                   ToolTip.Tip="{Binding NoNetTooltip}"
                                                   Text="{Binding NoNetText}"/>
                                        <TextBlock Classes="rowsmall" Text="{Binding DurationText}"/>
                                    </StackPanel>
                                    <!-- A run knows where it stands towards a server, so the row says it. -->
                                    <ctl:IconGlyph Grid.Column="6" Classes="syncstate"
                                                   Classes.attention="{Binding IsSyncAttention}"
                                                   Classes.failed="{Binding IsSyncFailed}"
                                                   Kind="{Binding SyncIcon}" IsVisible="{Binding HasSyncText}"
                                                   ToolTip.Tip="{Binding SyncText}"/>
                                </Grid>
                            </Button>
                            <Button Classes="caretbtn" Width="18" Height="36" Margin="14,0,0,0" HorizontalAlignment="Left"
                                    IsVisible="{Binding HasCrewStack}" Command="{Binding ToggleCommand}"
                                    ToolTip.Tip="Show the pilots on this activity">
                                <TextBlock Classes="caret" Classes.expanded="{Binding IsExpanded}" Text="&#x25B6;"/>
                            </Button>
                        </Panel>
                    </Border>
                </DataTemplate>

                <!-- A pilot's own run under an unfolded activity: face and name, their own time and ISK, their own
                     standing towards a server. Six pilots on one site are six of these under one row (ET-161 AC-5).
                     A click selects the activity above it, the same as a click on that row: these are the one
                     activity's runs, and the pane has no smaller thing to show. -->
                <DataTemplate DataType="vr:ActivityRunRowViewModel">
                    <Button Classes="activityrow" Height="26" Command="{Binding Activity.SelectCommand}"
                            Background="{StaticResource BgRowBrush}">
                        <Grid Margin="14,0" ColumnDefinitions="18,40,18,*,84,100,24" ColumnSpacing="8">
                            <DockPanel Grid.Column="3">
                                <ctl:HexPortrait DockPanel.Dock="Left" Size="14" VerticalAlignment="Center"
                                                 Source="{Binding Face.Portrait}" Initial="{Binding Face.Initial}"/>
                                <TextBlock DockPanel.Dock="Right" Classes="rowline" Margin="8,0,0,0"
                                           TextTrimming="CharacterEllipsis" Text="{Binding StandingText}"/>
                                <TextBlock Margin="6,0,0,0" FontSize="11" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{StaticResource TextBrush}" Text="{Binding CharacterText}"/>
                            </DockPanel>
                            <TextBlock Grid.Column="4" Classes="rowsmall" Text="{Binding DurationText}"
                                       ToolTip.Tip="{Binding TimeSourceText}"/>
                            <TextBlock Grid.Column="5" Classes="rowsmall" Foreground="{StaticResource TextBrightBrush}"
                                       Text="{Binding IskText}"/>
                            <ctl:IconGlyph Grid.Column="6" Classes="syncstate" Kind="{Binding SyncIcon}"
                                           IsVisible="{Binding HasSyncIcon}" ToolTip.Tip="{Binding SyncText}"/>
                        </Grid>
                    </Button>
                </DataTemplate>

                <DataTemplate DataType="vr:RunsListNote">
                    <TextBlock Classes="hint" Margin="102,4,14,6" Text="{Binding Text}"/>
                </DataTemplate>
            </Grid.DataTemplates>

            <Grid Grid.Column="0" RowDefinitions="Auto,*">
                <TextBlock x:Name="TabStatus" Grid.Row="0" Classes="hint" Margin="14,10" TextWrapping="Wrap"
                           IsVisible="{Binding SelectedTab.StatusMessage, Converter={x:Static ObjectConverters.IsNotNull}}"
                           Text="{Binding SelectedTab.StatusMessage}"/>
                <!-- Virtualised: a month of a thousand activities realises only the rows on screen. SelectedItem is
                     bound to the screen's own selection (ET-291) and not the other way round: the list drops it
                     whenever a folded day takes the row out of Items, and that null is not an answer. -->
                <ctl:RecyclingListBox x:Name="ActivityList" Grid.Row="1" Classes="runslist"
                                      ItemsSource="{Binding SelectedTab.Items}"
                                      SelectedItem="{Binding ListSelection, Mode=TwoWay}"
                                      SelectionMode="Single"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ctl:RecyclingListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel/>
                        </ItemsPanelTemplate>
                    </ctl:RecyclingListBox.ItemsPanel>
                </ctl:RecyclingListBox>
                <!-- The day of the topmost row, pinned while its own header is scrolled away (RunsWindow.axaml.cs). -->
                <Border x:Name="StickyDay" Grid.Row="1" VerticalAlignment="Top" IsVisible="False"
                        Background="{StaticResource DrawerSurfaceBrush}">
                    <ContentControl x:Name="StickyDayContent"/>
                </Border>
            </Grid>

            <!-- The pane beside the list, on the wide layout. One view model, two hosts (ET-291): this one and the
                 drawer below, of which exactly one is ever shown. -->
            <Border x:Name="PaneHost" Grid.Column="1" Classes="panecolumn" IsVisible="{Binding IsWide}">
                <vw:RunsActivityPane DataContext="{Binding Pane}"/>
            </Border>
        </Grid>
    </DockPanel>

    <!-- ══ Layer 1 ══ the list dimmed behind the drawer. A click on it closes — which is the whole point of a 430 px
         drawer rather than a full-width one: the list stays visible and is itself the way out (Jithran, 15 Sep). -->
    <Border x:Name="Scrim" Classes="scrim" Classes.open="{Binding IsDrawerOpen}"
            IsVisible="{Binding IsNarrow}">
        <Button x:Name="ScrimClose" Classes="scrimbtn" Background="Transparent" BorderThickness="0" CornerRadius="0"
                Padding="0" MinHeight="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                IsTabStop="False" Command="{Binding CloseDrawerCommand}"
                ToolTip.Tip="Click to close"/>
    </Border>

    <!-- ══ Layer 2 ══ the drawer, over the whole module content, header and bands included. -->
    <Border x:Name="Drawer" Classes="drawer" Classes.open="{Binding IsDrawerOpen}"
            IsVisible="{Binding IsNarrow}">
        <DockPanel>
            <Border Classes="dbar" DockPanel.Dock="Top">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
                    <Border Grid.Column="0" Classes="dlabel">
                        <TextBlock Text="{Binding Pane.Title}"/>
                    </Border>
                    <TextBlock Grid.Column="2" Classes="kbd" Text="Esc"/>
                    <Button x:Name="DrawerClose" Grid.Column="3" Classes="drawerclose" Content="&#x2715;"
                            Command="{Binding CloseDrawerCommand}" ToolTip.Tip="Close (Esc)"/>
                </Grid>
            </Border>
            <vw:RunsActivityPane DataContext="{Binding Pane}"/>
        </DockPanel>
    </Border>
    </Grid>
</v:ChromedWindow>
