<v:ChromedWindow xmlns="https://github.com/avaloniaui" xmlns:v="using:EveUtils.Client.Views"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dlg="using:EveUtils.Client.Dialogs"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        mc:Ignorable="d" d:DesignWidth="460" d:DesignHeight="460"
        x:Class="EveUtils.Client.Views.FleetInviteWindow"
        x:Name="Root"
        Width="460" Height="460"
        WindowStartupLocation="CenterOwner"
        Title="Invite to fleet">

    <DockPanel Margin="16">
        <!-- Styles live on the content root, never on the window (ET-42/ET-156). Same row treatment as
             CharacterPickerWindow (ET-184) — this dialog always picks one character, so only the radio mark. -->
        <DockPanel.Styles>
            <Style Selector="Border.pickrow">
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Background" Value="{StaticResource BgRowBrush}"/>
                <Setter Property="Padding" Value="9,7"/>
                <Setter Property="Margin" Value="0,0,0,6"/>
            </Style>
            <Style Selector="Border.pickrow.selected">
                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
            </Style>
            <Style Selector="TextBlock.pickname">
                <Setter Property="Foreground" Value="{StaticResource TextBrightBrush}"/>
                <Setter Property="FontSize" Value="12.5"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            </Style>
            <Style Selector="Border.pickrow.disabled TextBlock.pickname">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            </Style>
            <Style Selector="TextBlock.pickdetail">
                <Setter Property="Foreground" Value="{DynamicResource TextAccentBrush}"/>
                <Setter Property="FontSize" Value="10"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            </Style>
            <Style Selector="TextBlock.pickdetail.why">
                <Setter Property="Foreground" Value="#E0B341"/>
            </Style>
            <Style Selector="Border.pickrow.disabled Panel.pickhex">
                <Setter Property="Opacity" Value="0.5"/>
            </Style>
            <Style Selector="mi|MaterialIcon.markoff">
                <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
            </Style>
            <Style Selector="mi|MaterialIcon.markon">
                <Setter Property="IsVisible" Value="False"/>
                <Setter Property="Foreground" Value="{DynamicResource AccentBrightBrush}"/>
            </Style>
            <Style Selector="Border.pickrow.selected mi|MaterialIcon.markoff">
                <Setter Property="IsVisible" Value="False"/>
            </Style>
            <Style Selector="Border.pickrow.selected mi|MaterialIcon.markon">
                <Setter Property="IsVisible" Value="True"/>
            </Style>
            <Style Selector="Border.pickrow.disabled mi|MaterialIcon.markoff">
                <Setter Property="Opacity" Value="0.4"/>
            </Style>
            <Style Selector="ListBox.picklist ListBoxItem" x:DataType="dlg:CharacterPickRowViewModel">
                <Setter Property="Padding" Value="0"/>
                <Setter Property="IsEnabled" Value="{Binding Enabled}"/>
            </Style>
            <Style Selector="ListBox.picklist ListBoxItem:selected /template/ ContentPresenter">
                <Setter Property="Background" Value="Transparent"/>
            </Style>
        </DockPanel.Styles>

        <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,14">
            <TextBlock x:Name="HeaderBlock" Text="Invite a character" FontWeight="Bold" FontSize="15"
                       Foreground="{StaticResource TextBrightBrush}"/>
            <TextBlock Text="Pick a connected character, the role they take on accept, and an optional note."
                       FontSize="11" Foreground="{DynamicResource TextAccentBrush}" TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"
                    Spacing="8" Margin="0,14,0,0">
            <Button Content="Cancel" Click="OnCancel"/>
            <Button Content="Send invite →" Click="OnConfirm" Classes="accent"/>
        </StackPanel>

        <StackPanel Spacing="10">
            <StackPanel Spacing="3">
                <TextBlock Text="CHARACTER" Classes="label" FontSize="9"/>
                <Border Classes="panel" Height="150">
                    <ListBox x:Name="OptionList" Classes="picklist" ItemsSource="{Binding Options, ElementName=Root}"
                             SelectionMode="Single" Margin="6">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="dlg:CharacterPickRowViewModel">
                                <Border Classes="pickrow" Classes.selected="{Binding IsSelected}" Classes.disabled="{Binding !Enabled}">
                                    <Grid ColumnDefinitions="Auto,10,*,10,Auto">
                                        <!-- hex ESI portrait + glyph fallback (MainWindow.axaml:635-644) -->
                                        <Panel Grid.Column="0" Classes="pickhex" Width="46" Height="52" VerticalAlignment="Center">
                                            <Panel.Clip><PathGeometry Figures="M23,0 L46,13 L46,39 L23,52 L0,39 L0,13 Z"/></Panel.Clip>
                                            <Border Background="{DynamicResource AccentSoftBrush}" IsVisible="{Binding !HasPortrait}">
                                                <TextBlock Text="{Binding Initial}" FontSize="18" FontWeight="Bold"
                                                           Foreground="{DynamicResource AccentBrightBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <Image Source="{Binding Portrait}" Stretch="UniformToFill" IsVisible="{Binding HasPortrait}"/>
                                        </Panel>

                                        <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Classes="pickname" Text="{Binding Name}"/>
                                            <StackPanel Orientation="Horizontal" Spacing="4"
                                                        IsVisible="{Binding Detail, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                <mi:MaterialIcon Classes="icon-sm" Kind="AlertOutline" Foreground="#E0B341"
                                                                  IsVisible="{Binding !Enabled}"/>
                                                <TextBlock Classes="pickdetail" Classes.why="{Binding !Enabled}" Text="{Binding Detail}"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <Panel Grid.Column="4" Width="20" Height="20" VerticalAlignment="Center">
                                            <mi:MaterialIcon Classes="icon-lg markoff" Kind="RadioboxBlank"/>
                                            <mi:MaterialIcon Classes="icon-lg markon" Kind="RadioboxMarked"/>
                                        </Panel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </StackPanel>
            <StackPanel Spacing="3">
                <TextBlock Text="ROLE ON ACCEPT" Classes="label" FontSize="9"/>
                <ComboBox x:Name="RoleBox" HorizontalAlignment="Stretch" SelectedIndex="3">
                    <ComboBoxItem>Fleet commander</ComboBoxItem>
                    <ComboBoxItem>Wing commander</ComboBoxItem>
                    <ComboBoxItem>Squad commander</ComboBoxItem>
                    <ComboBoxItem>Squad member</ComboBoxItem>
                </ComboBox>
            </StackPanel>
            <StackPanel Spacing="3">
                <TextBlock Text="MESSAGE (OPTIONAL)" Classes="label" FontSize="9"/>
                <TextBox x:Name="MessageBox" PlaceholderText="A short note for the invitee…"
                         AcceptsReturn="True" Height="56" TextWrapping="Wrap" VerticalContentAlignment="Top"/>
            </StackPanel>
        </StackPanel>
    </DockPanel>
</v:ChromedWindow>
