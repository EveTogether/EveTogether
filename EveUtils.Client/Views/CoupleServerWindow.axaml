<v:ChromedWindow xmlns="https://github.com/avaloniaui" xmlns:v="using:EveUtils.Client.Views"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:coupling="using:EveUtils.Client.ViewModels.Coupling"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="560" d:DesignHeight="560"
        x:Class="EveUtils.Client.Views.CoupleServerWindow"
        x:DataType="coupling:ServerCoupleViewModel"
        Width="560" Height="560" CanResize="False"
        WindowStartupLocation="CenterOwner"
        Title="Couple to server">

    <Window.Styles>
        <StyleInclude Source="avares://EveUtils.Client/Views/SetupStyles.axaml"/>
    </Window.Styles>

    <DockPanel Background="#FF0C100E">
        <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DividerBrush}" Padding="18,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Content="Cancel" Click="OnCancel" IsVisible="{Binding !IsCoupled}"/>
                <Button Classes="accent" Content="{Binding CoupleButtonText}" Command="{Binding CoupleCommand}"
                        IsVisible="{Binding ShowCoupleButton}"/>
                <Button Classes="accent" Content="Close" Click="OnCancel" IsVisible="{Binding IsCoupled}"/>
            </StackPanel>
        </Border>

        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="22,18">
                <TextBlock Classes="h2" Text="{Binding Title}"/>
                <TextBlock Classes="intro" Text="A server is run by your corp or friends. Coupled, this character can form fleets with others, share fits and runs. Coupling is a second EVE login, through the server."/>
                <v:ServerCoupleView/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</v:ChromedWindow>
