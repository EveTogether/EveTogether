<v:OverlayWindow xmlns="https://github.com/avaloniaui" xmlns:v="using:EveUtils.Client.Views"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:EveUtils.Client.ViewModels"
        xmlns:ctl="using:EveUtils.Client.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="440" d:DesignHeight="300"
        x:Class="EveUtils.Client.Views.DpsOverlayWindow"
        x:DataType="vm:DpsViewModel"
        x:Name="OverlayRoot"
        Title="DPS Overlay"
        Icon="/Assets/eve-together.ico"
        Width="440" Height="300" MinWidth="300" MinHeight="190"
        Topmost="True" ShowInTaskbar="True"
        WindowDecorations="None"
        WindowStartupLocation="CenterScreen"
        TransparencyLevelHint="Transparent"
        Background="Transparent">

    <Design.DataContext>
        <vm:DpsViewModel/>
    </Design.DataContext>

    <!-- Backdrop fill opacity is driven from code (OverlayRoot.FillOpacity) so the chart + text stay crisp. -->
    <Border x:Name="Backdrop" Classes="panel">
        <DockPanel>
            <Border Classes="panel-header" DockPanel.Dock="Top" x:Name="DragHandle"
                    PointerPressed="OnHeaderPressed">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Classes="diamond" Text="◆"/>
                            <TextBlock Classes="panel-title" Text="{Binding Character}"/>
                            <Border Classes="verdict" Margin="4,0,0,0"
                                    Classes.sweet="{Binding IsApplicationSweetSpot}"
                                    Classes.adjust="{Binding IsApplicationAdjust}"
                                    Classes.unjudged="{Binding IsApplicationUnjudged}"
                                    IsVisible="{Binding HasApplication}"
                                    ToolTip.Tip="{Binding ApplicationTip}">
                                <TextBlock Text="{Binding ApplicationText}"/>
                            </Border>
                        </StackPanel>
                        <!-- The same rows as the member's fleet card (ET-277): a figure and a meter each, on the scale
                             the tracker carries — the fleet's own when this was popped out of the fleet screen. -->
                        <v:CombatMeters Margin="0,4,0,0"/>
                        <!-- Location + bounty, mirroring the fleet-metrics row: shown only when known/shared. -->
                        <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,2,0,0">
                            <!-- Same tracker instance as the fleet-metrics row, so it turns green with it when the
                                 member stands in the FC's system — and moves along when either of them jumps. -->
                            <TextBlock Classes="location" Classes.withfc="{Binding IsWithCommander}"
                                       Classes.offline="{Binding IsOffline}"
                                       FontSize="11"
                                       IsVisible="{Binding LocationDisplay, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                       Text="{Binding LocationDisplay, StringFormat='◉ {0}'}"
                                       ToolTip.Tip="Current solar system"/>
                            <TextBlock FontSize="11" Foreground="#FFE0B25A"
                                       IsVisible="{Binding HasBounty}"
                                       Text="{Binding BountyText, StringFormat='◇ {0}'}"
                                       ToolTip.Tip="Bounty earned this session"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Opacity, pin and close: one shared row, so this pop-out and the fleet one look and behave
                         alike (ET-73). -->
                    <v:OverlayChromeButtons Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Top"
                                            FillOpacity="{Binding #OverlayRoot.FillOpacity, Mode=TwoWay}"/>
                </Grid>
            </Border>

            <Border Margin="6" Background="#22000000" Cursor="Hand" Tapped="OnActivateClient"
                    ToolTip.Tip="Click to bring this character's EVE client to the front">
                <ctl:DpsGraph Series="{Binding Series}"
                              Revision="{Binding GraphRevision}"
                              Markers="{Binding Markers}"
                              HitPointsMax="{Binding HitPointsScale}"
                              CapacitorMax="{Binding CapacitorScale}"/>
            </Border>
        </DockPanel>
    </Border>
</v:OverlayWindow>
