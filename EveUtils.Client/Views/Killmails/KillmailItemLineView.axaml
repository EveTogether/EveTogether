<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vk="using:EveUtils.Client.ViewModels.Killmails"
             x:Class="EveUtils.Client.Views.Killmails.KillmailItemLineView"
             x:DataType="vk:KillmailDetailItemRowViewModel">

    <!-- One FIT-section item row (ET-333, columns ET-475): the ActivityLootLineView look (icon, name, quantity), then
         the ISK that dropped (green) and that was destroyed (red) in their own columns. No stripe — a hairline under
         every row instead. The column widths match KillmailFitGroupView's header and the column captions. -->
    <UserControl.Styles>
        <StyleInclude Source="avares://EveUtils.Client/Views/Runs/LootItemStyles.axaml"/>
    </UserControl.Styles>

    <Border Classes="itemrow detailrow" BorderBrush="{DynamicResource DividerBrush}">
        <Grid ColumnDefinitions="20,*,56,128,128" ColumnSpacing="6">
            <Border Classes="icontile">
                <Panel>
                    <TextBlock Text="{Binding Initial}" FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrightBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !HasIcon}"/>
                    <Image Source="{Binding Icon}" IsVisible="{Binding HasIcon}"/>
                </Panel>
            </Border>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                        VerticalAlignment="Center" ClipToBounds="True">
                <TextBlock Classes="itemname" Text="{Binding Name}"/>
                <TextBlock Classes="meta" Text="{Binding MetaHint}"
                           IsVisible="{Binding MetaHint, Converter={x:Static ObjectConverters.IsNotNull}}"/>
            </StackPanel>
            <TextBlock Grid.Column="2" Classes="money" Text="{Binding QuantityText}"/>
            <TextBlock Grid.Column="3" Classes="money" Foreground="{StaticResource GreenBrush}" Text="{Binding DroppedText}"/>
            <TextBlock Grid.Column="4" Classes="money" Foreground="{StaticResource RedBrush}" Text="{Binding DestroyedText}"/>
        </Grid>
    </Border>
</UserControl>
