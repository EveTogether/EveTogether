<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vh="using:EveUtils.Client.ViewModels.Home"
             x:Class="EveUtils.Client.Views.Home.HomeSystemStrip"
             x:DataType="vh:HomeSystemStripViewModel">

    <!-- The plumbing in one line: a green dot where it runs, a dim one where it is off; values bright. Wraps when narrow. -->
    <WrapPanel Margin="14,8">
        <StackPanel Classes="strip">
            <Ellipse Classes="dot" Classes.up="{Binding ArePricesFresh}"/>
            <TextBlock Text="{Binding PricesText}"/>
        </StackPanel>
        <StackPanel Classes="strip">
            <Ellipse Classes="dot" Classes.up="{Binding HasSde}"/>
            <TextBlock Text="{Binding SdeText}"/>
        </StackPanel>
        <StackPanel Classes="strip" ToolTip.Tip="Settings → Privacy &amp; Sharing">
            <Ellipse Classes="dot" Classes.up="{Binding IsClipboardWatching}"/>
            <TextBlock Text="Clipboard watch"/>
            <TextBlock Classes="value" Text="{Binding ClipboardText}"/>
        </StackPanel>
        <StackPanel Classes="strip">
            <Ellipse Classes="dot" Classes.up="{Binding IsAutoSyncOn}"/>
            <TextBlock Text="EVE settings auto-sync"/>
            <TextBlock Classes="value" Text="{Binding AutoSyncText}"/>
        </StackPanel>
        <StackPanel Classes="strip">
            <Ellipse Classes="dot" Classes.up="{Binding IsLocalApiRunning}"/>
            <TextBlock Text="Local API"/>
            <TextBlock Classes="value" Text="{Binding LocalApiText}"/>
        </StackPanel>
        <StackPanel Classes="strip">
            <Ellipse Classes="dot up"/>
            <TextBlock Text="EVE Together"/>
            <TextBlock Classes="value" Text="{Binding VersionText}"/>
            <TextBlock Text="·"/>
            <TextBlock Text="{Binding UpdateText}"/>
        </StackPanel>
    </WrapPanel>
</UserControl>
