<v:ChromedWindow xmlns="https://github.com/avaloniaui" xmlns:v="using:EveUtils.Client.Views"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:va="using:EveUtils.Client.ViewModels.Activity"
        xmlns:vr="using:EveUtils.Client.ViewModels.Runs"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="758" d:DesignHeight="720"
        x:Class="EveUtils.Client.Views.ActivityDetailWindow"
        x:DataType="vr:ActivityDetailViewModel"
        Width="758" Height="720" MinWidth="420" MinHeight="320"
        WindowStartupLocation="CenterOwner"
        Title="Activity detail">

    <!-- One layout, sized off the space it is given rather than off the window: ModuleHostService moves this very
         Content between a docked tab (758px) and a floating window, and there is no pop-out variant to fall back on. -->
    <DockPanel>

        <!-- On the content root, not on the window: Window.Styles/Resources stay behind with the (never shown)
             window once the module host re-parents this content into a tab. -->
        <DockPanel.Resources>
            <!-- One header for every section: caret, fixed-width title, summary hard right. The summary is why a
                 folded section is still worth having on screen. -->
            <DataTemplate x:Key="DetailSectionHeader" DataType="va:ActivitySection">
                <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="10">
                    <TextBlock Grid.Column="0" Classes="caret" Text="&#x25B6;"/>
                    <TextBlock Grid.Column="1" Classes="sectiontitle" Text="{Binding Title}"/>
                    <TextBlock Grid.Column="2" Classes="sectionsummary" Text="{Binding HeaderSummary}"/>
                </Grid>
            </DataTemplate>
        </DockPanel.Resources>

        <DockPanel.Styles>
            <Style Selector="ToggleButton.section">
                <Setter Property="ContentTemplate" Value="{StaticResource DetailSectionHeader}"/>
            </Style>
            <!-- The activity's own duration, in the same figure the run window gives the clock. -->
            <Style Selector="TextBlock.durationfigure">
                <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
                <Setter Property="Foreground" Value="{DynamicResource AccentBrightBrush}"/>
                <Setter Property="FontSize" Value="26"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Style>
            <Style Selector="TextBlock.clockmeta">
                <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
                <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
                <Setter Property="FontSize" Value="10.5"/>
                <Setter Property="TextAlignment" Value="Right"/>
            </Style>
            <Style Selector="TextBlock.clockmeta.figure">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            </Style>
            <!-- ── The money column ── one width and one font for every ISK figure in the BOUNTY section, the same
                 treatment ActivityWindow's own LOOT totals get — a row's value and the total below it land on the
                 same characters, and the total reads as a total rather than one more row of the list (ET-210 review
                 finding, 2026-09-09). -->
            <Style Selector="TextBlock.money">
                <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
                <Setter Property="Foreground" Value="{StaticResource TextBrightBrush}"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="TextAlignment" Value="Right"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style Selector="TextBlock.money.total">
                <Setter Property="Foreground" Value="{DynamicResource AccentBrightBrush}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="13"/>
            </Style>
            <Style Selector="Border.totals">
                <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="8,6"/>
                <Setter Property="Margin" Value="0,2,0,4"/>
            </Style>
            <!-- Its own class rather than "accent": the stock theme fills an accent button with the faction colour
                 and puts light text on it, which on the red and green factions falls under 4.5:1. Bright text on the
                 soft tint holds on all four. -->
            <Style Selector="Button.republish">
                <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource TextBrightBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="LetterSpacing" Value="1.2"/>
            </Style>
            <Style Selector="Button.republish:pointerover /template/ ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource BgRowHoverBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource TextBrightBrush}"/>
            </Style>
            <Style Selector="Button.republish:disabled /template/ ContentPresenter">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
            </Style>
            <!-- Understated by design (ET-214, Jithran's review of the first round) but recognisably a button
                 (his review of the second): the same shape as Button.republish above and ActivityLootView's own
                 Button.rewrite — AccentSoftBrush fill, TextBrightBrush text, a real border — so it reads as
                 clickable and belongs beside PUBLISH AGAIN and REWRITE LOOT BY HAND rather than standing out from
                 them. What sets it apart from those is only ever the hover: red border and fill instead of the
                 accent ones, the same tint Button.danger already uses. Never red at rest — the weight of the
                 decision sits in the confirmation, not in how the control looks before it is touched. -->
            <Style Selector="Button.deletebutton">
                <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource TextBrightBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="3"/>
                <Setter Property="Padding" Value="10,4"/>
                <Setter Property="MinHeight" Value="0"/>
                <Setter Property="FontSize" Value="10.5"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="LetterSpacing" Value="1"/>
                <Setter Property="HorizontalAlignment" Value="Left"/>
            </Style>
            <Style Selector="Button.deletebutton:pointerover /template/ ContentPresenter">
                <Setter Property="Background" Value="#22EF5A5A"/>
                <Setter Property="BorderBrush" Value="{StaticResource RedBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource TextBrightBrush}"/>
            </Style>
            <Style Selector="Button.deletebutton:disabled /template/ ContentPresenter">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
            </Style>
        </DockPanel.Styles>

        <!-- ══ Header ══ what this activity was, and how long it took. Hidden once deleted (ET-214): the deleted
             panel below is the whole story then, not one more place still naming a site that is gone. -->
        <Border DockPanel.Dock="Top" Padding="14,12,14,14" BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource BorderBrush}" IsVisible="{Binding !IsDeleted}">
            <StackPanel Spacing="10">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock x:Name="SiteTitle" Classes="panel-title" FontSize="13"
                                   TextWrapping="Wrap" Text="{Binding SiteText}"/>
                        <TextBlock Classes="label" Text="{Binding KindText}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Top">
                        <TextBlock Classes="clockmeta">
                            <Run Text="START "/><Run Classes="figure" Text="{Binding StartText}"/>
                        </TextBlock>
                        <TextBlock Classes="clockmeta">
                            <Run Text="END "/><Run Classes="figure" Text="{Binding EndText}"/>
                        </TextBlock>
                    </StackPanel>
                </Grid>
                <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="24">
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Classes="label" Text="DURATION"/>
                        <TextBlock x:Name="DurationFigure" Classes="durationfigure" Text="{Binding DurationText}"/>
                    </StackPanel>
                    <!-- Same prominence as DURATION beside it (ET-210 review finding, 2026-09-09): bounty, priced
                         loot and every ISK-form reward, added together — see HasTotalIsk/TotalIskText for exactly
                         what that is and, as much, what it deliberately is not. -->
                    <StackPanel Grid.Column="1" Spacing="2" IsVisible="{Binding HasTotalIsk}">
                        <TextBlock Classes="label" Text="TOTAL ISK"/>
                        <TextBlock x:Name="TotalIskFigure" Classes="durationfigure" Text="{Binding TotalIskText}"/>
                    </StackPanel>
                    <!-- The stamp is the only thing telling a typed duration from a measured one; the figure beside
                         it cannot, because a correction overwrites the moments themselves. -->
                    <Border Grid.Column="2" Classes="chip dim" HorizontalAlignment="Left" VerticalAlignment="Bottom">
                        <TextBlock x:Name="TimeSourceChip" Text="{Binding TimeSourceText}"/>
                    </Border>
                </Grid>
                <TextBlock x:Name="StatusMessage" Classes="hint" Margin="0" TextWrapping="Wrap"
                           IsVisible="{Binding StatusMessage, Converter={x:Static ObjectConverters.IsNotNull}}"
                           Text="{Binding StatusMessage}"/>
                <!-- A correction made after publishing leaves the server's copy behind (ET-215). Said here, where the
                     TOTAL ISK it changed is, and answered here too — but only ever by the pilot pressing it. -->
                <Border x:Name="PublishedCopyBehind" Classes="chip warn" HorizontalAlignment="Stretch" CornerRadius="0"
                        Padding="10,6" IsVisible="{Binding IsPublishedCopyBehind}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <TextBlock FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center"
                                   Text="{Binding PublishedCopyText}"/>
                        <Button Grid.Column="1" Classes="republish" Content="{Binding RepublishText}"
                                IsVisible="{Binding CanRepublish}" Command="{Binding RepublishCommand}"/>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <ScrollViewer HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding !IsDeleted}">
            <StackPanel>

                <ToggleButton Classes="section" Content="{Binding Activity}"
                              IsChecked="{Binding Activity.IsExpanded, Mode=TwoWay}"/>
                <Border Classes="sectionbody" IsVisible="{Binding Activity.IsExpanded}">
                    <StackPanel>
                        <Grid Classes="kv" ColumnDefinitions="Auto,*">
                            <TextBlock Text="SITE"/>
                            <TextBlock Grid.Column="1" Text="{Binding SiteText}"/>
                        </Grid>
                        <!-- Only a mission has an agent, so nothing else carries these two rows. -->
                        <Grid x:Name="AgentRow" Classes="kv" ColumnDefinitions="Auto,*" IsVisible="{Binding IsAgentShown}">
                            <TextBlock Text="AGENT"/>
                            <TextBlock Grid.Column="1" Text="{Binding AgentText}"/>
                        </Grid>
                        <Grid Classes="kv" ColumnDefinitions="Auto,*" IsVisible="{Binding IsAgentShown}">
                            <TextBlock Text="LEVEL"/>
                            <TextBlock Grid.Column="1" Text="{Binding MissionLevelText}"/>
                        </Grid>
                        <Grid Classes="kv" ColumnDefinitions="Auto,*" IsVisible="{Binding IsSignatureShown}">
                            <TextBlock Text="SIGNATURE"/>
                            <TextBlock Grid.Column="1" Text="{Binding SignatureText}"/>
                        </Grid>
                        <Grid Classes="kv" ColumnDefinitions="Auto,*">
                            <TextBlock Text="LOCATION"/>
                            <TextBlock Grid.Column="1" Text="{Binding LocationText}"/>
                        </Grid>
                        <Grid Classes="kv" ColumnDefinitions="Auto,*">
                            <TextBlock Text="FIT"/>
                            <TextBlock Grid.Column="1" Text="{Binding FitText}"/>
                        </Grid>
                        <Grid Classes="kv" ColumnDefinitions="Auto,*" IsVisible="{Binding HasObjectives}">
                            <TextBlock Text="OBJECTIVES"/>
                            <TextBlock Grid.Column="1" Text="{Binding ObjectivesText}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <StackPanel x:Name="RewardsSection" IsVisible="{Binding IsRewardsShown}">
                    <ToggleButton Classes="section" Content="{Binding Rewards}"
                                  IsChecked="{Binding Rewards.IsExpanded, Mode=TwoWay}"/>
                    <Border Classes="sectionbody" IsVisible="{Binding Rewards.IsExpanded}">
                        <StackPanel>
                            <!-- One row per form and never one total: the key list keeps growing, and LP and
                                 Evermarks have no rate to convert into ISK against. -->
                            <ItemsControl x:Name="RewardList" ItemsSource="{Binding RewardRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vr:ActivityRewardRowViewModel">
                                        <Grid Classes="kv" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                            <TextBlock Text="{Binding Label}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding ValueText}"/>
                                            <TextBlock Grid.Column="2" Classes="hint" Margin="0"
                                                       VerticalAlignment="Center" IsVisible="{Binding HasNote}"
                                                       Text="{Binding NoteText}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Classes="hint" TextWrapping="Wrap"
                                       IsVisible="{Binding RewardsEmptyText, Converter={x:Static ObjectConverters.IsNotNull}}"
                                       Text="{Binding RewardsEmptyText}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <ToggleButton Classes="section" Content="{Binding Enemies}"
                              IsChecked="{Binding Enemies.IsExpanded, Mode=TwoWay}"/>
                <Border Classes="sectionbody" IsVisible="{Binding Enemies.IsExpanded}">
                    <StackPanel>
                        <!-- One row per character, the same breakdown BOUNTY gives (ET-210 review finding,
                             2026-09-09, round 4): each toon's own gamelog counts towards its own total, summed
                             across every type it saw — which species is still in the by-type list below. -->
                        <ItemsControl x:Name="EnemyCharacterList" ItemsSource="{Binding EnemyCharacterRows}"
                                      IsVisible="{Binding HasEnemyFigures}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vr:ActivityEnemyCharacterRowViewModel">
                                    <Grid Classes="kv" ColumnDefinitions="*,Auto">
                                        <TextBlock Text="{Binding CharacterText}"/>
                                        <TextBlock Grid.Column="1" Classes="money" Text="{Binding CountText}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <!-- Set apart in its own strip rather than one more row of the list above, so the total
                             reads as a total — the same treatment BOUNTY's total gets. -->
                        <Border Classes="totals" IsVisible="{Binding HasEnemyFigures}">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Classes="label" Text="TOTAL" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Classes="money total" Text="{Binding EnemyTotalCountText}"/>
                            </Grid>
                        </Border>
                        <!-- Not folded together on type: two runs that each saw the same enemy keep their own row
                             and their own first/last window. -->
                        <ItemsControl x:Name="EnemyList" ItemsSource="{Binding EnemyRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vr:ActivityEnemyRowViewModel">
                                    <Grid Classes="kv" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                                        <TextBlock Text="{Binding EnemyName}"/>
                                        <TextBlock Grid.Column="1" Classes="hint" Margin="0"
                                                   VerticalAlignment="Center" Text="{Binding WindowText}"/>
                                        <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="{Binding CountText}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="EnemiesEmpty" Classes="hint" TextWrapping="Wrap"
                                   IsVisible="{Binding EnemiesEmptyText, Converter={x:Static ObjectConverters.IsNotNull}}"
                                   Text="{Binding EnemiesEmptyText}"/>
                    </StackPanel>
                </Border>

                <ToggleButton Classes="section" Content="{Binding Fleet}"
                              IsChecked="{Binding Fleet.IsExpanded, Mode=TwoWay}"/>
                <Border Classes="sectionbody" IsVisible="{Binding Fleet.IsExpanded}">
                    <StackPanel>
                        <Grid Classes="kv" ColumnDefinitions="Auto,*">
                            <TextBlock Text="PARTICIPANTS"/>
                            <TextBlock x:Name="ParticipantCount" Grid.Column="1" Text="{Binding ParticipantCountText}"/>
                        </Grid>
                        <ItemsControl x:Name="RunList" ItemsSource="{Binding RunRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vr:ActivityRunRowViewModel">
                                    <Grid Classes="kv" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                                        <StackPanel>
                                            <TextBlock Text="{Binding CharacterText}"
                                                       Foreground="{StaticResource TextBrightBrush}" FontSize="11.5"/>
                                            <TextBlock Classes="hint" Margin="0" Text="{Binding StandingText}"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Classes="hint" Margin="0"
                                                   VerticalAlignment="Center" Text="{Binding TimeSourceText}"/>
                                        <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="{Binding DurationText}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="FleetBasis" Classes="hint" TextWrapping="Wrap" Text="{Binding FleetBasisText}"/>
                    </StackPanel>
                </Border>

                <StackPanel x:Name="BountySection" IsVisible="{Binding IsBountyShown}">
                    <ToggleButton Classes="section" Content="{Binding Bounty}"
                                  IsChecked="{Binding Bounty.IsExpanded, Mode=TwoWay}"/>
                    <Border Classes="sectionbody" IsVisible="{Binding Bounty.IsExpanded}">
                        <StackPanel>
                            <!-- One row per character — the same breakdown FLEET already gives for participation
                                 (ET-210 review finding, 2026-09-09: a multi-character activity showed one combined
                                 figure and no way to tell who brought in what). -->
                            <ItemsControl x:Name="BountyList" ItemsSource="{Binding BountyRows}"
                                          IsVisible="{Binding HasBountyFigures}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vr:ActivityBountyRowViewModel">
                                        <Grid Classes="kv" ColumnDefinitions="*,Auto">
                                            <TextBlock Text="{Binding CharacterText}"/>
                                            <TextBlock Grid.Column="1" Classes="money" Text="{Binding IskText}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <!-- Set apart in its own strip rather than one more row of the list above, so the total
                                 reads as a total. -->
                            <Border Classes="totals" IsVisible="{Binding HasBountyFigures}">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Classes="label" Text="TOTAL" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Classes="money total" Text="{Binding BountyText}"/>
                                </Grid>
                            </Border>
                            <TextBlock x:Name="BountyEmpty" Classes="hint" TextWrapping="Wrap"
                                       IsVisible="{Binding BountyEmptyText, Converter={x:Static ObjectConverters.IsNotNull}}"
                                       Text="{Binding BountyEmptyText}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="LootSection" IsVisible="{Binding IsLootShown}">
                    <ToggleButton Classes="section" Content="{Binding Loot}"
                                  IsChecked="{Binding Loot.IsExpanded, Mode=TwoWay}"/>
                    <Border Classes="sectionbody" IsVisible="{Binding Loot.IsExpanded}">
                        <StackPanel>
                            <!-- Grouped by character and correctable after the fact (ET-215) — the same component the
                                 run window's LOOT section is, so the two read the same. -->
                            <v:ActivityLootView x:Name="LootOverview" DataContext="{Binding LootOverview}"/>
                            <TextBlock x:Name="LootEmpty" Classes="hint" TextWrapping="Wrap"
                                       IsVisible="{Binding LootEmptyText, Converter={x:Static ObjectConverters.IsNotNull}}"
                                       Text="{Binding LootEmptyText}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="EscalationSection" IsVisible="{Binding IsEscalationShown}">
                    <ToggleButton Classes="section" Content="{Binding Escalation}"
                                  IsChecked="{Binding Escalation.IsExpanded, Mode=TwoWay}"/>
                    <Border Classes="sectionbody" IsVisible="{Binding Escalation.IsExpanded}">
                        <StackPanel>
                            <Grid Classes="kv" ColumnDefinitions="Auto,*"
                                  IsVisible="{Binding EscalationText, Converter={x:Static ObjectConverters.IsNotNull}}">
                                <TextBlock Text="SITE"/>
                                <TextBlock Grid.Column="1" Text="{Binding EscalationText}"/>
                            </Grid>
                            <Grid Classes="kv" ColumnDefinitions="Auto,*"
                                  IsVisible="{Binding EscalationSystemText, Converter={x:Static ObjectConverters.IsNotNull}}">
                                <TextBlock Text="SYSTEM"/>
                                <TextBlock Grid.Column="1" Text="{Binding EscalationSystemText}"/>
                            </Grid>
                            <Grid Classes="kv" ColumnDefinitions="Auto,*"
                                  IsVisible="{Binding EscalationJumpsText, Converter={x:Static ObjectConverters.IsNotNull}}">
                                <TextBlock Text="JUMPS"/>
                                <TextBlock Grid.Column="1" Text="{Binding EscalationJumpsText}"/>
                            </Grid>
                            <TextBlock Classes="hint" TextWrapping="Wrap" Margin="0"
                                       IsVisible="{Binding EscalationJumpsEmptyText, Converter={x:Static ObjectConverters.IsNotNull}}"
                                       Text="{Binding EscalationJumpsEmptyText}"/>
                            <TextBlock Classes="hint" Margin="0"
                                       IsVisible="{Binding EscalationExpiresAtText, Converter={x:Static ObjectConverters.IsNotNull}}"
                                       Text="{Binding EscalationExpiresAtText}"/>
                            <TextBlock Classes="hint" Margin="0"
                                       IsVisible="{Binding EscalationObservedText, Converter={x:Static ObjectConverters.IsNotNull}}"
                                       Text="{Binding EscalationObservedText}"/>
                            <TextBlock x:Name="EscalationEmpty" Classes="hint" TextWrapping="Wrap"
                                       IsVisible="{Binding EscalationEmptyText, Converter={x:Static ObjectConverters.IsNotNull}}"
                                       Text="{Binding EscalationEmptyText}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ══ Why a section is not here ══ the distinguishing line of this screen. An absent section that
                     says nothing reads exactly like an empty one, and the two mean opposite things. -->
                <Border Padding="14,12" IsVisible="{Binding AbsentSectionsText, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <TextBlock x:Name="AbsentSections" Classes="hint" Margin="0" TextWrapping="Wrap"
                               Text="{Binding AbsentSectionsText}"/>
                </Border>

                <!-- ══ Delete ══ bottom of the screen, understated but a real button (ET-214, Jithran's two reviews:
                     "he doesn't need to be pushed so far to the front", then "make it clear this is clickable") —
                     hidden entirely for an activity with nothing of this machine's own in it, since a fully
                     foreign, read-only activity (ET-215) has nothing here to delete. The weight of the decision
                     sits in the confirmation this opens, not in how the control itself looks. -->
                <Border Padding="14,16" IsVisible="{Binding CanDelete}">
                    <Button x:Name="DeleteButton" Classes="deletebutton" Content="{Binding DeleteText}"
                            Command="{Binding DeleteCommand}"
                            ToolTip.Tip="Delete this activity — every run of it that is yours"/>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- ══ Deleted ══ replaces the whole screen once nothing of this activity is left to show (ET-214). A
             fleetmate's run kept alive under the same id reloads in place instead of ever reaching here — see
             ActivityDetailViewModel.DeleteAsync. -->
        <Border IsVisible="{Binding IsDeleted}">
            <StackPanel Spacing="14" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Classes="panel-title" FontSize="13" Foreground="{StaticResource TextBrightBrush}"
                           Text="{Binding DeletedMessage}"/>
                <Button x:Name="UndoDeleteButton" Classes="republish" HorizontalAlignment="Center"
                        Content="{Binding UndoDeleteText}" Command="{Binding UndoDeleteCommand}"/>
            </StackPanel>
        </Border>
    </DockPanel>
</v:ChromedWindow>
