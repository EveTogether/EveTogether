<!-- Shared by the setup wizard and the couple-to-server window (ET-425, ET-428): one look for both. -->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style Selector="TextBlock.h2">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrightBrush}"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style Selector="TextBlock.intro">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="LineHeight" Value="16"/>
        <Setter Property="Foreground" Value="{DynamicResource TextAccentBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,0,0,14"/>
    </Style>
    <Style Selector="TextBlock.small">
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="LineHeight" Value="14.5"/>
        <Setter Property="Foreground" Value="{StaticResource TextDimSmallBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style Selector="TextBlock.label">
        <Setter Property="FontSize" Value="9"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>
    <Style Selector="TextBlock.calloutTitle">
        <Setter Property="Foreground" Value="{StaticResource TextBrightBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0,0,0,3"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style Selector="Border.callout">
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1,1,1,1"/>
        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="Margin" Value="0,10"/>
    </Style>
    <Style Selector="Border.callout.err">
        <Setter Property="BorderBrush" Value="#66EF5A5A"/>
        <Setter Property="Background" Value="#14EF5A5A"/>
    </Style>
    <Style Selector="Border.callout.ok">
        <Setter Property="BorderBrush" Value="#554ADE80"/>
        <Setter Property="Background" Value="#0F4ADE80"/>
    </Style>
    <Style Selector="Border.calloutEdge">
        <Setter Property="Width" Value="3"/>
        <Setter Property="Margin" Value="-12,-10,9,-10"/>
        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
    </Style>
    <Style Selector="Border.calloutEdge.err">
        <Setter Property="Background" Value="{StaticResource RedBrush}"/>
    </Style>
    <Style Selector="Border.calloutEdge.ok">
        <Setter Property="Background" Value="{StaticResource GreenBrush}"/>
    </Style>

    <Style Selector="Border.scope.fixed">
        <Setter Property="Opacity" Value="0.75"/>
    </Style>

    <Style Selector="Border.row">
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Background" Value="{StaticResource BgRowAltBrush}"/>
    </Style>

    <Style Selector="Button.link">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="4,4"/>
        <Setter Property="Foreground" Value="{DynamicResource TextAccentBrush}"/>
    </Style>
    <Style Selector="Button.link /template/ ContentPresenter">
        <Setter Property="TextElement.FontSize" Value="11"/>
    </Style>
    <Style Selector="Button.link:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="Button.skip">
        <Setter Property="Foreground" Value="{StaticResource TextDimSmallBrush}"/>
    </Style>

    <Style Selector="Button.choice">
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment" Value="Top"/>
        <Setter Property="Padding" Value="14"/>
        <Setter Property="Background" Value="{StaticResource BgRowAltBrush}"/>
    </Style>
    <Style Selector="Button.choice.primary">
        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
    </Style>

    <Style Selector="Border.bar">
        <Setter Property="Height" Value="3"/>
        <Setter Property="Background" Value="#14FFFFFF"/>
    </Style>
    <Style Selector="Border.bar.done">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
    </Style>
    <Style Selector="Border.bar.cur">
        <Setter Property="Background" Value="{DynamicResource AccentBrightBrush}"/>
    </Style>
    <Style Selector="TextBlock.steplabel">
        <Setter Property="FontSize" Value="9"/>
        <Setter Property="LetterSpacing" Value="1.6"/>
        <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
    </Style>
    <Style Selector="TextBlock.steplabel.done">
        <Setter Property="Foreground" Value="{DynamicResource TextAccentBrush}"/>
    </Style>
    <Style Selector="TextBlock.steplabel.cur">
        <Setter Property="Foreground" Value="{StaticResource TextBrightBrush}"/>
    </Style>

    <Style Selector="Arc.spin">
        <Setter Property="RenderTransform">
            <RotateTransform/>
        </Setter>
        <Style.Animations>
            <Animation Duration="0:0:1" IterationCount="INFINITE">
                <KeyFrame Cue="0%"><Setter Property="RotateTransform.Angle" Value="0"/></KeyFrame>
                <KeyFrame Cue="100%"><Setter Property="RotateTransform.Angle" Value="360"/></KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <Style Selector="TextBlock.stepDone">
        <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
        <Setter Property="TextDecorations" Value="Strikethrough"/>
    </Style>
    <Style Selector="TextBlock.stepNow">
        <Setter Property="Foreground" Value="{StaticResource TextBrightBrush}"/>
    </Style>
</Styles>
