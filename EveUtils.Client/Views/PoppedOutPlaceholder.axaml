<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="using:EveUtils.Client.Views"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="720" d:DesignHeight="420"
             x:Class="EveUtils.Client.Views.PoppedOutPlaceholder"
             x:DataType="v:PoppedOutPlaceholderModel">

    <!-- What a popped-out tab shows while its module is in its own window (ET-111), after the map's (ET-396). -->
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420" Spacing="10">
        <mi:MaterialIcon Kind="OpenInNew" Width="28" Height="28" HorizontalAlignment="Center"
                         Foreground="{DynamicResource AccentBrightBrush}"/>
        <TextBlock x:Name="Title" Text="{Binding Heading}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"
                   TextAlignment="Center" Foreground="{StaticResource TextBrightBrush}" HorizontalAlignment="Center"/>
        <TextBlock Text="Everything stays as you left it. Close that window, or put it back here, to see it in this tab again."
                   FontSize="11.5" TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource TextBrush}"/>
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0,6,0,0">
            <Button x:Name="PutBackHereButton" Classes="accent" Content="PUT IT BACK HERE" Command="{Binding PutBackCommand}"/>
            <Button x:Name="ShowWindowButton" Content="SHOW THE WINDOW" Command="{Binding ShowWindowCommand}"/>
        </StackPanel>
    </StackPanel>
</UserControl>
