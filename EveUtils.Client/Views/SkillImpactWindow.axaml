<v:ChromedWindow xmlns="https://github.com/avaloniaui" xmlns:v="using:EveUtils.Client.Views"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vf="using:EveUtils.Client.ViewModels.FitBrowser"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1240" d:DesignHeight="860"
        x:Class="EveUtils.Client.Views.SkillImpactWindow"
        x:DataType="vf:SkillImpactViewModel"
        Width="1240" Height="860" MinWidth="900" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Title="SKILL IMPACT">

    <!-- SKILL IMPACT (ET-356/ET-357), mockup v5 "f · from a fit": a toolbar (FROM A FIT, OPTIMISE FOR chips and the
         "+ stat" menu), the main column with the three target cards, the fit warning and the combined-gain curve, and
         a 400 px right pane with the skills that move the chosen stats — drawn like the SKILLS module's panes. -->
    <v:ChromedWindow.Styles>
        <Style Selector="TextBlock.tlabel">
            <Setter Property="Foreground" Value="{DynamicResource TextAccentBrush}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="LetterSpacing" Value="1.8"/>
        </Style>
        <Style Selector="Button.fitsel">
            <Setter Property="Background" Value="#40000000"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="9,3"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrightBrush}"/>
        </Style>
        <Style Selector="Button.chipx">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="2,0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
        </Style>
        <Style Selector="Button.sadd">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,1"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBrightBrush}"/>
        </Style>
        <Style Selector="Border.tcard">
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}"/>
            <Setter Property="Background" Value="#26000000"/>
            <Setter Property="Padding" Value="10,10"/>
        </Style>
        <Style Selector="Border.tcard.rec">
            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
        </Style>
        <Style Selector="ProgressBar.pc">
            <Setter Property="Height" Value="6"/>
            <Setter Property="MinHeight" Value="6"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="1"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Background" Value="#0FFFFFFF"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBrightBrush}"/>
            <Setter Property="Opacity" Value="0.75"/>
        </Style>
        <Style Selector="ProgressBar.pc.full">
            <Setter Property="Opacity" Value="0.5"/>
        </Style>
        <Style Selector="Button.plus">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBrightBrush}"/>
        </Style>
        <Style Selector="Border.ir">
            <Setter Property="BorderThickness" Value="0,1,0,0"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}"/>
            <Setter Property="Padding" Value="6,4,6,4"/>
        </Style>
        <Style Selector="Border.ir.on">
            <Setter Property="Background" Value="{DynamicResource BgRowSelectedBrush}"/>
        </Style>
        <Style Selector="Border.irmark">
            <Setter Property="Width" Value="2"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Background" Value="{DynamicResource AccentBrightBrush}"/>
        </Style>
    </v:ChromedWindow.Styles>

    <v:ChromedWindow.Resources>
        <DataTemplate x:Key="TargetCardTemplate" x:DataType="vf:SkillTargetCardViewModel">
            <Border Classes="tcard" Classes.rec="{Binding IsRecommended}">
                <StackPanel Spacing="4">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Classes="tlabel" VerticalAlignment="Center" Text="{Binding Title}"/>
                        <Border Grid.Column="1" BorderThickness="1" BorderBrush="{StaticResource GreenBrush}" Padding="5,0"
                                IsVisible="{Binding IsRecommended}">
                            <TextBlock FontSize="9" LetterSpacing="1.2" Foreground="{StaticResource GreenBrush}" Text="RECOMMENDED"/>
                        </Border>
                    </Grid>
                    <TextBlock FontSize="10.5" Foreground="{StaticResource TextDimBrush}" MinHeight="28" TextWrapping="Wrap"
                               Text="{Binding RuleText}"/>
                    <TextBlock Classes="mono" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrightBrush}"
                               Text="{Binding TimeText}"/>
                    <TextBlock FontSize="11" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap">
                        <Run Text="{Binding DonePrefix}"/><Run Foreground="{StaticResource TextBrightBrush}" Text="{Binding DateText}"/><Run Text="{Binding DetailText}"/>
                    </TextBlock>
                    <TextBlock FontSize="11" Foreground="{StaticResource TextDimBrush}" Text="{Binding AfterCanFlyText}"
                               IsVisible="{Binding AfterCanFlyText, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                    <Border Margin="0,6,0,4" Padding="0,6,0,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DividerBrush}">
                        <StackPanel Spacing="2">
                            <TextBlock FontSize="9" LetterSpacing="1.1" Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,1"
                                       Text="% OF WHAT SKILLS CAN ADD, FROM CAN FLY"/>
                            <ItemsControl ItemsSource="{Binding StatShares}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vf:SkillTargetStatShareViewModel">
                                        <Grid ColumnDefinitions="74,84,*,36" ColumnSpacing="8" Margin="0,2">
                                            <TextBlock FontSize="11" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" Text="{Binding Label}"/>
                                            <TextBlock Grid.Column="1" Classes="mono" FontSize="11" Foreground="{StaticResource TextBrightBrush}"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center" Text="{Binding ValueText}"/>
                                            <ProgressBar Grid.Column="2" Classes="pc" Classes.full="{Binding IsFull}"
                                                         VerticalAlignment="Center" Value="{Binding Share}"/>
                                            <TextBlock Grid.Column="3" Classes="mono" FontSize="10.5" Foreground="{StaticResource TextBrush}"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center" Text="{Binding PercentText}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <ItemsControl ItemsSource="{Binding FitLines}" Margin="0,0,0,6">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vf:SkillTargetFitLineViewModel">
                                <Panel>
                                    <TextBlock FontSize="10.5" Foreground="{StaticResource GreenBrush}" Text="{Binding Text}" IsVisible="{Binding Fits}"/>
                                    <TextBlock FontSize="10.5" Foreground="{StaticResource WarnBrush}" Text="{Binding Text}" IsVisible="{Binding !Fits}"/>
                                </Panel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button HorizontalAlignment="Left" Content="ADD TO PLAN" Classes.accent="{Binding IsRecommended}"
                            IsVisible="{Binding CanAddToPlan}" Command="{Binding AddToPlanCommand}"/>
                </StackPanel>
            </Border>
        </DataTemplate>
    </v:ChromedWindow.Resources>

    <Grid ColumnDefinitions="*,400">

        <!-- Main column -->
        <DockPanel Grid.Column="0">
            <Border DockPanel.Dock="Top" Padding="14,10" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BorderBrush}">
                <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="8">
                    <TextBlock Classes="label" VerticalAlignment="Center" Text="FROM A FIT"/>
                    <Button Grid.Column="1" Classes="fitsel" VerticalAlignment="Center" Command="{Binding ChangeFitCommand}"
                            IsEnabled="{Binding CanChangeFit}" ToolTip.Tip="Pick another fit from the library; the character stays">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding ShipName}"/>
                            <TextBlock Foreground="{StaticResource TextDimBrush}" Text="▾"/>
                        </StackPanel>
                    </Button>
                    <TextBlock Grid.Column="3" Classes="label" VerticalAlignment="Center" Text="OPTIMISE FOR"/>
                    <Border Grid.Column="4" VerticalAlignment="Center" MinHeight="26" MaxWidth="460" Padding="4,2"
                            Background="#40000000" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}">
                        <WrapPanel VerticalAlignment="Center">
                            <ItemsControl ItemsSource="{Binding ChosenChips}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vf:SkillImpactStatChipViewModel">
                                        <Border Margin="0,1,4,1" Padding="7,1,3,1" Background="{DynamicResource BgRowSelectedBrush}"
                                                BorderThickness="1" BorderBrush="{DynamicResource BorderStrongBrush}">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <TextBlock FontSize="11" VerticalAlignment="Center" Foreground="{StaticResource TextBrightBrush}"
                                                           Text="{Binding Label}"/>
                                                <Button Classes="chipx" Content="×" Command="{Binding RemoveCommand}"
                                                        ToolTip.Tip="Stop optimising for this stat"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button x:Name="AddStatButton" Classes="sadd" Content="+ stat ▾" VerticalAlignment="Center">
                                <Button.Flyout>
                                    <Flyout Placement="BottomEdgeAlignedRight">
                                        <v:SkillImpactStatMenu/>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </WrapPanel>
                    </Border>
                </Grid>
            </Border>

            <ScrollViewer>
                <StackPanel>
                    <TextBlock Classes="hint" Margin="14,10,14,0" Text="Scanning every skill against this fit…" IsVisible="{Binding IsLoading}"/>
                    <TextBlock Classes="hint" Margin="14,10,14,0" Text="Computing the three targets…" IsVisible="{Binding IsLoadingTargets}"/>
                    <TextBlock Classes="hint" Margin="14,10,14,0" Foreground="{StaticResource RedBrush}" Text="{Binding TargetsErrorMessage}"
                               IsVisible="{Binding TargetsErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}"/>

                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10" Margin="14,12,14,4"
                          IsVisible="{Binding CanFlyCard, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <ContentControl Grid.Column="0" Content="{Binding CanFlyCard}" ContentTemplate="{StaticResource TargetCardTemplate}"/>
                        <ContentControl Grid.Column="1" Content="{Binding OptimalCard}" ContentTemplate="{StaticResource TargetCardTemplate}"/>
                        <ContentControl Grid.Column="2" Content="{Binding MaxCard}" ContentTemplate="{StaticResource TargetCardTemplate}"/>
                    </Grid>

                    <Panel Margin="14,8,14,0" IsVisible="{Binding FitWarningText, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <Border Background="{StaticResource WarnBrush}" Opacity="0.07"/>
                        <Border Width="3" HorizontalAlignment="Left" Background="{StaticResource WarnBrush}"/>
                        <TextBlock Margin="12,7" FontSize="11.5" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap">
                            <Run FontWeight="SemiBold" Foreground="{StaticResource TextBrightBrush}" Text="This fit does not fit at any skill level."/>
                            <Run Text="{Binding FitWarningText}"/>
                        </TextBlock>
                    </Panel>

                    <Border Margin="14,8,14,12" Padding="12,10" BorderThickness="1" BorderBrush="{DynamicResource DividerBrush}"
                            IsVisible="{Binding Curve, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <StackPanel>
                            <TextBlock Classes="tlabel" Text="{Binding Curve.Title}"/>
                            <v:SkillTargetCurveChart Height="170" Margin="0,4,0,0" Curve="{Binding Curve}"/>
                            <TextBlock Classes="hint" FontSize="11" TextWrapping="Wrap" Text="{Binding Curve.Caption}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>

        <!-- Right pane: skills that move the chosen stats -->
        <Border Grid.Column="1" BorderThickness="1,0,0,0" BorderBrush="{DynamicResource BorderBrush}">
            <DockPanel>
                <Border DockPanel.Dock="Top" Padding="16,14,16,10" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource DividerBrush}">
                    <StackPanel Spacing="3">
                        <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextBrightBrush}"
                                   Text="Skills that move the chosen stats"/>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock FontSize="11" Foreground="{StaticResource TextBrush}" Text="{Binding PaneSubText}"/>
                            <TextBlock FontSize="11" Foreground="{StaticResource TextBrush}" Text="sorted by combined gain per hour"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border DockPanel.Dock="Bottom" Padding="16,10" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DividerBrush}"
                        IsVisible="{Binding FooterText, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <TextBlock FontSize="10.5" Foreground="{StaticResource TextDimBrush}" TextWrapping="Wrap" Text="{Binding FooterText}"/>
                </Border>
                <ScrollViewer>
                    <StackPanel>
                        <Border Padding="16,10,16,12" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource DividerBrush}">
                            <StackPanel>
                                <TextBlock Classes="tlabel" Margin="0,0,0,6" Text="{Binding ChosenStatsLabel}"/>
                                <Grid ColumnDefinitions="*,48,62,16" ColumnSpacing="6" Margin="6,2,6,4">
                                    <TextBlock FontSize="9" LetterSpacing="1.1" Foreground="{StaticResource TextDimBrush}" Text="SKILL · GAIN OF THE NEXT LEVEL"/>
                                    <TextBlock Grid.Column="2" FontSize="9" LetterSpacing="1.1" Foreground="{StaticResource TextDimBrush}"
                                               HorizontalAlignment="Right" Text="TIME"/>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding Rows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vf:SkillImpactRowViewModel">
                                            <Panel>
                                                <Border Classes="ir" Classes.on="{Binding IsFirst}">
                                                    <StackPanel>
                                                        <Grid ColumnDefinitions="*,48,62,16" ColumnSpacing="6">
                                                            <TextBlock FontSize="11.5" Foreground="{StaticResource TextBrightBrush}" VerticalAlignment="Center"
                                                                       TextTrimming="CharacterEllipsis" Text="{Binding SkillName}"/>
                                                            <TextBlock Grid.Column="1" Classes="mono" FontSize="10" Foreground="{StaticResource TextBrush}"
                                                                       VerticalAlignment="Center" Text="{Binding LevelStepText}"/>
                                                            <TextBlock Grid.Column="2" Classes="mono" FontSize="10.5" Foreground="{StaticResource TextBrush}"
                                                                       HorizontalAlignment="Right" VerticalAlignment="Center" Text="{Binding NextTimeText}"/>
                                                            <Button Grid.Column="3" Classes="plus" Content="+" IsVisible="{Binding CanAddToPlan}"
                                                                    Command="{Binding AddToPlanCommand}"
                                                                    ToolTip.Tip="Add this skill to V to the plan, prerequisites included"/>
                                                        </Grid>
                                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                                            <TextBlock Classes="mono" FontSize="10" Foreground="{StaticResource TextDimBrush}"
                                                                       Text="{Binding NextGainText}"/>
                                                            <TextBlock Grid.Column="1" Classes="mono" FontSize="10" Foreground="{StaticResource TextDimBrush}"
                                                                       HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" Text="{Binding ToFiveText}"/>
                                                        </Grid>
                                                    </StackPanel>
                                                </Border>
                                                <Border Classes="irmark" IsVisible="{Binding IsFirst}"/>
                                            </Panel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        <Border Padding="16,10,16,12" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource DividerBrush}"
                                IsVisible="{Binding NotInListText, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <StackPanel Spacing="6">
                                <TextBlock Classes="tlabel" Text="NOT IN THE LIST"/>
                                <TextBlock FontSize="12" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" LineHeight="18"
                                           Text="{Binding NotInListText}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</v:ChromedWindow>
