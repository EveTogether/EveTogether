<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="80" d:DesignHeight="24"
             x:Class="EveUtils.Client.Views.OverlayChromeButtons"
             x:Name="ChromeRoot">

    <!-- The three buttons every pop-out's title bar carries, in one place so the two overlays cannot drift apart on
         what they offer or how it looks (ET-73). The square-icon styling is Button.overlaybtn in the app theme —
         these windows are windows of their own and inherit nothing from anywhere else.

         Every one of them has a tooltip: an icon on its own is quick to read once you know it and opaque before. -->
    <!-- Every icon is drawn on the SAME 16-unit canvas and scaled by the same Viewbox, so all three share one scale
         and one stroke weight. Sizing each Path to its own bounds instead would blow the two-stroke ✕ up to twice the
         pin's scale, because a Path stretches its geometry's bounding box and the X's box is far smaller. -->
    <StackPanel Orientation="Horizontal" Spacing="4">
        <StackPanel.Styles>
            <Style Selector="Viewbox.icon">
                <Setter Property="Width" Value="13"/>
                <Setter Property="Height" Value="13"/>
            </Style>
            <Style Selector="Path.icon">
                <Setter Property="StrokeThickness" Value="1.5"/>
                <Setter Property="StrokeLineCap" Value="Round"/>
                <Setter Property="StrokeJoin" Value="Round"/>
            </Style>
        </StackPanel.Styles>

        <!-- A half-filled disc: how solid the backdrop is. -->
        <Button Classes="overlaybtn" ToolTip.Tip="Overlay opacity">
            <Viewbox Classes="icon">
                <Canvas Width="16" Height="16">
                    <Path Classes="icon" Data="{StaticResource IconOpacityRing}"
                          Stroke="{Binding $parent[Button].Foreground}"/>
                    <Path Data="{StaticResource IconOpacityHalf}" Fill="{Binding $parent[Button].Foreground}"/>
                </Canvas>
            </Viewbox>
            <Button.Flyout>
                <Flyout Placement="Bottom">
                    <StackPanel Width="190" Margin="6" Spacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Classes="label" Text="OVERLAY OPACITY"/>
                            <TextBlock Grid.Column="1" Classes="mono" FontSize="11"
                                       Text="{Binding #ChromeRoot.FillOpacity, StringFormat='{}{0:P0}'}"/>
                        </Grid>
                        <!-- Bound through this control rather than reaching for the window: flyout content lives in a
                             popup, so a $parent walk out of it is not the reliable route a name in the same scope is. -->
                        <Slider Minimum="0.15" Maximum="1" SmallChange="0.05" LargeChange="0.1"
                                Value="{Binding #ChromeRoot.FillOpacity, Mode=TwoWay}"/>
                    </StackPanel>
                </Flyout>
            </Button.Flyout>
        </Button>

        <!-- A thumbtack, because that is what a pin looks like everywhere else. Whether it is ON is carried by the
             button's fill, not by the icon — see the :checked rule in the theme. -->
        <ToggleButton x:Name="PinButton" Classes="overlaybtn"
                      IsChecked="{Binding $parent[Window].Topmost, Mode=TwoWay}"
                      ToolTip.Tip="Keep this window on top of other windows">
            <Viewbox Classes="icon">
                <Canvas Width="16" Height="16">
                    <Path Classes="icon" Data="{StaticResource IconPin}"
                          Stroke="{Binding $parent[ToggleButton].Foreground}"/>
                </Canvas>
            </Viewbox>
        </ToggleButton>

        <Button x:Name="CloseButton" Classes="overlaybtn overlayclose"
                Click="OnClose" ToolTip.Tip="Close this overlay">
            <Viewbox Classes="icon">
                <Canvas Width="16" Height="16">
                    <Path Classes="icon" Data="{StaticResource IconClose}"
                          Stroke="{Binding $parent[Button].Foreground}"/>
                </Canvas>
            </Viewbox>
        </Button>
    </StackPanel>
</UserControl>
