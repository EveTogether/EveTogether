<v:OverlayWindow xmlns="https://github.com/avaloniaui" xmlns:v="using:EveUtils.Client.Views"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:va="using:EveUtils.Client.ViewModels.Activity"
        xmlns:vr="using:EveUtils.Client.ViewModels.Runs"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="560" d:DesignHeight="560"
        x:Class="EveUtils.Client.Views.ActivityWindow"
        x:DataType="va:ActivityWindowViewModel"
        x:Name="OverlayRoot"
        Title="Activity"
        Icon="/Assets/eve-together.ico"
        Width="560" Height="560" MinWidth="420" MinHeight="220"
        Topmost="True" ShowInTaskbar="True"
        WindowDecorations="None"
        WindowStartupLocation="CenterScreen"
        TransparencyLevelHint="Transparent"
        Background="Transparent">

    <Border x:Name="Backdrop" Classes="panel">
      <DockPanel>
        <!-- Resources and styles on the content, not on the window: a style declared on a Window is the thing that
             silently goes missing here (ET-30/ET-43), and this window inherits nothing from the shell that opened it.

             Every colour below is a resource key, never a literal. The window derives from OverlayWindow, which —
             unlike ChromedWindow — does not bind its own brushes to resource observables, so DynamicResource on the
             faction-swappable keys is the only thing that re-tints this window when the faction changes. -->
        <DockPanel.Resources>
            <!-- One header for all six sections: caret, fixed-width title, and the summary hard right. The summary
                 is why a folded section is still worth having on screen. -->
            <DataTemplate x:Key="SectionHeader" DataType="va:ActivitySection">
                <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="10">
                    <TextBlock Grid.Column="0" Classes="caret" Text="&#x25B6;"/>
                    <TextBlock Grid.Column="1" Classes="sectiontitle" Text="{Binding Title}"/>
                    <TextBlock Grid.Column="2" Classes="sectionsummary" Text="{Binding HeaderSummary}"/>
                </Grid>
            </DataTemplate>
        </DockPanel.Resources>

        <DockPanel.Styles>
            <!-- ── The clock ── the largest thing in the window, because the only number that matters in an abyssal
                 pocket is how long you have left. Amber at five minutes, red at two: both still enough time to go. -->
            <Style Selector="TextBlock.clockfigure">
                <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
                <Setter Property="Foreground" Value="{DynamicResource AccentBrightBrush}"/>
                <Setter Property="FontSize" Value="30"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Style>
            <Style Selector="TextBlock.clockfigure.warn">
                <Setter Property="Foreground" Value="{StaticResource ValueBrush}"/>
            </Style>
            <Style Selector="TextBlock.clockfigure.crit">
                <Setter Property="Foreground" Value="{StaticResource RedBrush}"/>
            </Style>
            <Style Selector="TextBlock.clockmeta">
                <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
                <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
                <Setter Property="FontSize" Value="10.5"/>
                <Setter Property="TextAlignment" Value="Right"/>
            </Style>
            <Style Selector="TextBlock.clockmeta.figure">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            </Style>

            <!-- ── A section header ── a flat full-width row, not a button that looks like one: the whole line is the
                 hit target, and nothing about it should read as an action to take. -->
            <Style Selector="ToggleButton.section">
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                <Setter Property="CornerRadius" Value="0"/>
                <Setter Property="Padding" Value="14,9"/>
                <Setter Property="ContentTemplate" Value="{StaticResource SectionHeader}"/>
            </Style>
            <!-- State ink goes on the presenter: the stock Fluent theme sets its own there for :pointerover and
                 :checked, and a rule one level up loses to it (the lesson Button.overlaybtn is carrying). -->
            <Style Selector="ToggleButton.section:pointerover /template/ ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource BgRowHoverBrush}"/>
            </Style>
            <Style Selector="ToggleButton.section:checked /template/ ContentPresenter">
                <Setter Property="Background" Value="Transparent"/>
            </Style>
            <Style Selector="ToggleButton.section:checked:pointerover /template/ ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource BgRowHoverBrush}"/>
            </Style>

            <Style Selector="TextBlock.caret">
                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                <Setter Property="FontSize" Value="9"/>
                <Setter Property="Width" Value="9"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="RenderTransform" Value="none"/>
            </Style>
            <Style Selector="ToggleButton.section:checked TextBlock.caret">
                <Setter Property="RenderTransform" Value="rotate(90deg)"/>
            </Style>
            <Style Selector="TextBlock.sectiontitle">
                <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
                <Setter Property="FontSize" Value="10"/>
                <Setter Property="LetterSpacing" Value="1.8"/>
                <Setter Property="Width" Value="96"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style Selector="TextBlock.sectionsummary">
                <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
                <Setter Property="Foreground" Value="{StaticResource TextBrightBrush}"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="TextAlignment" Value="Right"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <!-- ── A section body ── indented under the title column so an open section reads as belonging to the
                 header above it rather than as a new block. -->
            <Style Selector="Border.sectionbody">
                <Setter Property="Background" Value="{StaticResource BgRowBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                <Setter Property="Padding" Value="37,2,14,13"/>
            </Style>

            <!-- ── A key/value line ── the label carries the letterspacing, the value carries the ink. -->
            <!-- ColumnDefinitions is not a styled property, so the two columns stay on each Grid; everything else
                 about a key/value line lives here. -->
            <Style Selector="Grid.kv">
                <Setter Property="Margin" Value="0,3"/>
            </Style>
            <Style Selector="Grid.kv > TextBlock:nth-child(1)">
                <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
                <Setter Property="FontSize" Value="10"/>
                <Setter Property="LetterSpacing" Value="1.8"/>
            </Style>
            <Style Selector="Grid.kv > TextBlock:nth-child(2)">
                <Setter Property="Foreground" Value="{StaticResource TextBrightBrush}"/>
                <Setter Property="FontSize" Value="11.5"/>
                <Setter Property="TextAlignment" Value="Right"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>

            <!-- ── The hint under a section ── where the window says what it does NOT know, and why. Half the reason
                 this window exists is that it refuses to fill a field it cannot source. -->
            <Style Selector="TextBlock.hint">
                <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
                <Setter Property="FontSize" Value="9.5"/>
                <Setter Property="LineHeight" Value="14"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="Margin" Value="0,6,0,0"/>
            </Style>

            <!-- ── The weather / tier picker ── quiet until pressed: twelve buttons that shout would be the loudest
                 thing in a window whose point is a countdown. -->
            <Style Selector="Button.pick">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="0"/>
                <Setter Property="Padding" Value="9,4"/>
                <Setter Property="FontSize" Value="10.5"/>
                <Setter Property="Margin" Value="0,0,4,4"/>
            </Style>
            <Style Selector="Button.pick:pointerover /template/ ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource BgRowHoverBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource TextBrightBrush}"/>
            </Style>
            <!-- The run controls: one width and one spacing for all four, so the row reads as a row rather than as
                 four buttons that happen to sit near each other. -->
            <Style Selector="Button.pick.run">
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="Margin" Value="0"/>
                <Setter Property="Padding" Value="9,5"/>
                <Setter Property="LetterSpacing" Value="1.2"/>
            </Style>
            <Style Selector="Button.pick.danger">
                <Setter Property="Foreground" Value="{StaticResource RedBrush}"/>
            </Style>
            <Style Selector="Button.pick.danger:pointerover /template/ ContentPresenter">
                <Setter Property="BorderBrush" Value="{StaticResource RedBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource RedBrush}"/>
            </Style>
            <!-- ── A link ── for the one thing in a row that opens something instead of setting it. Accent-coloured
                 and underlined so it reads as clickable without a border or a plate, which in a key/value row would
                 look like a control you can type into. -->
            <Style Selector="Button.link">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Margin" Value="0"/>
                <Setter Property="MinHeight" Value="0"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Foreground" Value="{DynamicResource AccentBrightBrush}"/>
                <Setter Property="Cursor" Value="Hand"/>
            </Style>
            <Style Selector="Button.link /template/ ContentPresenter">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="TextBlock.TextDecorations" Value="Underline"/>
            </Style>
            <Style Selector="Button.link:pointerover /template/ ContentPresenter">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            </Style>

            <!-- ── The money column ── one width and one font for every amount in the LOOT section, so a row's value,
                 a capture's subtotal and the totals strip all land on the same characters. Monospaced is what lines
                 the decimals up; a proportional font puts every row's comma somewhere else. -->
            <Style Selector="TextBlock.money">
                <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
                <Setter Property="Foreground" Value="{StaticResource TextBrightBrush}"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="TextAlignment" Value="Right"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <!-- An item name is the value of its row, not a label of it — so it may not borrow Grid.kv's first
                 column, which is letterspaced and dimmed for the label it expects to find there. -->
            <Style Selector="TextBlock.item">
                <Setter Property="Foreground" Value="{StaticResource TextBrightBrush}"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            </Style>
            <Style Selector="TextBlock.money.net">
                <Setter Property="Foreground" Value="{DynamicResource AccentBrightBrush}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Style>
            <!-- ── The totals strip ── the three figures as one block rather than three key/value rows that happen to
                 follow each other, because what a pilot compares is LOOT against CONSUMED. -->
            <Style Selector="Border.totals">
                <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="8,6"/>
                <Setter Property="Margin" Value="0,2,0,4"/>
            </Style>

            <!-- ── A capture that does not count ── still there, still readable, in dimmed ink with its subtotal
                 struck through. Declared after .money so it wins: Avalonia takes the last matching style, and the
                 whole point of these two rules is to overrule the ink above. -->
            <Style Selector="Border.excluded TextBlock">
                <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
            </Style>
            <Style Selector="Border.excluded TextBlock.money">
                <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
                <Setter Property="TextDecorations" Value="Strikethrough"/>
            </Style>

            <!-- ── A link that opens something instead of setting it, in the one place that has to stay pressed:
                 a capture's own rows, shown as they came in. Same ink as Button.link above, which it cannot borrow —
                 a style selector names one control type. -->
            <Style Selector="ToggleButton.link">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Margin" Value="0"/>
                <Setter Property="MinHeight" Value="0"/>
                <Setter Property="FontSize" Value="9.5"/>
                <Setter Property="Foreground" Value="{DynamicResource AccentBrightBrush}"/>
                <Setter Property="Cursor" Value="Hand"/>
            </Style>
            <Style Selector="ToggleButton.link /template/ ContentPresenter">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
            </Style>
            <Style Selector="ToggleButton.link:checked /template/ ContentPresenter">
                <Setter Property="Background" Value="Transparent"/>
            </Style>

            <!-- ── The enemy stepper ── a row control, not a form field. The theme sizes a NumericUpDown like a text
                 box, which beside a 10.5pt enemy name put chevrons taller than every button in this window (ET-115).
                 Sized against Button.pick above, which is what the rest of the window is made of. -->
            <Style Selector="NumericUpDown.count">
                <Setter Property="MinHeight" Value="0"/>
                <Setter Property="FontSize" Value="10.5"/>
            </Style>
            <Style Selector="NumericUpDown.count /template/ TextBox">
                <Setter Property="MinHeight" Value="0"/>
                <Setter Property="Padding" Value="6,2"/>
            </Style>
            <Style Selector="NumericUpDown.count /template/ ButtonSpinner">
                <Setter Property="MinHeight" Value="0"/>
                <Setter Property="Padding" Value="0"/>
            </Style>
            <!-- Two arrows, not two buttons (Raymond, 2026-09-02). No border, no plate, nothing but the glyph in
                 the window's brightest text — thirteen enemy rows under each other is a list, and a list does not
                 want twenty-six little frames in it. The padding is the only thing left with any size: it keeps the
                 pointer target usable around a glyph that carries no chrome of its own to aim at. -->
            <Style Selector="NumericUpDown.count /template/ ButtonSpinner /template/ RepeatButton">
                <Setter Property="MinHeight" Value="0"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="Padding" Value="5,2"/>
                <Setter Property="FontSize" Value="8"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Foreground" Value="{StaticResource TextBrightBrush}"/>
            </Style>
            <!-- The plate the stock Fluent theme paints lives on the presenter, so a rule one level up loses to it —
                 the same lesson ToggleButton.section above is already carrying. -->
            <Style Selector="NumericUpDown.count /template/ ButtonSpinner /template/ RepeatButton /template/ ContentPresenter">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="CornerRadius" Value="0"/>
            </Style>
            <!-- Hover and press are the arrow itself brightening, since there is no longer a plate to tint. -->
            <Style Selector="NumericUpDown.count /template/ ButtonSpinner /template/ RepeatButton:pointerover /template/ ContentPresenter">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource AccentBrightBrush}"/>
            </Style>
            <Style Selector="NumericUpDown.count /template/ ButtonSpinner /template/ RepeatButton:pressed /template/ ContentPresenter">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            </Style>
            <Style Selector="Button.pick.on /template/ ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource AccentBrightBrush}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Style>

            <!-- ── The character column ── the same hex the main window's character list draws, at the size a
                 switcher can afford. Only the fill differs between the three cases; the shape never does. -->
            <Style Selector="Border.charcolumn">
                <Setter Property="Width" Value="56"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                <Setter Property="BorderThickness" Value="0,0,1,0"/>
            </Style>
            <Style Selector="Button.charhex">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="CornerRadius" Value="0"/>
                <Setter Property="Padding" Value="0,7"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
            </Style>
            <Style Selector="Button.charhex:pointerover /template/ ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource BgRowHoverBrush}"/>
            </Style>
            <Style Selector="Button.charhex.on /template/ ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
            </Style>
            <!-- A toon with nothing on the clock dims whole — ring and fill together, so it reads as resting
                 rather than as a signal of its own. -->
            <Style Selector="Button.charhex.resting Panel.charhexart">
                <Setter Property="Opacity" Value="0.42"/>
            </Style>

            <Style Selector="Path.charring">
                <Setter Property="Fill" Value="{DynamicResource HexBrandBrush}"/>
            </Style>
            <Style Selector="Path.charring.warn">
                <Setter Property="Fill" Value="{StaticResource ValueBrush}"/>
            </Style>
            <Style Selector="Path.charring.crit">
                <Setter Property="Fill" Value="{StaticResource RedBrush}"/>
            </Style>
            <!-- No ESI link is not a faction colour: the ring goes neutral so the hatching is what stands out. -->
            <Style Selector="Path.charring.unlinked">
                <Setter Property="Fill" Value="{StaticResource TextDimBrush}"/>
            </Style>

            <!-- The dot repeats the ring's colour rather than adding a second signal. -->
            <Style Selector="Ellipse.chardot">
                <Setter Property="Fill" Value="{StaticResource ValueBrush}"/>
            </Style>
            <Style Selector="Ellipse.chardot.crit">
                <Setter Property="Fill" Value="{StaticResource RedBrush}"/>
            </Style>

            <Style Selector="TextBlock.charinitials">
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="{DynamicResource AccentBrightBrush}"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style Selector="TextBlock.charinitials.unlinked">
                <Setter Property="Foreground" Value="{StaticResource TextBrightBrush}"/>
            </Style>
        </DockPanel.Styles>

        <!-- ══ Header ══ the run, what is known about it, and the three chrome buttons every pop-out carries. -->
        <Border Classes="panel-header" DockPanel.Dock="Top" x:Name="DragHandle" PointerPressed="OnHeaderPressed">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="9">
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Classes="diamond" Text="&#x25C6;" Margin="0,0,6,0"/>
                    <TextBlock Classes="panel-title" Text="{Binding HeaderTitle}" VerticalAlignment="Center"/>
                </StackPanel>

                <WrapPanel Grid.Column="1" VerticalAlignment="Center" ItemSpacing="5" LineSpacing="4">
                    <!-- Whose run this is, first in the row and before anything about the site: with several toons
                         running their own sites at once this is the only thing telling two windows apart, and even
                         with one it was the question the window never answered (Raymond, 2026-09-02). -->
                    <Border Classes="chip" Classes.ok="{Binding HasActingCharacter}"
                            Classes.warn="{Binding !HasActingCharacter}"
                            ToolTip.Tip="The character this run is filed under">
                        <TextBlock Text="{Binding ActingCharacterText}"/>
                    </Border>
                    <Border Classes="chip ok" IsVisible="{Binding HasWeatherAndTier}">
                        <TextBlock Text="{Binding TierText}"/>
                    </Border>
                    <Border Classes="chip ok" IsVisible="{Binding HasWeatherAndTier}">
                        <TextBlock Text="{Binding Weather.Name}"/>
                    </Border>
                    <!-- Not set is a state the header owns, not a blank: the clock does not wait on it, so the only
                         thing left to do is say it is missing. -->
                    <Border Classes="chip warn" IsVisible="{Binding NeedsWeatherAndTier}"
                            ToolTip.Tip="Neither weather nor tier can be detected — set them in the ACTIVITY section">
                        <TextBlock Text="SET TIER + WEATHER"/>
                    </Border>
                    <Border Classes="chip dim" IsVisible="{Binding IsFleetShown}">
                        <TextBlock Text="{Binding FleetStatusText}"/>
                    </Border>
                    <Border Classes="chip dim">
                        <TextBlock Text="{Binding RunOriginText}"/>
                    </Border>
                </WrapPanel>

                <v:OverlayChromeButtons Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Top"
                                        FillOpacity="{Binding #OverlayRoot.FillOpacity, Mode=TwoWay}"/>
            </Grid>
        </Border>

        <!-- ══ The character column ══ (ET-164) which of my toons this window is on. Docked before the clock so it
             runs the full height beside it, and every row is the same template: the pilot without an ESI link is
             one of the six and not a branch around them. -->
        <Border DockPanel.Dock="Left" Classes="charcolumn" IsVisible="{Binding HasRunCharacters}">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="RunCharacterColumn" ItemsSource="{Binding RunCharacters}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="va:RunCharacterRowViewModel">
                            <Button Classes="charhex"
                                    Classes.on="{Binding IsSelected}"
                                    Classes.resting="{Binding IsResting}"
                                    ToolTip.Tip="{Binding Tooltip}"
                                    Command="{Binding $parent[ItemsControl].((va:ActivityWindowViewModel)DataContext).SelectRunCharacterCommand}"
                                    CommandParameter="{Binding}">
                                <Panel Classes="charhexart" Width="40" Height="44">
                                    <Path Classes="charring"
                                          Classes.warn="{Binding IsWarning}"
                                          Classes.crit="{Binding IsCritical}"
                                          Classes.unlinked="{Binding ShowsUnlinked}"
                                          Data="M20,0 L40,11 L40,33 L20,44 L0,33 L0,11 Z"/>
                                    <Panel Width="35" Height="39" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Panel.Clip>
                                            <PathGeometry Figures="M17.5,0 L35,9.75 L35,29.25 L17.5,39 L0,29.25 L0,9.75 Z"/>
                                        </Panel.Clip>
                                        <!-- The ring is a ring, not a tint: without this plate a red or amber ring
                                             floods the whole hex through the translucent fills above it, which is
                                             the one option Raymond struck off — it makes the face unreadable. -->
                                        <Border Background="{StaticResource BgPanelBrush}"/>
                                        <!-- No ESI link: hatched, with the initials. Its own form, because there is
                                             no portrait to be had here with images on OR off — unlike the glyph
                                             below, which is a render that did not arrive. -->
                                        <Panel IsVisible="{Binding ShowsUnlinked}">
                                            <Border Background="{StaticResource BgRowAltBrush}"/>
                                            <!-- Stretch=None: the default fits the geometry to the panel, which
                                                 squashes five diagonals into one solid block. -->
                                            <Path Stretch="None" Opacity="0.45"
                                                  Stroke="{StaticResource TextDimBrush}" StrokeThickness="5"
                                                  Data="M-24,39 L15,0 M-12,39 L27,0 M0,39 L39,0 M12,39 L51,0 M24,39 L63,0"/>
                                            <TextBlock Classes="charinitials unlinked" Text="{Binding Initials}"/>
                                        </Panel>
                                        <!-- Linked, but no render: images off, offline, or a fetch that failed. -->
                                        <Border Background="{DynamicResource AccentSoftBrush}" IsVisible="{Binding ShowsGlyph}">
                                            <TextBlock Classes="charinitials" Text="{Binding Initials}"/>
                                        </Border>
                                        <Image Source="{Binding Portrait}" Stretch="UniformToFill"
                                               IsVisible="{Binding ShowsPortrait}"/>
                                    </Panel>
                                    <!-- On the flat right side, where it stays findable over a light portrait. -->
                                    <Ellipse Classes="chardot" Classes.crit="{Binding IsCritical}"
                                             IsVisible="{Binding HasAttentionDot}"
                                             Width="7" Height="7" Margin="0,0,-1,0"
                                             HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Panel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- ══ The clock ══ the envelope as what it is: two moments and the time between them. A per-member bar chart
             stood here and came out — the starts sit seconds apart on a twenty-minute axis, so the bars overlapped
             into one and said nothing. -->
        <Border DockPanel.Dock="Top" Padding="14,13,14,15" BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource BorderBrush}">
            <StackPanel Spacing="12">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Classes="label" Text="{Binding ClockLabel}"/>
                        <TextBlock x:Name="ClockFigure" Classes="clockfigure"
                                   Classes.warn="{Binding IsClockWarning}"
                                   Classes.crit="{Binding IsClockCritical}"
                                   Text="{Binding ClockText}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Bottom">
                        <TextBlock Classes="clockmeta">
                            <Run Text="START "/><Run Classes="figure" Text="{Binding StartText}"/>
                        </TextBlock>
                        <TextBlock Classes="clockmeta">
                            <Run Text="END "/><Run Classes="figure" Text="{Binding EndText}"/>
                        </TextBlock>
                    </StackPanel>
                </Grid>

                <!-- ══ The run controls ══ fixed cells, so the block never moves under the pointer when the run
                     changes state. START and STOP share the first cell and are never both on: they are the same
                     slot seen from two sides. The gap after it is the group boundary — what is left of the row
                     ends the run rather than steering it, and the last of those is destructive. -->
                <Grid ColumnDefinitions="98,20,98,98" ColumnSpacing="6" HorizontalAlignment="Right">
                    <Button x:Name="StartRunButton" Grid.Column="0" Classes="pick run" Content="START"
                            IsVisible="{Binding IsStartButtonVisible}" Command="{Binding StartRunCommand}"/>
                    <Button x:Name="StopRunButton" Grid.Column="0" Classes="pick run" Content="STOP"
                            IsVisible="{Binding IsStopButtonVisible}" Command="{Binding StopRunCommand}"/>
                    <!-- The same cell again: a copy only ever waits on a stopped run, so START and STOP are both
                         off. The hint under the clock says what KEEP drops, which four letters cannot. -->
                    <Button x:Name="KeepRunButton" Grid.Column="0" Classes="pick run" Content="KEEP"
                            IsVisible="{Binding IsKeepRunButtonVisible}" Command="{Binding KeepRunCommand}"/>
                    <Button x:Name="SaveRunButton" Grid.Column="2" Classes="pick run" Content="SAVE"
                            IsVisible="{Binding IsSaveButtonVisible}" Command="{Binding SaveRunCommand}"/>
                    <!-- Discarding ends the run on every member's machine, so it confirms first (see the command). -->
                    <Button x:Name="DiscardRunButton" Grid.Column="3" Classes="pick run danger" Content="DISCARD"
                            IsVisible="{Binding IsDiscardButtonVisible}" Command="{Binding DiscardRunCommand}"/>
                </Grid>
                <!-- ══ Correcting the clock ══ (ET-98) manual START/STOP is the only source a site run has, so the
                     half-minute you were late pressing it is part of every stored duration until it is taken back
                     out. Only on a stopped run, and only before SAVE — after that the row is committed. -->
                <StackPanel x:Name="TimeCorrection" Spacing="6" IsVisible="{Binding IsTimeCorrectionShown}">
                    <TextBlock Classes="hint" Margin="0" Text="{Binding TimeSourceText}"/>
                    <Grid ColumnDefinitions="Auto,90,Auto,90,Auto" ColumnSpacing="6">
                        <TextBlock Classes="label" VerticalAlignment="Center" Text="START"/>
                        <TextBox x:Name="StartCorrectionBox" Grid.Column="1"
                                 Text="{Binding StartCorrectionText, Mode=TwoWay}"/>
                        <TextBlock Grid.Column="2" Classes="label" VerticalAlignment="Center" Text="END"/>
                        <TextBox x:Name="EndCorrectionBox" Grid.Column="3"
                                 Text="{Binding EndCorrectionText, Mode=TwoWay}"/>
                        <Button x:Name="ApplyTimeCorrectionButton" Grid.Column="4" Classes="pick"
                                Content="correct" Command="{Binding ApplyTimeCorrectionCommand}"/>
                    </Grid>
                    <!-- A refused correction says what was wrong with it; it is never straightened out silently. -->
                    <TextBlock x:Name="TimeCorrectionError" Classes="hint" Margin="0" TextWrapping="Wrap"
                               IsVisible="{Binding HasTimeCorrectionError}" Text="{Binding TimeCorrectionError}"/>
                </StackPanel>
                <!-- Why the window is still here after SAVE. The toast is gone in seconds; this is not. -->
                <TextBlock x:Name="RunNoticeText" Classes="hint" Margin="0" TextWrapping="Wrap"
                           IsVisible="{Binding HasRunNotice}" Text="{Binding RunNoticeText}"/>
                <TextBlock Classes="hint" Margin="0" Text="{Binding ClockHint}"/>
                <!-- Why there are no run controls, when there are none. An unknown fleet boss is a state, not
                     silence — the same rule as ET-65 AC-7. -->
                <TextBlock x:Name="CommandStatusText" Classes="hint" Margin="0"
                           IsVisible="{Binding IsCommandStatusShown}" Text="{Binding CommandStatusText}"/>
                <!-- Why this run has no fleet while the pilot has several. Going solo used to be silent, and that
                     silence is the whole of ET-165. -->
                <TextBlock x:Name="FleetNoticeText" Classes="hint" Margin="0" TextWrapping="Wrap"
                           IsVisible="{Binding HasFleetNotice}" Text="{Binding FleetNoticeText}"/>
            </StackPanel>
        </Border>

        <!-- ══ The six sections ══ each says something with its body shut, so folding the window down never costs
             the reader the answer — only the detail behind it. -->
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <StackPanel>

                <ToggleButton Classes="section" Content="{Binding Activity}"
                              IsChecked="{Binding Activity.IsExpanded, Mode=TwoWay}"/>
                <Border Classes="sectionbody" IsVisible="{Binding Activity.IsExpanded}">
                    <StackPanel>
                        <StackPanel IsVisible="{Binding IsAbyssal}">
                            <Grid Classes="kv" ColumnDefinitions="Auto,*" IsVisible="{Binding HasWeatherAndTier}">
                                <TextBlock Text="WEATHER"/>
                                <TextBlock Grid.Column="1" Text="{Binding WeatherEnvironmentText}"/>
                            </Grid>
                            <Grid Classes="kv" ColumnDefinitions="Auto,*" IsVisible="{Binding HasWeatherAndTier}">
                                <TextBlock Text="EFFECT"/>
                                <TextBlock Grid.Column="1" Text="{Binding WeatherEffectText}"/>
                            </Grid>
                            <Grid Classes="kv" ColumnDefinitions="Auto,*" IsVisible="{Binding HasWeatherAndTier}">
                                <TextBlock Text="TIER"/>
                                <TextBlock Grid.Column="1" Text="{Binding TierText}"/>
                            </Grid>
                        </StackPanel>

                        <!-- Only what the site itself demands. A row that could only ever read "not known yet" is
                             not shown at all: the reader learns nothing from our catalogue's shape. -->
                        <StackPanel IsVisible="{Binding !IsAbyssal}">
                            <Grid Classes="kv" ColumnDefinitions="Auto,*" IsVisible="{Binding HasSignature}">
                                <TextBlock Text="TYPE"/>
                                <TextBlock Grid.Column="1" Text="{Binding SignatureTypeText}"/>
                            </Grid>
                            <Grid Classes="kv" ColumnDefinitions="Auto,*" IsVisible="{Binding HasSignature}">
                                <TextBlock Text="SITE"/>
                                <TextBlock Grid.Column="1" Text="{Binding SignatureSiteText}"/>
                            </Grid>
                            <!-- The hull list is behind this, not in the section: thirty-odd names over five lines
                                 pushed LOCATION and LOOT STRATEGY off the bottom. The SITE line above still carries
                                 "ship-restricted" itself, so the FACT of the restriction is never hidden — and it
                                 stays visible even for a restricted site whose allow-list resolves to nothing,
                                 which is exactly the case that has no list to open. -->
                            <Grid Classes="kv" ColumnDefinitions="Auto,*" IsVisible="{Binding HasShipRestriction}">
                                <TextBlock Text=""/>
                                <Button Grid.Column="1" Classes="link" Content="which ships may enter?"
                                        HorizontalAlignment="Left"
                                        Command="{Binding ShowShipRestrictionCommand}"/>
                            </Grid>
                            <!-- ET-125: the pilot's own moment to register, not an automatic detection — ET-124
                                 measured that neither the SDE, ESI nor the gamelog knows an escalation happened. -->
                            <Grid Classes="kv" ColumnDefinitions="Auto,*" IsVisible="{Binding IsEscalationRegistrationShown}">
                                <TextBlock Text=""/>
                                <Button Grid.Column="1" Classes="link" Content="register escalation"
                                        HorizontalAlignment="Left"
                                        Command="{Binding RegisterEscalationCommand}"/>
                            </Grid>
                            <TextBlock Text="{Binding EscalationRegisteredText}"
                                       IsVisible="{Binding EscalationRegisteredText, Converter={x:Static ObjectConverters.IsNotNull}}"
                                       Classes="hint" Margin="0"/>
                        </StackPanel>

                        <Grid Classes="kv" ColumnDefinitions="Auto,*" IsVisible="{Binding IsLocationShown}">
                            <TextBlock Text="LOCATION"/>
                            <TextBlock Grid.Column="1" Text="{Binding LocationText}"/>
                        </Grid>
                        <!-- Set, not reported: the label is what makes the duration readable, so the row it sits on
                             is the row you answer it with. -->
                        <Grid Classes="kv" ColumnDefinitions="Auto,*" IsVisible="{Binding IsLootStrategyShown}">
                            <TextBlock Text="LOOT STRATEGY" VerticalAlignment="Center"/>
                            <ItemsControl Grid.Column="1" HorizontalAlignment="Right"
                                          ItemsSource="{Binding LootStrategyChoices}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel HorizontalAlignment="Right"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="va:ActivityChoice">
                                        <Button Classes="pick" Classes.on="{Binding IsSelected}"
                                                Content="{Binding Label}"
                                                Command="{Binding $parent[ItemsControl].((va:ActivityWindowViewModel)DataContext).SelectLootStrategyCommand}"
                                                CommandParameter="{Binding Index}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>

                        <!-- ── The manual entry ── the only field in this window the user fills in, because nothing
                             can detect it. Answered, it folds behind one line: twelve buttons standing open under a
                             question nobody is asking any more would be the loudest thing in the section. -->
                        <StackPanel IsVisible="{Binding IsAbyssal}">
                        <Button Classes="pick" Content="change tier / weather" HorizontalAlignment="Left"
                                Margin="0,8,0,0"
                                IsVisible="{Binding !IsPickerShown}"
                                Command="{Binding OpenPickerCommand}"/>

                        <StackPanel IsVisible="{Binding IsPickerShown}" Margin="0,8,0,0">
                            <TextBlock Classes="label" Text="WEATHER" Margin="0,0,0,4"/>
                            <ItemsControl ItemsSource="{Binding WeatherChoices}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="va:ActivityChoice">
                                        <Button Classes="pick" Classes.on="{Binding IsSelected}"
                                                Content="{Binding Label}" ToolTip.Tip="{Binding Tooltip}"
                                                Command="{Binding $parent[ItemsControl].((va:ActivityWindowViewModel)DataContext).SelectWeatherCommand}"
                                                CommandParameter="{Binding Index}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Classes="label" Text="TIER" Margin="0,4,0,4"/>
                            <ItemsControl ItemsSource="{Binding TierChoices}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="va:ActivityChoice">
                                        <Button Classes="pick" Classes.on="{Binding IsSelected}"
                                                Content="{Binding Label}"
                                                Command="{Binding $parent[ItemsControl].((va:ActivityWindowViewModel)DataContext).SelectTierCommand}"
                                                CommandParameter="{Binding Index}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Button Classes="pick" Content="clear" HorizontalAlignment="Left"
                                    IsVisible="{Binding HasWeatherAndTier}"
                                    Command="{Binding ClearWeatherAndTierCommand}"/>
                        </StackPanel>

                        <!-- Kept where the four notes went: without it the EFFECT row reads as two numbers rather
                             than as the band one of them will be. -->
                        <TextBlock Classes="hint"
                                   Text="The resist penalty is rolled per site, so it is shown as the band it can land in."/>
                        </StackPanel>

                    </StackPanel>
                </Border>

                <!-- Its own section, folded by default: a site's worth of rats inside ACTIVITY pushed FIT, FLEET,
                     BOUNTY and LOOT under the fold. The count is typed after the fight, so the rows outlive STOP. -->
                <ToggleButton Classes="section" Content="{Binding Enemies}"
                              IsChecked="{Binding Enemies.IsExpanded, Mode=TwoWay}"/>
                <Border Classes="sectionbody" IsVisible="{Binding Enemies.IsExpanded}">
                    <ItemsControl x:Name="EnemyList" ItemsSource="{Binding EnemyObservations}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="va:RunEnemyObservationViewModel">
                                <Grid Classes="kv" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                    <TextBlock Text="{Binding EnemyName}" VerticalAlignment="Center"/>
                                    <!-- Seen is not counted, and only a counted row is saved (ET-106) — the row has
                                         to say which of the two it is. -->
                                    <TextBlock Grid.Column="1" Classes="hint" Margin="0" VerticalAlignment="Center"
                                               Text="{Binding CountStateText}"/>
                                    <NumericUpDown Grid.Column="2" Classes="count" Width="72" Minimum="0" Maximum="999" Increment="1"
                                                   FormatString="0" Value="{Binding Count, Mode=TwoWay}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <ToggleButton Classes="section" Content="{Binding Fit}"
                              IsChecked="{Binding Fit.IsExpanded, Mode=TwoWay}"/>
                <Border Classes="sectionbody" IsVisible="{Binding Fit.IsExpanded}">
                    <StackPanel Spacing="6">
                        <TextBlock Classes="hint" Margin="0" Text="{Binding FitText}"/>
                        <TextBlock Classes="hint" Margin="0" Text="{Binding FitVelocityText}"/>
                        <TextBlock Classes="hint" Margin="0" Text="{Binding FitWarpSpeedText}"/>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Button Classes="pick" Content="choose fit" Command="{Binding ChooseFitCommand}"/>
                            <!-- Only offered once there is a fit to take off; unlinking nothing is not a state. -->
                            <Button Classes="pick" Content="detach fit" Command="{Binding DetachFitCommand}"
                                    IsVisible="{Binding HasFit}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Gone rather than empty when no fleet has ever reported in: a FLEET section standing open on a solo
                     run reads as a measurement, and nothing here can measure the absence of a fleet. -->
                <StackPanel x:Name="FleetSection" IsVisible="{Binding IsFleetShown}">
                <ToggleButton Classes="section" Content="{Binding Fleet}"
                              IsChecked="{Binding Fleet.IsExpanded, Mode=TwoWay}"/>
                <Border Classes="sectionbody" IsVisible="{Binding Fleet.IsExpanded}">
                    <StackPanel>
                        <!-- Who this window has heard from, one row per shared location (ET-98). Not a roster: a
                             member who does not share their location is in the fleet and not in this list, which is
                             what the caption under it says rather than leaving the reader to count. -->
                        <ItemsControl x:Name="FleetMemberList" ItemsSource="{Binding FleetMembers}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="va:ActivityFleetMemberViewModel">
                                    <Grid Classes="kv" ColumnDefinitions="*,Auto">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}"/>
                                            <TextBlock Classes="hint" Margin="0" Text="{Binding IskText}"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Classes="hint" Margin="0"
                                                   VerticalAlignment="Center" Text="{Binding LocationText}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <!-- Directly under the names it adds up, and above the caption that says the list is not the
                             roster: a total standing anywhere else would have to explain what it covers. -->
                        <Grid x:Name="FleetTotalRow" Classes="kv" ColumnDefinitions="Auto,*"
                              IsVisible="{Binding IsFleetTotalShown}">
                            <TextBlock Text="fleet total"/>
                            <TextBlock Grid.Column="1" Margin="8,0,0,0" HorizontalAlignment="Right"
                                       VerticalAlignment="Center" Text="{Binding FleetTotalText}"/>
                        </Grid>
                        <TextBlock x:Name="FleetBasisText" Classes="hint" Margin="0" TextWrapping="Wrap"
                                   Text="{Binding FleetBasisText}"/>
                        <!-- Two columns because they are two facts: who flew the site, and who takes a share of it.
                             A pilot can be the first without the second — the hauler who fetched ore (ET-105). -->
                        <ItemsControl ItemsSource="{Binding Participants}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vr:RunParticipantViewModel">
                                    <Grid Classes="kv" ColumnDefinitions="*,Auto,Auto">
                                        <StackPanel>
                                            <TextBlock Text="{Binding CharacterName}"/>
                                            <TextBlock Classes="hint" Margin="0" Text="{Binding StandingText}"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                                   Text="{Binding PayoutDisplay}"/>
                                        <CheckBox Grid.Column="2" Margin="8,0,0,0" Content="share"
                                                  IsChecked="{Binding IsPayoutEligible, Mode=TwoWay}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Classes="hint" Margin="0" TextWrapping="Wrap"
                                   IsVisible="{Binding Participants.Count}"
                                   Text="{Binding PayoutExpectationLabel}"/>
                    </StackPanel>
                </Border>
                </StackPanel>

                <ToggleButton Classes="section" Content="{Binding Bounty}"
                              IsChecked="{Binding Bounty.IsExpanded, Mode=TwoWay}"/>
                <Border Classes="sectionbody" IsVisible="{Binding Bounty.IsExpanded}">
                    <StackPanel>
                        <Grid Classes="kv" ColumnDefinitions="Auto,*">
                            <TextBlock Text="OWN CHARACTER"/>
                            <TextBlock Grid.Column="1" Text="{Binding BountyText}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <ToggleButton Classes="section" Content="{Binding Loot}"
                              IsChecked="{Binding Loot.IsExpanded, Mode=TwoWay}"/>
                <Border Classes="sectionbody" IsVisible="{Binding Loot.IsExpanded}">
                    <StackPanel>
                        <!-- One strip, on the same money column as every amount under it, so the total a row belongs
                             to is straight above it. NET carries the accent because it is the figure the run is
                             judged on; LOOT and CONSUMED are what it is made of. -->
                        <Border Classes="totals">
                            <StackPanel Spacing="3">
                                <Grid ColumnDefinitions="*,104">
                                    <TextBlock Classes="label" Text="LOOT" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Classes="money" Text="{Binding RunLoot.LootIskDisplay}"/>
                                </Grid>
                                <Grid ColumnDefinitions="*,104">
                                    <TextBlock Classes="label" Text="CONSUMED" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Classes="money" Text="{Binding RunLoot.ConsumedIskDisplay}"/>
                                </Grid>
                                <Grid ColumnDefinitions="*,104">
                                    <TextBlock Classes="label" Text="NET" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Classes="money net" Text="{Binding RunLoot.NetIskDisplay}"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <!-- The caption names where these figures come from. It has to, and it has to be right: it read
                             "the clipboard column" long after the copied ISK stopped being kept at all. -->
                        <TextBlock Classes="hint" Text="{Binding IskLabel}"/>
                        <!-- A capture that arrived after the pilot wrote his list out, said beside the totals it just
                             moved. Loot that came in and does not count is the one mistake he would never see. -->
                        <TextBlock Classes="hint" Margin="0" Text="{Binding RunLoot.AddedAfterEditNote}"/>
                        <!-- Which two captures the figures are the difference between — in BOTH ways of working, so
                             someone back on the clipboard way who sees an unexpected total can read why in one
                             glance, and reach the control that decides it: the starting-hold list below. -->
                        <TextBlock Classes="hint" Margin="0" Text="{Binding RunLoot.DifferenceText}"/>
                        <TextBlock Classes="hint" Margin="0" Text="{Binding RunLoot.RunStatusMessage}"/>

                        <!-- Set where it applies, like LOOT STRATEGY above, and per kind for the same reason. It
                             decides which controls are on screen and never what the run is worth. -->
                        <Grid Classes="kv" ColumnDefinitions="Auto,*" IsVisible="{Binding !RunLoot.IsLocked}">
                            <TextBlock Text="REGISTRATION" VerticalAlignment="Center"/>
                            <ItemsControl Grid.Column="1" HorizontalAlignment="Right" ItemsSource="{Binding LootModeChoices}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel HorizontalAlignment="Right"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="va:ActivityChoice">
                                        <Button Classes="pick" Classes.on="{Binding IsSelected}"
                                                Content="{Binding Label}"
                                                Command="{Binding $parent[ItemsControl].((va:ActivityWindowViewModel)DataContext).SelectLootModeCommand}"
                                                CommandParameter="{Binding Index}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>

                        <!-- The two holds. Only in the way that uses them, and only while the run is open: a saved
                             section carries no controls at all. -->
                        <StackPanel Spacing="4" IsVisible="{Binding RunLoot.IsCargoDiffShown}">
                            <StackPanel Spacing="4" IsVisible="{Binding !RunLoot.IsLocked}">
                                <!-- One place to say which capture the run started from. Two starting holds stay
                                     impossible because SetRunLootCaptureRoleCommand takes the role off whoever had
                                     it in the same write — this list is the shape of the question, not the guard. -->
                                <Grid Classes="kv" ColumnDefinitions="Auto,*">
                                    <TextBlock Text="STARTS FROM" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1" HorizontalAlignment="Right" MinWidth="200"
                                              PlaceholderText="no starting hold — every capture counts"
                                              ItemsSource="{Binding RunLoot.Captures}"
                                              SelectedItem="{Binding RunLoot.CargoBeforeCapture, Mode=TwoWay}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate DataType="vr:RunLootCaptureRowViewModel">
                                                <TextBlock Text="{Binding PickerText}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Grid>
                                <TextBlock Classes="hint" Margin="0" Text="STARTING HOLD"/>
                                <TextBox AcceptsReturn="True" MinHeight="54" TextWrapping="NoWrap"
                                         PlaceholderText="Paste your cargo hold — Ctrl+A, Ctrl+C in the inventory window."
                                         Text="{Binding RunLoot.CargoBeforeText, Mode=TwoWay}"/>
                                <TextBlock Classes="hint" Margin="0" Text="{Binding RunLoot.CargoBeforeStatus}"/>
                                <TextBlock Classes="hint" Margin="0" Text="ENDING HOLD"/>
                                <TextBox AcceptsReturn="True" MinHeight="54" TextWrapping="NoWrap"
                                         PlaceholderText="Leave this empty and the last capture is the ending hold."
                                         Text="{Binding RunLoot.CargoAfterText, Mode=TwoWay}"/>
                                <TextBlock Classes="hint" Margin="0" Text="{Binding RunLoot.CargoAfterStatus}"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- An editable section says until when; a fixed one says it is fixed. Never nothing. -->
                        <TextBlock Classes="hint" Text="{Binding RunLoot.EditableUntilText}"/>

                        <!-- ── The loot ── one list of the rows that count, whichever way they were registered, and
                             not a stack per capture: if the text is the loot, the loot is one list. -->
                        <Grid Classes="kv" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                            <TextBlock Text="LOOT" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Classes="hint" Margin="0" HorizontalAlignment="Right"
                                       VerticalAlignment="Center" Text="{Binding RunLoot.ManualListCaption}"/>
                            <Button Grid.Column="2" Classes="link" Content="edit as text"
                                    IsVisible="{Binding RunLoot.CanEditLoot}"
                                    Command="{Binding RunLoot.BeginLootEditCommand}"/>
                        </Grid>

                        <!-- Editing is replacement, not a correction script: what is in the box is what the loot
                             becomes. The list it opens on is the list as it counts right now, in the form EVE itself
                             copies, so a row can be pasted straight in from the game beside the ones already there. -->
                        <StackPanel Spacing="4" IsVisible="{Binding RunLoot.IsEditingLoot}">
                            <TextBox AcceptsReturn="True" MinHeight="90" TextWrapping="NoWrap"
                                     FontFamily="{StaticResource MonoFont}"
                                     PlaceholderText="Name, tab, quantity — one row per line."
                                     Text="{Binding RunLoot.LootText, Mode=TwoWay}"/>
                            <!-- A row that cannot be read greys "done" and says why, rather than being thrown away
                                 without the pilot who typed it ever finding out. -->
                            <TextBlock Classes="hint" Margin="0" Text="{Binding RunLoot.LootTextRefusal}"/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Classes="pick" Content="done"
                                        IsEnabled="{Binding RunLoot.CanFinishLootEdit}"
                                        Command="{Binding RunLoot.FinishLootEditCommand}"/>
                                <Button Classes="link" Content="back to the captures"
                                        Command="{Binding RunLoot.CancelLootEditCommand}"/>
                            </StackPanel>
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding RunLoot.CountedLines}"
                                      IsVisible="{Binding !RunLoot.IsEditingLoot}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vr:ActivityLootLineViewModel">
                                    <!-- The money column keeps its width whatever else is on the row, so every amount
                                         in this section lands on the same characters. Spent is its own word rather
                                         than loot with a minus in front of it, which is LootKind's own reading. -->
                                    <Grid ColumnDefinitions="*,Auto,52,104" ColumnSpacing="8" Margin="0,2">
                                        <TextBlock Classes="item" Text="{Binding Name}"/>
                                        <TextBlock Grid.Column="1" Classes="label" VerticalAlignment="Center"
                                                   Text="SPENT" IsVisible="{Binding IsLost}"/>
                                        <TextBlock Grid.Column="2" Classes="money" Text="{Binding QuantityText}"/>
                                        <TextBlock Grid.Column="3" Classes="money" Text="{Binding ValueText}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- ── The captures underneath ── every one of them, counted or not, with its own subtotal.
                             That is what makes a correction readable back: #3 goes on saying two rows came in worth
                             75.090,00 while the list above keeps 19.600,00 of it, and the difference is the edit. -->
                        <ItemsControl ItemsSource="{Binding RunLoot.Captures}" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vr:RunLootCaptureRowViewModel">
                                    <Border Classes.excluded="{Binding IsExcluded}" Padding="0,2">
                                        <StackPanel>
                                            <Grid ColumnDefinitions="Auto,*,104" ColumnSpacing="8">
                                                <TextBlock Classes="label" Text="{Binding NumberDisplay}"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Classes="label" VerticalAlignment="Center"
                                                           Text="{Binding SourceText}"/>
                                                <TextBlock Grid.Column="2" Classes="money"
                                                           Text="{Binding SubtotalDisplay}"/>
                                            </Grid>
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" Margin="0,1,0,0">
                                                <ToggleButton Classes="link" Content="{Binding LineCountText}"
                                                              IsChecked="{Binding IsExpanded, Mode=TwoWay}"/>
                                                <TextBlock Grid.Column="1" Classes="hint" Margin="0"
                                                           Text="{Binding RoleText}"/>
                                                <TextBlock Grid.Column="2" Classes="hint" Margin="0"
                                                           Text="DOES NOT COUNT" IsVisible="{Binding IsExcluded}"/>
                                            </Grid>
                                            <TextBlock Classes="hint" Margin="0" Text="ADDED BELOW THE LIST"
                                                       IsVisible="{Binding IsAddedAfterEdit}"/>
                                            <!-- A repeat is the one exclusion worth arguing with — he really did loot
                                                 the same thing twice. Every other one is his own edit, and the way
                                                 back from an edit is to edit again. -->
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                <TextBlock Classes="hint" Margin="0" Text="{Binding RepeatOfDisplay}"/>
                                                <Button Grid.Column="1" Classes="link" Content="add it anyway"
                                                        IsVisible="{Binding CanReinclude}"
                                                        Command="{Binding $parent[ItemsControl].((va:ActivityWindowViewModel)DataContext).RunLoot.ReincludeCaptureCommand}"
                                                        CommandParameter="{Binding}"/>
                                            </Grid>
                                            <!-- Its rows as they came in, read-only: the proof the correction can be
                                                 read back against. -->
                                            <ItemsControl ItemsSource="{Binding Entries}" IsVisible="{Binding IsExpanded}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid ColumnDefinitions="*,52,104" ColumnSpacing="8">
                                                            <TextBlock Classes="hint" Margin="0" Text="{Binding Name}"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Grid.Column="1" Classes="hint" Margin="0"
                                                                       TextAlignment="Right" Text="{Binding Quantity}"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>
</v:OverlayWindow>
