<v:ChromedWindow xmlns="https://github.com/avaloniaui" xmlns:v="using:EveUtils.Client.Views"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:EveUtils.Client.ViewModels"
        xmlns:sys="using:System"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1180" d:DesignHeight="760"
        x:Class="EveUtils.Client.Views.SettingsSyncWindow"
        x:DataType="vm:SettingsSyncViewModel"
        x:Name="SyncRoot"
        Width="1180" Height="760"
        WindowStartupLocation="CenterOwner"
        Title="EVE Settings Sync">

    <DockPanel Margin="14" x:Name="SyncRootPanel">

        <!-- On the content root, not on the window: the module host re-parents this content into the main window's
             tab when docked, and Window.Styles would stay behind with the (never shown) window. -->
        <DockPanel.Styles>
            <!-- The outcome line borders red when part of a copy did not land. -->
            <Style Selector="Border.statusline">
                <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
            </Style>
            <Style Selector="Border.statusline.failed">
                <Setter Property="BorderBrush" Value="{StaticResource RedBrush}"/>
            </Style>

            <!-- One file per line, compact enough that a profile with a dozen pilots reads without scrolling. -->
            <Style Selector="Border.filerow">
                <Setter Property="Background" Value="{StaticResource BgRowBrush}"/>
                <Setter Property="Padding" Value="8,0"/>
                <Setter Property="Margin" Value="0,0,0,2"/>
                <Setter Property="Height" Value="26"/>
            </Style>
            <Style Selector="Border.filerow TextBlock.stamp">
                <Setter Property="FontSize" Value="10"/>
                <Setter Property="Opacity" Value="0.6"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style Selector="TextBlock.blockhint">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Opacity" Value="0.7"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="Foreground" Value="{StaticResource TextBrightBrush}"/>
            </Style>
            <!-- The id beside a name: there to check which file you have, deliberately quieter than the name. -->
            <Style Selector="TextBlock.rowid">
                <Setter Property="FontSize" Value="10"/>
                <Setter Property="Opacity" Value="0.45"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Foreground" Value="{StaticResource TextBrightBrush}"/>
            </Style>
            <!-- Short host (the docked tab is a good 130px shorter than this tool's own window): the standing
                 explanations give their room back to the file lists. Their text stays on the titles' tooltips. -->
            <Style Selector="DockPanel.compact TextBlock.intro">
                <Setter Property="IsVisible" Value="False"/>
            </Style>
            <Style Selector="DockPanel.compact TextBlock.blockhint">
                <Setter Property="IsVisible" Value="False"/>
            </Style>
            <Style Selector="TextBlock.empty">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Opacity" Value="0.5"/>
                <Setter Property="Margin" Value="2,10"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>
        </DockPanel.Styles>

        <!-- Header: what this tool does, said once, before anything is clicked. -->
        <StackPanel DockPanel.Dock="Top" Spacing="2" Margin="0,0,0,10">
            <TextBlock Text="EVE SETTINGS SYNC" FontWeight="Bold" FontSize="15"
                       Foreground="{StaticResource TextBrightBrush}"/>
            <TextBlock Classes="intro" FontSize="11" Foreground="{DynamicResource TextAccentBrush}" TextWrapping="Wrap"
                       Text="Copy one character's window layout, overview and tabs onto your other characters — or one account's settings onto your other accounts. The two never mix, and the whole profile is backed up before every copy."/>
        </StackPanel>

        <!-- Running clients: the one thing that makes a sync pointless. Blocks rather than warns. -->
        <Border DockPanel.Dock="Top" IsVisible="{Binding ClientsRunning}" Margin="0,0,0,10" Padding="12,8"
                Background="#33CC4444" BorderBrush="{StaticResource RedBrush}" BorderThickness="1">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <TextBlock Grid.Column="0" Text="⚠" FontSize="15" VerticalAlignment="Center"
                           Foreground="{StaticResource RedBrush}"/>
                <TextBlock Grid.Column="1" Text="{Binding ClientWarning}" Margin="10,0" TextWrapping="Wrap"
                           FontSize="12" VerticalAlignment="Center" Foreground="{StaticResource TextBrightBrush}"/>
                <Button Grid.Column="2" Content="CHECK AGAIN" FontSize="10" VerticalAlignment="Center"
                        Command="{Binding CheckClientsCommand}"/>
            </Grid>
        </Border>

        <!-- Where the settings live. Two lines so it survives the docked shell's narrower host: the folder never
             squeezes the profile picker out of view, and the profile is never implicit — several settings_*
             profiles side by side is normal, and picking the wrong one is how you overwrite the wrong thing. -->
        <Border DockPanel.Dock="Top" Classes="panel" Padding="11,9" Margin="0,0,0,10">
            <Grid RowDefinitions="Auto,6,Auto" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="7">
                <TextBlock Grid.Row="0" Grid.Column="0" Classes="label" Text="EVE FOLDER" VerticalAlignment="Center"/>
                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding InstallRoot}" FontSize="11"
                         VerticalContentAlignment="Center" MinWidth="180"
                         PlaceholderText="The folder that holds the settings_* directories"
                         ToolTip.Tip="Normally %LOCALAPPDATA%\CCP\EVE\&lt;install&gt;. Detected automatically on Windows; point at it yourself if nothing was found."/>
                <Button Grid.Row="0" Grid.Column="2" Content="BROWSE…" FontSize="10" Click="OnBrowse"/>
                <Button Grid.Row="0" Grid.Column="3" Content="RELOAD" FontSize="10"
                        Command="{Binding ReloadProfilesCommand}"
                        ToolTip.Tip="Re-read the folder — EVE rewrites these files whenever a client closes."/>

                <TextBlock Grid.Row="2" Grid.Column="0" Classes="label" Text="PROFILE" VerticalAlignment="Center"/>
                <ComboBox Grid.Row="2" Grid.Column="1" HorizontalAlignment="Left" MinWidth="220" FontSize="11"
                          ItemsSource="{Binding ProfileNames}" SelectedItem="{Binding SelectedProfileName}"/>
                <TextBlock Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2" Text="{Binding ProfileSummary}"
                           VerticalAlignment="Center" FontSize="11" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextAccentBrush}"/>
            </Grid>
        </Border>

        <!-- Outcome line: what was copied, what was not, where the backup went. -->
        <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto" ColumnSpacing="10" Margin="0,10,0,0">
            <Border Grid.Column="0" Padding="11,7" Classes="statusline"
                    Classes.failed="{Binding StatusIsError}" Background="#22000000" BorderThickness="1">
                <StackPanel Spacing="5">
                    <TextBlock Text="{Binding Status}" FontSize="11" TextWrapping="Wrap"
                               Foreground="{StaticResource TextBrightBrush}"/>
                    <!-- Backing up a whole profile is a noticeable wait; without a sign of it the button looks
                         broken and gets pressed again. -->
                    <StackPanel Spacing="4" IsVisible="{Binding IsBusy}">
                        <TextBlock Text="{Binding BusyMessage}" FontSize="11" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextAccentBrush}"/>
                        <ProgressBar IsIndeterminate="True" Height="4"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Button Grid.Column="1" Content="Close" Click="OnClose" VerticalAlignment="Center"/>
        </Grid>

        <!-- Body: the two sync blocks share the height evenly and each list scrolls on its own, so both blocks stay
             visible at once however short the host is. -->
        <Grid x:Name="SyncBodyGrid" ColumnDefinitions="*,12,340" RowDefinitions="*">

            <!-- ── The two sync blocks. Deliberately stacked and separately labelled rather than two tabs that look
                 alike: mistaking one for the other is the mistake this screen must not allow. Nothing else lives in
                 this column: docked, the two file lists are down to about two rows each, and anything added here
                 comes straight out of them. ── -->
            <Grid x:Name="SyncColumn" Grid.Column="0" RowDefinitions="*,10,*">

                <Border Grid.Row="0" Classes="panel" Padding="11,9">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Spacing="5" Margin="0,0,0,6">
                            <!-- The tick-all buttons ride on the title row rather than owning one of their own: a
                                 whole row for two buttons and a label the preview line already explains costs the
                                 file list an entry, and the list is what this screen is for. -->
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="6">
                                <TextBlock Grid.Column="0" Classes="diamond" Text="◆" Margin="0,0,6,0"/>
                                <TextBlock Grid.Column="1" Classes="panel-title" Text="CHARACTER SETTINGS"
                                           VerticalAlignment="Center"
                                           ToolTip.Tip="Per character: window layout, overview settings, tabs. Applies to that pilot only."/>
                                <Button Grid.Column="2" Content="TICK ALL" FontSize="10"
                                        Command="{Binding SelectAllCharactersCommand}"
                                        ToolTip.Tip="Tick every character below as a target"/>
                                <Button Grid.Column="3" Content="NONE" FontSize="10"
                                        Command="{Binding ClearCharactersCommand}"
                                        ToolTip.Tip="Untick every character below"/>
                            </Grid>
                            <TextBlock Classes="blockhint"
                                       Text="Per character: window layout, overview settings, tabs. Applies to that pilot only."/>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="7">
                                <TextBlock Grid.Column="0" Classes="label" Text="COPY FROM" VerticalAlignment="Center"/>
                                <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" FontSize="11"
                                          ItemsSource="{Binding Characters}" SelectedItem="{Binding CharacterSource}"
                                          PlaceholderText="Pick the character to copy from">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:SettingsFileRowViewModel">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{Binding DisplayName}"/>
                                                <TextBlock Text="{Binding LastModifiedDisplay}" Opacity="0.6"
                                                           FontSize="10" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>
                        </StackPanel>

                        <!-- Preview + action: what this button is about to do, in names, before it does it. -->
                        <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto" Margin="0,7,0,0" ColumnSpacing="10">
                            <TextBlock Grid.Column="0" Text="{Binding CharacterPlanSummary}" FontSize="11"
                                       TextWrapping="Wrap" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextAccentBrush}"/>
                            <Button Grid.Column="1" Classes="accent" Content="COPY CHARACTER SETTINGS…"
                                    FontSize="11" VerticalAlignment="Center"
                                    IsEnabled="{Binding CanSyncCharacters}"
                                    Command="{Binding SyncCharactersCommand}"
                                    ToolTip.Tip="Asks for confirmation first, backs the profile up, then overwrites the ticked characters."/>
                        </Grid>

                        <ScrollViewer>
                            <Panel>
                                <TextBlock Classes="empty" IsVisible="{Binding !Characters.Count}"
                                           Text="No character settings in this profile."/>
                                <ItemsControl ItemsSource="{Binding Characters}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:SettingsFileRowViewModel">
                                            <Border Classes="filerow">
                                                <Grid ColumnDefinitions="Auto,*,Auto,Auto,60">
                                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsTarget}"
                                                              IsEnabled="{Binding CanBeTarget}" Margin="0,0,4,0"
                                                              MinHeight="0" MinWidth="0" Padding="0"/>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                                                                VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding DisplayName}" FontSize="12"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Foreground="{StaticResource TextBrightBrush}"/>
                                                        <TextBlock Classes="rowid" Text="{Binding IdDisplay}" IsVisible="{Binding ShowId}"/>
                                                    </StackPanel>
                                                    <Border Grid.Column="2" Classes="chip ok" Margin="6,0"
                                                            VerticalAlignment="Center" IsVisible="{Binding IsSource}">
                                                        <TextBlock Text="SOURCE"/>
                                                    </Border>
                                                    <TextBlock Grid.Column="3" Classes="stamp"
                                                               Text="{Binding LastModifiedDisplay}"
                                                               ToolTip.Tip="When EVE last wrote this file"/>
                                                    <TextBlock Grid.Column="4" Classes="stamp" Opacity="0.45"
                                                               Text="{Binding SizeDisplay}" HorizontalAlignment="Right"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Panel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <Border Grid.Row="2" Classes="panel" Padding="11,9">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Spacing="5" Margin="0,0,0,6">
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="6">
                                <TextBlock Grid.Column="0" Classes="diamond" Text="◆" Margin="0,0,6,0"/>
                                <TextBlock Grid.Column="1" Classes="panel-title" Text="ACCOUNT SETTINGS"
                                           VerticalAlignment="Center"
                                           ToolTip.Tip="Per account: applies to every character on that login. EVE publishes no account names — name them yourself and EVE Together remembers."/>
                                <Button Grid.Column="2" Content="TICK ALL" FontSize="10"
                                        Command="{Binding SelectAllAccountsCommand}"
                                        ToolTip.Tip="Tick every account below as a target"/>
                                <Button Grid.Column="3" Content="NONE" FontSize="10"
                                        Command="{Binding ClearAccountsCommand}"
                                        ToolTip.Tip="Untick every account below"/>
                            </Grid>
                            <TextBlock Classes="blockhint"
                                       Text="Per account: applies to every character on that login. EVE publishes no account names — name them yourself and EVE Together remembers."/>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="7">
                                <TextBlock Grid.Column="0" Classes="label" Text="COPY FROM" VerticalAlignment="Center"/>
                                <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" FontSize="11"
                                          ItemsSource="{Binding Accounts}" SelectedItem="{Binding AccountSource}"
                                          PlaceholderText="Pick the account to copy from">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:SettingsFileRowViewModel">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{Binding DisplayName}"/>
                                                <TextBlock Text="{Binding LastModifiedDisplay}" Opacity="0.6"
                                                           FontSize="10" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>
                        </StackPanel>

                        <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto" Margin="0,7,0,0" ColumnSpacing="10">
                            <TextBlock Grid.Column="0" Text="{Binding AccountPlanSummary}" FontSize="11"
                                       TextWrapping="Wrap" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextAccentBrush}"/>
                            <Button Grid.Column="1" Classes="accent" Content="COPY ACCOUNT SETTINGS…"
                                    FontSize="11" VerticalAlignment="Center"
                                    IsEnabled="{Binding CanSyncAccounts}"
                                    Command="{Binding SyncAccountsCommand}"
                                    ToolTip.Tip="Asks for confirmation first, backs the profile up, then overwrites the ticked accounts."/>
                        </Grid>

                        <ScrollViewer>
                            <Panel>
                                <TextBlock Classes="empty" IsVisible="{Binding !Accounts.Count}"
                                           Text="No account settings in this profile."/>
                                <ItemsControl ItemsSource="{Binding Accounts}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:SettingsFileRowViewModel">
                                            <Border Classes="filerow">
                                                <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto,60">
                                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsTarget}"
                                                              IsEnabled="{Binding CanBeTarget}" Margin="0,0,4,0"
                                                              MinHeight="0" MinWidth="0" Padding="0"/>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <TextBlock Text="{Binding DisplayName}" FontSize="12"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       Foreground="{StaticResource TextBrightBrush}"/>
                                                            <TextBlock Classes="rowid" Text="{Binding IdDisplay}" IsVisible="{Binding ShowId}"/>
                                                        </StackPanel>
                                                        <!-- Which characters are on this account (ET-64): worked out
                                                             from EVE's write times across every profile, or said by
                                                             the user. It says which of the two it is. -->
                                                        <TextBlock Text="{Binding HintDisplay}" FontSize="10"
                                                                   Opacity="0.55" IsVisible="{Binding HasHint}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   ToolTip.Tip="{Binding HintTooltip}"/>
                                                    </StackPanel>
                                                    <!-- Accented while nothing is known about this account: that is
                                                         the row the user cannot place, and this is the way to. -->
                                                    <Button Grid.Column="2" Content="CHARS…" FontSize="10" Padding="6,1"
                                                            Margin="6,0,0,0" VerticalAlignment="Center"
                                                            Classes.accent="{Binding NeedsLink}"
                                                            Command="{Binding #SyncRoot.((vm:SettingsSyncViewModel)DataContext).LinkAccountCharactersCommand}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip.Tip="Say which characters are on this account. EVE publishes this nowhere, so it is worked out from when it wrote the files — and what you say here outranks that."/>
                                                    <Button Grid.Column="3" Content="NAME…" FontSize="10" Padding="6,1"
                                                            Margin="4,0" VerticalAlignment="Center"
                                                            Command="{Binding #SyncRoot.((vm:SettingsSyncViewModel)DataContext).NameAccountCommand}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip.Tip="Give this account a name you recognise. Remembered on this machine."/>
                                                    <Border Grid.Column="4" Classes="chip ok" Margin="0,0,6,0"
                                                            VerticalAlignment="Center" IsVisible="{Binding IsSource}">
                                                        <TextBlock Text="SOURCE"/>
                                                    </Border>
                                                    <TextBlock Grid.Column="5" Classes="stamp"
                                                               Text="{Binding LastModifiedDisplay}"
                                                               ToolTip.Tip="When EVE last wrote this file"/>
                                                    <TextBlock Grid.Column="6" Classes="stamp" Opacity="0.45"
                                                               Text="{Binding SizeDisplay}" HorizontalAlignment="Right"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Panel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

            </Grid>

            <!-- ── Backups: taken automatically before every copy, and on demand. A backup you cannot put back is
                 only a feeling, so restore lives here beside the list. Presets sit under them: a preset is the same
                 snapshot, made portable. ── -->
            <!-- The standing things, in their own column: the snapshots, the file you carry to another PC, and the
                 rule that repeats a copy by itself. All three are content-sized and stack from the top — none of
                 them is a place to work, so none of them takes room it does not need. The scroller is insurance:
                 three panels of prose in a narrow column must never be able to clip a button off the bottom, which
                 is exactly how this screen went wrong twice before. -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid RowDefinitions="Auto,8,Auto,8,Auto">
            <!-- Only what this screen needs to say about backups: that they are being taken, when the last one was,
                 and the two doors out — take one now, or go and read them. Working with a backup happens in the
                 backups window, where a whole profile's contents actually fit on screen (ET-67). -->
            <Border x:Name="BackupsPanel" Grid.Row="0" Classes="panel" Padding="11,9">
                <StackPanel Spacing="5">
                    <Grid ColumnDefinitions="Auto,*">
                        <TextBlock Grid.Column="0" Classes="diamond" Text="◆" Margin="0,0,6,0"/>
                        <TextBlock Grid.Column="1" Classes="panel-title" Text="BACKUPS" VerticalAlignment="Center"
                                   ToolTip.Tip="A full copy of the profile is taken before every copy, every restore and every preset import — always, not as an option."/>
                    </Grid>
                    <TextBlock Classes="blockhint"
                               Text="A full copy of the profile is taken before every sync — always, not as an option."/>
                    <TextBlock Text="{Binding LastBackupDisplay}" FontSize="11" TextWrapping="Wrap" MaxLines="2"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextAccentBrush}"/>

                    <ItemsControl ItemsSource="{Binding RecentBackups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SettingsBackupRowViewModel">
                                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,2">
                                    <TextBlock Grid.Column="0" Text="{Binding TakenAtDisplay}" FontSize="10"
                                               Opacity="0.7"/>
                                    <TextBlock Grid.Column="1" Text="{Binding ReasonDisplay}" FontSize="10"
                                               Opacity="0.5" TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                        <Button Grid.Column="0" Content="BACK UP NOW" FontSize="10" HorizontalAlignment="Stretch"
                                IsEnabled="{Binding CanBackup}" Command="{Binding BackupNowCommand}"
                                ToolTip.Tip="Takes a full snapshot of this profile right now — every character and every account in it."/>
                        <Button Grid.Column="1" Content="VIEW / RESTORE…" FontSize="10" HorizontalAlignment="Stretch"
                                Command="{Binding OpenBackupsCommand}"
                                ToolTip.Tip="Opens the backups in their own window: every snapshot, everything inside it, and putting one back."/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ── Presets (ET-61): the same snapshot, made portable. Deliberately beside the backups rather than
                 hidden in a menu — it is the same idea, with the machine boundary crossed. ── -->
            <Border x:Name="PresetsPanel" Grid.Row="2" Classes="panel" Padding="11,9">
                <StackPanel Spacing="5">
                    <Grid ColumnDefinitions="Auto,*">
                        <TextBlock Grid.Column="0" Classes="diamond" Text="◆" Margin="0,0,6,0"/>
                        <TextBlock Grid.Column="1" Classes="panel-title" Text="PRESETS" VerticalAlignment="Center"
                                   ToolTip.Tip="One file holding the characters and accounts you pick, to carry to another PC. Saved and read locally — nothing is uploaded anywhere."/>
                    </Grid>
                    <TextBlock Classes="blockhint"
                               Text="Pick an account and a character, save them as one file, and read it in on another PC — then copy them onto the rest from there."/>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                        <Button Grid.Column="0" Content="SAVE PRESET…" FontSize="10" HorizontalAlignment="Stretch"
                                IsEnabled="{Binding HasProfile}" Command="{Binding ExportPresetCommand}"/>
                        <Button Grid.Column="1" Content="READ PRESET…" FontSize="10" HorizontalAlignment="Stretch"
                                IsEnabled="{Binding HasProfile}" Command="{Binding ImportPresetCommand}"
                                ToolTip.Tip="Shows exactly what it would do, line by line, before anything is written."/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ── The same choice as the two blocks, remembered (ET-60). It stores exactly what they are showing,
                 which is why there is no second place to configure it. ── -->
            <Border x:Name="AutoSyncPanel" Grid.Row="4" Classes="panel" Padding="11,9">
                <StackPanel Spacing="5">
                    <Grid ColumnDefinitions="Auto,*">
                        <TextBlock Grid.Column="0" Classes="diamond" Text="◆" Margin="0,0,6,0"/>
                        <TextBlock Grid.Column="1" Classes="panel-title" Text="AUTOMATIC" VerticalAlignment="Center"
                                   ToolTip.Tip="Repeats the copy you set up on the left, by itself, whenever every EVE client is closed. Waits half a minute for EVE to finish writing, backs the whole profile up first, does nothing at all while the files already match, and stops part-way if a client starts."/>
                    </Grid>
                    <CheckBox FontSize="11" IsChecked="{Binding AutoSyncEnabled}"
                              Content="Sync automatically"
                              ToolTip.Tip="{Binding AutoSyncDetail}"/>
                    <!-- What is about to happen, in a sentence: that it is a sync, of what, on whose watch, and how
                         often it looks. "Whenever every client is closed" said none of that. The finer rules sit on
                         the tooltip rather than turning a 250px column into a paragraph. -->
                    <TextBlock Text="{Binding AutoSyncExplanation}" FontSize="10" Opacity="0.75"
                               TextWrapping="Wrap" ToolTip.Tip="{Binding AutoSyncDetail}"/>
                    <TextBlock Text="{Binding AutoSyncRuleSummary}" FontSize="11" TextWrapping="Wrap" MaxLines="3"
                               TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextAccentBrush}"
                               ToolTip.Tip="{Binding AutoSyncRuleSummary}"/>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                        <Button Grid.Column="0" Content="REMEMBER THIS" FontSize="10" HorizontalAlignment="Stretch"
                                IsEnabled="{Binding CanRememberAutoSync}"
                                Command="{Binding RememberAutoSyncCommand}"
                                ToolTip.Tip="Stores the source and targets picked on the left as the standing rule, and switches this on."/>
                        <Button Grid.Column="1" Content="FORGET" FontSize="10"
                                IsEnabled="{Binding HasAutoSyncRule}" Command="{Binding ForgetAutoSyncCommand}"/>
                    </Grid>
                    <!-- What an unattended tool did, and when: the rest of the record is on the backups above,
                         each one noting exactly which files it was taken ahead of. -->
                    <TextBlock Text="{Binding AutoSyncLastRun}" FontSize="10" Opacity="0.6" MaxLines="2"
                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{Binding AutoSyncHistory}"/>
                </StackPanel>
            </Border>
            </Grid>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</v:ChromedWindow>
