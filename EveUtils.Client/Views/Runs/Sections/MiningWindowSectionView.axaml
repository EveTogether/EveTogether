<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vr="using:EveUtils.Client.ViewModels.Runs"
             xmlns:vs="using:EveUtils.Client.ViewModels.Runs.Sections"
             xmlns:ctl="using:EveUtils.Client.Controls"
             x:Class="EveUtils.Client.Views.Runs.Sections.MiningWindowSectionView"
             x:DataType="vs:MiningWindowSectionViewModel">
    <!-- The run window's copy of MINING's one table — the columns, the narrow layout and every style come from
         MiningLedgerStyles.axaml, the same as the saved activity's (MiningDetailSectionView). -->
    <UserControl.Styles>
        <StyleInclude Source="avares://EveUtils.Client/Views/Runs/Sections/MiningLedgerStyles.axaml"/>
    </UserControl.Styles>

    <!-- A plate of the overlay's own fill (OverlayWindow's #0B0F0D) at 55% under the table: with the run window turned
         see-through (ET-215), whatever window sits behind it ran straight through these small figures (ET-288). At the
         default 0.9 fill it barely shows; at 0.35 it still hides ~70% of what is behind. The negative margin equals
         the padding, so the table keeps exactly the width MiningLedger measures. -->
    <Border Background="#8C0B0F0D" CornerRadius="3" Margin="-6,-2,-6,0" Padding="6,2,6,4">
    <StackPanel x:Name="Ledger">
        <!-- Column headers, hidden along with everything else once there is nothing mined at all. -->
        <Grid Classes="ledger" ColumnDefinitions="*,64,24,42,36,48,62" RowDefinitions="Auto,Auto" Margin="0,0,0,3"
              IsVisible="{Binding Groups.Count}">
            <TextBlock Classes="colhdr lead" Text="CHARACTER · ORE"/>
            <TextBlock Grid.Column="1" Grid.ColumnSpan="2" Classes="colhdr num figure" Text="SHARE"/>
            <TextBlock Grid.Column="3" Classes="colhdr num figure" Text="UNITS"/>
            <TextBlock Grid.Column="4" Classes="colhdr num figure" Text="CRIT"/>
            <TextBlock Grid.Column="5" Classes="colhdr num figure" Text="RESIDUE"/>
            <TextBlock Grid.Column="6" Classes="colhdr num figure" Text="ISK"/>
        </Grid>

        <!-- Own participants first, then whoever else shares mining, then an unshared external member last
             (ordering done in the view model). -->
        <ItemsControl ItemsSource="{Binding Groups}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Spacing="6"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vr:MiningCharacterGroupViewModel">
                    <StackPanel>
                        <!-- The character's own line: who, their ISK/h (or a note instead of figures), their total. -->
                        <Grid Classes="ledger" ColumnDefinitions="*,64,24,42,36,48,62">
                            <WrapPanel Grid.ColumnSpan="6" Classes="who">
                                <TextBlock Classes="charname" Text="{Binding CharacterName}"/>
                                <Border Classes="localtag" IsVisible="{Binding IsLocal}">
                                    <TextBlock Text="Local"/>
                                </Border>
                                <TextBlock Classes="boostglyph" Text="{Binding BoostGlyph}"
                                           IsVisible="{Binding BoostGlyph, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                           ToolTip.Tip="{Binding BoostTooltip}"/>
                                <TextBlock Classes="rate" Text="{Binding RateText}" ToolTip.Tip="{Binding RateTooltip}"
                                           IsVisible="{Binding RateText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                <TextBlock Classes="note" Text="{Binding NoteText}"
                                           IsVisible="{Binding !HasFigures}"/>
                            </WrapPanel>
                            <TextBlock Grid.Column="6" Classes="money" Text="{Binding IskText}"
                                       ToolTip.Tip="{Binding IskTooltip}" IsVisible="{Binding HasFigures}"/>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding Ores}" IsVisible="{Binding HasOres}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vr:ActivityMiningRowViewModel">
                                    <Grid Classes="ledger" ColumnDefinitions="*,64,24,42,36,48,62" RowDefinitions="Auto,Auto"
                                          Margin="0,2,0,0">
                                        <TextBlock Classes="oretext lead" Text="{Binding OreText}" ToolTip.Tip="{Binding OreText}"/>
                                        <ctl:MeterBar Grid.Column="1" Classes="share figure" Fraction="{Binding ShareFraction}"
                                                      Fill="{DynamicResource AccentBrush}" IsVisible="{Binding HasShareBar}"
                                                      ToolTip.Tip="{Binding ShareTooltip}"/>
                                        <TextBlock Grid.Column="2" Classes="sharepct figure" Text="{Binding ShareText}"
                                                   IsVisible="{Binding HasShareBar}" ToolTip.Tip="{Binding ShareTooltip}"/>
                                        <TextBlock Grid.Column="3" Classes="cellnum figure" Text="{Binding UnitsText}"/>
                                        <TextBlock Grid.Column="4" Classes="cellnum figure" Text="{Binding CritText}"/>
                                        <TextBlock Grid.Column="5" Classes="cellnum figure" Text="{Binding ResidueText}"/>
                                        <!-- With one ore this is the character's total again, already on the line above. -->
                                        <TextBlock Grid.Column="6" Classes="money figure" Text="{Binding ValueText}"
                                                   ToolTip.Tip="{Binding ValueTooltip}"
                                                   IsVisible="{Binding $parent[ItemsControl].((vr:MiningCharacterGroupViewModel)DataContext).HasSeveralOres}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock x:Name="FleetMinedBlock" Classes="hint" TextWrapping="Wrap" Margin="0,4,0,0" Text="{Binding FleetMinedText}"
                   IsVisible="{Binding ShowFleetMinedText}"/>
        <!-- The site's own progress: full at the run's start, emptying toward 0 as the asteroid depletes (ET-299).
             Same honesty as the old text line — only as accurate as what the fleet shares — now on the tooltip. -->
        <Grid x:Name="SiteRemainingRow" ColumnDefinitions="*,Auto" Margin="0,6,0,0" IsVisible="{Binding ShowSiteRemaining}"
              ToolTip.Tip="Site capacity is only as accurate as what the fleet shares.">
            <ctl:MeterBar Classes="site" Fraction="{Binding SiteRemainingFraction}" Fill="{DynamicResource AccentBrush}"/>
            <TextBlock Grid.Column="1" Classes="sitelabel" Text="{Binding SiteRemainingLabel}"/>
        </Grid>
    </StackPanel>
    </Border>
</UserControl>
