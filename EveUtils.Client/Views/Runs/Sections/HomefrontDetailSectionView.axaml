<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:va="using:EveUtils.Client.ViewModels.Runs.Attendance"
             xmlns:vs="using:EveUtils.Client.ViewModels.Runs.Sections"
             xmlns:re="using:EveUtils.Shared.Modules.Runs.Enums"
             xmlns:v="using:EveUtils.Client.Views"
             x:Class="EveUtils.Client.Views.Runs.Sections.HomefrontDetailSectionView"
             x:DataType="vs:HomefrontDetailSectionViewModel">
    <UserControl.Styles>
        <Style Selector="Border.tick">
            <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,1,6,2"/>
            <Setter Property="MinWidth" Value="72"/>
            <Setter Property="Margin" Value="10,0,0,0"/>
        </Style>
        <Style Selector="Border.tick TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrightBrush}"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Border.tick.insite">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
        </Style>
        <Style Selector="CheckBox.insite">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Margin" Value="10,0,0,0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.summary">
            <Setter Property="Foreground" Value="{StaticResource TextBrightBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,6,0,4"/>
        </Style>
    </UserControl.Styles>

    <StackPanel>
        <!-- The same switch as the run window (ET-271): a saved homefront is completed or failed with one click. -->
        <StackPanel x:Name="OutcomeSwitch" Orientation="Horizontal" Margin="1,2,0,0" IsVisible="{Binding !IsAar}"
                    IsEnabled="{Binding CanDecideOutcome}">
            <Button Classes="seg" Classes.on="{Binding IsCompleted}" Content="Completed"
                    Command="{Binding SetOutcomeCommand}" CommandParameter="{x:Static re:HomefrontOutcome.Completed}"/>
            <Button Classes="seg bad" Classes.on="{Binding IsFailed}" Content="Failed"
                    Command="{Binding SetOutcomeCommand}" CommandParameter="{x:Static re:HomefrontOutcome.Failed}"/>
            <Button Classes="seg" Classes.on="{Binding IsUnknown}" Content="Unknown"
                    Command="{Binding SetOutcomeCommand}" CommandParameter="{x:Static re:HomefrontOutcome.Unknown}"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,2,0,0" IsVisible="{Binding IsAar}">
            <TextBlock Classes="figlabel" Text="waves paid"/>
            <TextBlock Classes="figvalue" Text="{Binding CompletedWaveCount}"/>
            <TextBlock Classes="figlabel" Text="of 9"/>
            <Button Content="▲" Padding="6,0" Margin="6,0,0,0" IsVisible="{Binding CanDecideOutcome}" Command="{Binding IncreaseWaveCommand}"/>
            <Button Content="▼" Padding="6,0" IsVisible="{Binding CanDecideOutcome}" Command="{Binding DecreaseWaveCommand}"/>
        </StackPanel>

        <!-- Which payout table priced it sits behind the line, not on a line of its own. -->
        <TextBlock x:Name="PayoutSummary" Classes="summary" Text="{Binding PayoutSummaryText}"
                   ToolTip.Tip="{Binding PayoutTableVersionText}"
                   IsVisible="{Binding PayoutSummaryText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
        <TextBlock x:Name="Notice" Classes="hint" Margin="0,0,0,4" Foreground="{StaticResource WarnBrush}"
                   IsVisible="{Binding NoticeText, Converter={x:Static ObjectConverters.IsNotNull}}"
                   Text="{Binding NoticeText}"/>

        <!-- One line per character; a tick or an amount is written the moment it changes — no "change" mode. -->
        <ItemsControl x:Name="AttendanceList" ItemsSource="{Binding Rows}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="va:AttendanceRowViewModel">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,2">
                        <Border Classes="localbar" Classes.on="{Binding IsLocal}"/>
                        <!-- The hint gives way first: trimmed, never pushed under the figure beside it. -->
                        <Grid Grid.Column="1" ColumnDefinitions="Auto,Auto,*" VerticalAlignment="Center">
                            <TextBlock Classes="charname" Text="{Binding Name}"/>
                            <Border Grid.Column="1" Classes="localtag" IsVisible="{Binding IsLocal}">
                                <TextBlock Text="Local"/>
                            </Border>
                            <TextBlock Grid.Column="2" Classes="rowhint" Text="{Binding HintText}"/>
                        </Grid>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Classes="figlabel" Text="typed" Margin="0,0,4,0" IsVisible="{Binding IsTypedShown}"/>
                            <Panel IsVisible="{Binding CanActOnPayout}">
                                <Button Classes="amount" Classes.corrected="{Binding IsCorrected}"
                                        IsVisible="{Binding IsPayoutLinkShown}"
                                        Content="{Binding PayoutText}" Command="{Binding BeginPayoutEditCommand}"
                                        ToolTip.Tip="A different amount arrived? Click to type it."/>
                                <!-- Enter keeps it, Escape or clicking away drops it (PayoutEditorKeys). -->
                                <TextBox Classes="amountedit" IsVisible="{Binding IsEditingPayout}"
                                         v:FocusWhenShown.IsEnabled="True" Text="{Binding PayoutEditText}"/>
                            </Panel>
                            <TextBlock Classes="figvalue" IsVisible="{Binding IsPayoutReadOnly}" Text="{Binding PayoutText}"/>
                        </StackPanel>

                        <CheckBox Grid.Column="3" Classes="insite" Content="in site"
                                  IsVisible="{Binding IsEditable}" IsChecked="{Binding IsInSite, Mode=TwoWay}"/>
                        <Border Grid.Column="3" Classes="tick" Classes.insite="{Binding IsInSite}"
                                VerticalAlignment="Center" IsVisible="{Binding !IsEditable}">
                            <TextBlock Text="{Binding TickText}"/>
                        </Border>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel Orientation="Horizontal" Spacing="4" Margin="8,4,0,0">
            <TextBlock Classes="figlabel" Text="+ others in site"
                       ToolTip.Tip="Pilots in the site who are not in this fleet in Eve Together at all — they count for N."/>
            <TextBlock Classes="figvalue" Text="{Binding NotOnRosterCount}"/>
            <Button Content="▲" Padding="6,0" Margin="6,0,0,0" IsVisible="{Binding CanEdit}"
                    Command="{Binding IncreaseNotOnRosterCommand}" ToolTip.Tip="One more pilot in the site"/>
            <Button Content="▼" Padding="6,0" IsVisible="{Binding CanEdit}"
                    Command="{Binding DecreaseNotOnRosterCommand}" ToolTip.Tip="One pilot fewer"/>
        </StackPanel>

        <TextBlock Classes="hint" Foreground="{StaticResource RedBrush}" TextWrapping="Wrap"
                   IsVisible="{Binding EditError, Converter={x:Static ObjectConverters.IsNotNull}}"
                   Text="{Binding EditError}"/>
    </StackPanel>
</UserControl>
