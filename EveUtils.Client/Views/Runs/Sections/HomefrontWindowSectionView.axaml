<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:va="using:EveUtils.Client.ViewModels.Runs.Attendance"
             xmlns:vs="using:EveUtils.Client.ViewModels.Runs.Sections"
             x:Class="EveUtils.Client.Views.Runs.Sections.HomefrontWindowSectionView"
             x:DataType="vs:HomefrontWindowSectionViewModel">
    <UserControl.Styles>
        <!-- "Local" and the accent bar say which characters are this client's own — the one thing it knows. -->
        <Style Selector="Border.localtag">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4,0,4,1"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Border.localtag TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrightBrush}"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="LetterSpacing" Value="1.2"/>
        </Style>
        <Style Selector="Border.localbar">
            <Setter Property="Width" Value="2"/>
            <Setter Property="Margin" Value="0,2,6,2"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Border.localbar.on">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
        </Style>
        <Style Selector="TextBlock.reason">
            <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
            <Setter Property="FontSize" Value="9.5"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <!-- Nothing to go on: marked in amber, never greyed out — the one who decides has to read it. -->
        <Style Selector="TextBlock.reason.noevidence">
            <Setter Property="Foreground" Value="{StaticResource WarnBrush}"/>
        </Style>
        <Style Selector="TextBlock.presence">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="9.5"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style Selector="TextBlock.presence.online">
            <Setter Property="Foreground" Value="{StaticResource GreenBrush}"/>
        </Style>
        <Style Selector="TextBlock.setby">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrightBrush}"/>
            <Setter Property="FontSize" Value="9.5"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
        </Style>
        <!-- Read-only, but readable: a bright word in a bright border, not a checkbox dimmed to nothing. -->
        <Style Selector="Border.tick">
            <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,1,6,2"/>
            <Setter Property="MinWidth" Value="84"/>
        </Style>
        <Style Selector="Border.tick TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrightBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Border.tick.insite">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
        </Style>
        <Style Selector="TextBlock.strip">
            <Setter Property="Foreground" Value="{StaticResource TextBrightBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </UserControl.Styles>

    <StackPanel>
        <Grid Classes="kv" ColumnDefinitions="Auto,*">
            <TextBlock Text="DECIDED BY"/>
            <StackPanel Grid.Column="1">
                <TextBlock x:Name="DecidedBy" Text="{Binding DecidedByText}"/>
                <TextBlock Classes="hint" Margin="0" IsVisible="{Binding LastChangeText, Converter={x:Static ObjectConverters.IsNotNull}}"
                           Text="{Binding LastChangeText}"/>
            </StackPanel>
        </Grid>

        <TextBlock x:Name="Notice" Classes="hint" Foreground="{StaticResource WarnBrush}"
                   IsVisible="{Binding NoticeText, Converter={x:Static ObjectConverters.IsNotNull}}"
                   Text="{Binding NoticeText}"/>
        <TextBlock Classes="hint" IsVisible="{Binding LastSiteText, Converter={x:Static ObjectConverters.IsNotNull}}"
                   Text="{Binding LastSiteText}"/>

        <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,2">
            <TextBlock Classes="hint" Margin="0" Text="CHARACTER · WHY PROPOSED"/>
            <TextBlock Grid.Column="1" Classes="hint" Margin="0" Text="IN SITE AT COMPLETION"/>
        </Grid>

        <!-- One flat list, per character: own characters first with "Local", the rest A–Z (ET-230). -->
        <ItemsControl x:Name="AttendanceList" ItemsSource="{Binding Rows}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="va:AttendanceRowViewModel">
                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,3">
                        <Border Classes="localbar" Classes.on="{Binding IsLocal}"/>
                        <StackPanel Grid.Column="1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextBrightBrush}"
                                           FontSize="11.5" VerticalAlignment="Center"/>
                                <Border Classes="localtag" IsVisible="{Binding IsLocal}">
                                    <TextBlock Text="Local"/>
                                </Border>
                            </StackPanel>
                            <!-- Wraps rather than running under the tick when the reason and "set by" are both long. -->
                            <WrapPanel>
                                <TextBlock Classes="presence" Classes.online="{Binding IsOnline}"
                                           IsVisible="{Binding IsPresenceShown}" Text="{Binding PresenceText}"/>
                                <TextBlock Classes="reason" Classes.noevidence="{Binding IsWithoutEvidence}"
                                           Text="{Binding ReasonText}"/>
                                <TextBlock Classes="setby" IsVisible="{Binding IsSetByHand}" Text="{Binding SetByText}"/>
                            </WrapPanel>
                        </StackPanel>
                        <CheckBox Grid.Column="2" VerticalAlignment="Center" Content="in site"
                                  IsVisible="{Binding IsEditable}" IsChecked="{Binding IsInSite, Mode=TwoWay}"/>
                        <Border Grid.Column="2" Classes="tick" Classes.insite="{Binding IsInSite}"
                                VerticalAlignment="Center" IsVisible="{Binding !IsEditable}">
                            <TextBlock Text="{Binding TickText}"/>
                        </Border>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Only for pilots on no roster at all: an external pilot is a row above and is ticked there. -->
        <Grid ColumnDefinitions="*,Auto" Margin="0,6,0,0">
            <StackPanel>
                <TextBlock Text="+ pilots not on the roster" Foreground="{StaticResource TextBrightBrush}" FontSize="11.5"/>
                <TextBlock Classes="hint" Margin="0"
                           Text="In the site, but not in this fleet in Eve Together — not even as external."/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="4">
                <TextBlock x:Name="NotOnRoster" Text="{Binding NotOnRosterCount}" VerticalAlignment="Center"
                           Foreground="{StaticResource TextBrightBrush}" MinWidth="18" TextAlignment="Right"/>
                <Button Content="▲" Padding="6,0" IsVisible="{Binding CanDecide}"
                        Command="{Binding IncreaseNotOnRosterCommand}"
                        ToolTip.Tip="One more pilot in the site who is on no roster"/>
                <Button Content="▼" Padding="6,0" IsVisible="{Binding CanDecide}"
                        Command="{Binding DecreaseNotOnRosterCommand}"
                        ToolTip.Tip="One pilot fewer"/>
            </StackPanel>
        </Grid>

        <Border Classes="totals" Margin="0,8,0,0">
            <StackPanel>
                <TextBlock x:Name="CountStrip" Classes="strip" Text="{Binding CountText}"/>
                <TextBlock Classes="hint" Margin="0" Text="{Binding BreakdownText}"/>
            </StackPanel>
        </Border>

        <TextBlock Classes="hint" TextWrapping="Wrap" Text="{Binding CaptionText}"/>
        <TextBlock Classes="hint" TextWrapping="Wrap"
                   Text="Online / offline is the live fleet view — nothing of it is stored."/>
    </StackPanel>
</UserControl>
