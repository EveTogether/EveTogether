<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vr="using:EveUtils.Client.ViewModels.Runs"
             xmlns:vs="using:EveUtils.Client.ViewModels.Runs.Sections"
             x:Class="EveUtils.Client.Views.Runs.Sections.MissionDetailSectionView"
             x:DataType="vs:MissionDetailSectionViewModel">
    <StackPanel>
        <Grid Classes="kv" ColumnDefinitions="Auto,*" IsVisible="{Binding IsImportantMission}">
            <TextBlock Text="IMPORTANT"/>
            <TextBlock Grid.Column="1" Text="affects faction standing"/>
        </Grid>
        <Grid Classes="kv" ColumnDefinitions="Auto,*" IsVisible="{Binding HasAgent}">
            <TextBlock Text="AGENT"/>
            <TextBlock Grid.Column="1" Text="{Binding AgentText}"/>
        </Grid>
        <Grid Classes="kv" ColumnDefinitions="Auto,*" IsVisible="{Binding IsLevelShown}">
            <TextBlock Text="LEVEL"/>
            <TextBlock Grid.Column="1" Text="{Binding LevelText}"/>
        </Grid>
        <Grid Classes="kv" ColumnDefinitions="Auto,*" IsVisible="{Binding IsMissionLocationShown}">
            <TextBlock Text="MISSION LOCATION"/>
            <TextBlock Grid.Column="1" Text="{Binding MissionLocationText}"/>
        </Grid>
        <Grid Classes="kv" ColumnDefinitions="Auto,*" IsVisible="{Binding IsRewardOwnerShown}">
            <TextBlock Text="REWARD CREDITED TO"/>
            <TextBlock Grid.Column="1" Text="{Binding RewardOwnerText}"/>
        </Grid>

        <Grid Classes="kv" ColumnDefinitions="Auto,*" IsVisible="{Binding HasBonus}">
            <TextBlock Text="BONUS ISK"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{Binding BonusValueText}"/>
                <Border Classes="chip dim" IsVisible="{Binding IsBonusExpired}">
                    <TextBlock Text="bonus expired"/>
                </Border>
            </StackPanel>
        </Grid>

        <!-- One row per form and never one total: the key list keeps growing, and LP and
             Evermarks have no rate to convert into ISK against. -->
        <ItemsControl x:Name="RewardList" ItemsSource="{Binding RewardRows}">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vr:ActivityRewardRowViewModel">
                    <Grid Classes="kv" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                        <TextBlock Text="{Binding Label}"/>
                        <TextBlock Grid.Column="1" Text="{Binding ValueText}"/>
                        <TextBlock Grid.Column="2" Classes="hint" Margin="0"
                                   VerticalAlignment="Center" IsVisible="{Binding HasNote}"
                                   Text="{Binding NoteText}"/>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Classes="hint" TextWrapping="Wrap"
                   IsVisible="{Binding RewardsEmptyText, Converter={x:Static ObjectConverters.IsNotNull}}"
                   Text="{Binding RewardsEmptyText}"/>
    </StackPanel>
</UserControl>
