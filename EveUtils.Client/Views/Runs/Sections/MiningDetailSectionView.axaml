<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vr="using:EveUtils.Client.ViewModels.Runs"
             xmlns:vs="using:EveUtils.Client.ViewModels.Runs.Sections"
             xmlns:ctl="using:EveUtils.Client.Controls"
             x:Class="EveUtils.Client.Views.Runs.Sections.MiningDetailSectionView"
             x:DataType="vs:MiningDetailSectionViewModel">
    <UserControl.Styles>
        <!-- Same row shape as the run window (ET-283, variant C of the mining-ledger mockups): "now" becomes "avg". -->
        <Style Selector="TextBlock.charname">
            <Setter Property="FontWeight" Value="Medium"/>
        </Style>
        <Style Selector="Grid.orerow">
            <Setter Property="Margin" Value="16,1,0,0"/>
        </Style>
        <Style Selector="TextBlock.oretext">
            <Setter Property="Opacity" Value="0.85"/>
        </Style>
        <Style Selector="TextBlock.sharepct">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
            <Setter Property="Opacity" Value="0.75"/>
            <Setter Property="FontSize" Value="10"/>
        </Style>
        <Style Selector="ctl|MeterBar.share">
            <Setter Property="Height" Value="6"/>
            <Setter Property="Width" Value="56"/>
        </Style>
    </UserControl.Styles>

    <StackPanel>
        <ItemsControl x:Name="MiningList" ItemsSource="{Binding Groups}" IsVisible="{Binding HasMining}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Spacing="6"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vr:MiningCharacterGroupViewModel">
                    <StackPanel>
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Classes="charname" Text="{Binding CharacterName}"/>
                                <Border Classes="localtag" IsVisible="{Binding IsLocal}">
                                    <TextBlock Text="Local"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Classes="hint" Text="{Binding RateText}" ToolTip.Tip="{Binding RateTooltip}"/>
                            <TextBlock Grid.Column="2" Classes="money" Text="{Binding IskText}" ToolTip.Tip="{Binding ResidueTooltip}"/>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding Ores}" IsVisible="{Binding HasOres}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vr:ActivityMiningRowViewModel">
                                    <Grid Classes="orerow" ColumnDefinitions="*,70,Auto,Auto,Auto" ColumnSpacing="8">
                                        <TextBlock Classes="oretext" Text="{Binding OreText}"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" IsVisible="{Binding HasShareBar}"
                                                    ToolTip.Tip="{Binding ShareTooltip}">
                                            <ctl:MeterBar Classes="share" Fraction="{Binding ShareFraction}" Fill="{DynamicResource AccentBrush}"/>
                                            <TextBlock Classes="sharepct" Text="{Binding ShareText}"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Classes="hint" Text="{Binding UnitsText}"/>
                                        <TextBlock Grid.Column="3" Classes="hint" Text="{Binding ResidueText}"/>
                                        <TextBlock Grid.Column="4" Classes="money" Text="{Binding ValueText}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Border Classes="totals" IsVisible="{Binding HasMining}">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="label" Text="TOTAL" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Classes="money total" Text="{Binding MiningText}"/>
            </Grid>
        </Border>
        <TextBlock x:Name="MiningEmpty" Classes="hint" TextWrapping="Wrap"
                   IsVisible="{Binding EmptyText, Converter={x:Static ObjectConverters.IsNotNull}}"
                   Text="{Binding EmptyText}"/>
    </StackPanel>
</UserControl>
