<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="using:EveUtils.Client.Controls"
             xmlns:vs="using:EveUtils.Client.ViewModels.Runs.Sections"
             x:Class="EveUtils.Client.Views.Runs.Sections.CombatDetailSectionView"
             x:DataType="vs:CombatDetailSectionViewModel">
    <StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,6"
                    IsVisible="{Binding CombatEmptyText, Converter={x:Static ObjectConverters.IsNull}}">
            <TextBlock Classes="label" Text="PILOT" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ItemsControl x:Name="CombatPilots" ItemsSource="{Binding Pilots}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="5"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vs:CombatPilotChipViewModel">
                        <Button Classes="chipaction" Classes.actionable="{Binding IsAvailable}"
                                Command="{Binding ShowCommand}"
                                ToolTip.Tip="{Binding Tooltip}">
                            <Border Classes="chip" Classes.ok="{Binding IsSelected}"
                                    Classes.dim="{Binding !IsAvailable}">
                                <TextBlock Text="{Binding Text}"/>
                            </Border>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
        <!-- Four across, as in the mockup; a long weapon or target name is cut rather than widening the grid. -->
        <ItemsControl x:Name="CombatTiles" ItemsSource="{Binding Tiles}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="4"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vs:CombatTileViewModel">
                    <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" Background="#2E000000"
                            Padding="9,6,9,7" Margin="0,0,6,6">
                        <StackPanel Spacing="2">
                            <TextBlock Classes="label" FontSize="9.5" Text="{Binding Label}"/>
                            <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrightBrush}" Text="{Binding Value}"/>
                            <TextBlock FontSize="9.5" Foreground="{StaticResource TextDimBrush}"
                                       TextTrimming="CharacterEllipsis" Text="{Binding Note}"
                                       ToolTip.Tip="{Binding Note}"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <StackPanel IsVisible="{Binding Chart, Converter={x:Static ObjectConverters.IsNotNull}}">
            <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" Background="#38000000"
                    Padding="8,8,8,4" Margin="0,4,0,0">
                <ctl:CombatTimelineChart x:Name="CombatChart" Height="250" Model="{Binding Chart}"/>
            </Border>
            <ItemsControl x:Name="CombatLegend" ItemsSource="{Binding Legend}" Margin="2,6,2,2">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vs:CombatLegendItem">
                        <StackPanel Orientation="Horizontal" Spacing="5" Margin="0,2,14,2" Opacity="{Binding Opacity}">
                            <Border Width="14" Height="2" VerticalAlignment="Center" Background="{Binding Ink}"/>
                            <TextBlock FontSize="10" Text="{Binding Text}"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Classes="hint" Text="Idle (no damage either way for at least 5 s) is hatched on the baseline. Hover the chart for the exact 5 s values (1 s samples, shown per 5 s)."
                       TextWrapping="Wrap"/>
        </StackPanel>
        <TextBlock x:Name="CombatEmpty" Classes="hint" TextWrapping="Wrap"
                   IsVisible="{Binding CombatEmptyText, Converter={x:Static ObjectConverters.IsNotNull}}"
                   Text="{Binding CombatEmptyText}"/>
    </StackPanel>
</UserControl>
