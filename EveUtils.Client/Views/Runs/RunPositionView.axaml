<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="using:EveUtils.Client.Views"
             xmlns:va="using:EveUtils.Client.ViewModels.Activity"
             xmlns:vr="using:EveUtils.Client.ViewModels.Runs"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="320"
             x:Class="EveUtils.Client.Views.Runs.RunPositionView"
             x:DataType="vr:RunPositionViewModel">

    <!-- The run window's EXPECTED EARNINGS panel (ET-516) over a saved run, with the run's own ISK as the marker, and
         under it, for an outlier, the drop that made it (ET-520); the rank is the label on the bar (ET-524). Not folded: it is here to be read.
         All ink is TextBrush or brighter, as in the panel: the dim ink is under 4.5:1 on the opaque pane and the body. -->
    <UserControl.Styles>
        <Style Selector="TextBlock.eelabel">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="9.5"/>
            <Setter Property="LetterSpacing" Value="1.6"/>
        </Style>
        <Style Selector="TextBlock.eetitle">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="LetterSpacing" Value="1.8"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.serveroption">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Padding" Value="6,5"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style Selector="Button.serveroption.current">
            <Setter Property="Foreground" Value="{StaticResource TextBrightBrush}"/>
        </Style>
        <Style Selector="Button.serveroption:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BgRowHoverBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrightBrush}"/>
        </Style>
        <Style Selector="TextBlock.eebig">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrightBrush}"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="TextBlock.eefigure">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrightBrush}"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style Selector="TextBlock.eetext">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="LineHeight" Value="15"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style Selector="TextBlock.eemono">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="10"/>
        </Style>
        <Style Selector="TextBlock.eenow">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
            <Setter Property="Foreground" Value="{StaticResource ValueBrush}"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style Selector="Border.eedot">
            <Setter Property="Width" Value="9"/>
            <Setter Property="Height" Value="9"/>
            <Setter Property="Margin" Value="0,0,3,0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        </Style>
        <Style Selector="Border.eedot.filled">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
        </Style>
    </UserControl.Styles>

    <StackPanel x:Name="PositionRoot" IsVisible="{Binding Earnings.IsShown}">
        <Border x:Name="PositionPanel" DataContext="{Binding Earnings}" x:DataType="va:ExpectedEarningsViewModel"
                Padding="14,10,14,10">
            <StackPanel Spacing="8">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                    <TextBlock Grid.Column="0" Classes="eetitle" Text="EXPECTED EARNINGS"/>
                    <Border Grid.Column="1" Classes="chip" Classes.ok="{Binding IsSharedSource}"
                            IsVisible="{Binding ShowsPlainSourceChip}">
                        <TextBlock x:Name="PositionSourceChip" Text="{Binding SourceChip}"/>
                    </Border>
                    <Button x:Name="PositionSourceButton" Grid.Column="1" Background="Transparent" BorderThickness="0"
                            Padding="0" MinHeight="0" Cursor="Hand" IsVisible="{Binding ShowsChoiceSourceChip}"
                            Command="{Binding ToggleServerListCommand}" ToolTip.Tip="Choose which server's figures to show">
                        <Border Classes="chip ok">
                            <TextBlock Text="{Binding SourceChip, StringFormat='{}{0} ▾'}"/>
                        </Border>
                    </Button>
                </Grid>

                <TextBlock x:Name="PositionLoading" Classes="eetext" Text="Looking up this run…" IsVisible="{Binding IsLoading}"/>

                <ItemsControl x:Name="PositionServerList" ItemsSource="{Binding ServerOptions}">
                    <ItemsControl.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding Path="HasServerChoice"/>
                            <Binding Path="IsServerListOpen"/>
                        </MultiBinding>
                    </ItemsControl.IsVisible>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vr:ServerOptionViewModel">
                            <Button Classes="serveroption" Classes.current="{Binding IsCurrent}" Command="{Binding ChooseCommand}">
                                <Grid ColumnDefinitions="14,*,Auto" ColumnSpacing="6">
                                    <TextBlock Grid.Column="0" Text="&#x2713;" IsVisible="{Binding IsCurrent}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding NameText}"/>
                                    <TextBlock Grid.Column="2" Classes="eemono" Text="{Binding DetailText}"/>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <v:EarningsRangeStrip x:Name="PositionFigures" IsVisible="{Binding HasFigures}"/>

                <StackPanel x:Name="PositionTooFew" Spacing="6" IsVisible="{Binding IsTooFewRuns}">
                    <ItemsControl ItemsSource="{Binding RunDots}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:Boolean">
                                <Border Classes="eedot" Classes.filled="{Binding}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="PositionTooFewLine" Classes="eefigure" FontSize="11.5" Text="{Binding TooFewText}"/>
                </StackPanel>

                <!-- The foot: the runs the figures rest on and whose they are; the full reason is the tooltip. -->
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding !IsLoading}">
                    <TextBlock x:Name="PositionBasis" Classes="eemono" TextWrapping="Wrap" VerticalAlignment="Center"
                               Text="{Binding BasisText}" ToolTip.Tip="{Binding NoteText}"/>
                    <Border Grid.Column="1" Classes="chip warn" VerticalAlignment="Center" IsVisible="{Binding HasConfidenceText}">
                        <TextBlock Text="{Binding ConfidenceText}"/>
                    </Border>
                </Grid>
            </StackPanel>
        </Border>

        <!-- This run's standing: the why of an outlier, or why it has no rank. The rank itself is on the bar's label.
             Each line is there only when it has something to say. -->
        <Border x:Name="PositionStanding" Padding="14,0,14,10" IsVisible="{Binding Earnings.HasFigures}">
            <StackPanel Spacing="3">
                <TextBlock x:Name="PositionRankNote" Classes="eetext" IsVisible="{Binding HasRankNote}" Text="{Binding RankNoteText}"/>
                <TextBlock x:Name="PositionOutlier" Classes="eenow" TextWrapping="Wrap" IsVisible="{Binding HasOutlier}" Text="{Binding OutlierText}"/>
                <WrapPanel x:Name="PositionTopDrop" IsVisible="{Binding HasTopDrop}">
                    <TextBlock Classes="eelabel" VerticalAlignment="Center" Margin="0,0,8,0" Text="NOTABLE DROP"/>
                    <TextBlock x:Name="PositionTopDropName" Classes="eefigure" FontSize="11.5" VerticalAlignment="Center"
                               Margin="0,0,8,0" Text="{Binding TopDropText}"/>
                    <TextBlock Classes="eemono" VerticalAlignment="Center" Margin="0,0,8,0" Text="{Binding TopDropMetaText}"/>
                    <Button x:Name="PositionLootTable" Classes="pick" IsVisible="{Binding IsLootTableShown}"
                            Command="{Binding OpenLootTableCommand}" Content="OPEN LOOT TABLE ›"
                            ToolTip.Tip="What can drop here, and how often"/>
                </WrapPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
