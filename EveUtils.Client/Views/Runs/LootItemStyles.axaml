<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- One item line and its badges (ET-215), as LOOT draws them and CONSUMABLES repeats them (ET-329): a spent
         filament reads like any other line of the run, never as a look of its own. -->
    <Styles.Resources>
        <!-- The mockup's quiet ink, one step brighter than TextDimBrush: the run window can be set see-through, and
             at its default fill over a bright backdrop TextDim falls to 3.8:1 where this holds 5.5:1. Faction-free,
             like the dim ink it stands in for. -->
        <SolidColorBrush x:Key="LootMetaBrush" Color="#FFA89C88"/>
    </Styles.Resources>

    <!-- ── The item table ── striped, a hairline under every row, the heaviest line tinted. The stripe and the
         hover fill both come from Classes="detailrow" (Themes/EveUtils.axaml, ET-285) — one definition for
         every dense list in the activity detail screen, not one per section. -->
    <Style Selector="Border.itemrow">
        <Setter Property="Padding" Value="6,4"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="BorderBrush" Value="#08FFFFFF"/>
    </Style>
    <Style Selector="Border.itemrow.top">
        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
    </Style>
    <Style Selector="Border.itemrow TextBlock.itemname">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style Selector="Border.itemrow TextBlock.money">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    </Style>
    <Style Selector="Border.itemrow.top TextBlock.money">
        <Setter Property="Foreground" Value="{StaticResource ValueBrush}"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>
    <Style Selector="Border.itemrow.excluded TextBlock.money">
        <Setter Property="TextDecorations" Value="Strikethrough"/>
    </Style>
    <Style Selector="Border.icontile">
        <Setter Property="Width" Value="20"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="CornerRadius" Value="3"/>
        <Setter Property="ClipToBounds" Value="True"/>
        <Setter Property="Background" Value="{StaticResource BgRowAltBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="TextBlock.meta">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
        <Setter Property="Foreground" Value="{StaticResource LootMetaBrush}"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- ── Badges ── small bordered pills in the mockup's four inks. -->
    <Style Selector="Border.badge">
        <Setter Property="CornerRadius" Value="3"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}"/>
        <Setter Property="Padding" Value="5,0,5,1"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Border.badge > TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
        <Setter Property="FontSize" Value="9"/>
        <Setter Property="LetterSpacing" Value="0.4"/>
        <Setter Property="Foreground" Value="{StaticResource LootMetaBrush}"/>
    </Style>
    <Style Selector="Border.badge.role">
        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
    </Style>
    <Style Selector="Border.badge.role > TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource AccentBrightBrush}"/>
    </Style>
    <Style Selector="Border.badge.excluded">
        <Setter Property="Background" Value="#14EF5A5A"/>
        <Setter Property="BorderBrush" Value="#66EF5A5A"/>
    </Style>
    <Style Selector="Border.badge.excluded > TextBlock">
        <Setter Property="Foreground" Value="{StaticResource RedBrush}"/>
    </Style>
    <Style Selector="Border.badge.repeat">
        <Setter Property="Background" Value="#14C084FC"/>
        <Setter Property="BorderBrush" Value="#66C084FC"/>
    </Style>
    <Style Selector="Border.badge.repeat > TextBlock">
        <Setter Property="Foreground" Value="{StaticResource MagentaBrush}"/>
    </Style>
</Styles>
