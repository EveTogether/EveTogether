<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- One item line and its badges (ET-215), as LOOT draws them and CONSUMABLES repeats them (ET-329): a spent
         filament reads like any other line of the run, never as a look of its own. -->
    <Styles.Resources>
        <!-- The mockup's quiet ink, one step brighter than TextDimBrush: the run window can be set see-through, and
             at its default fill over a bright backdrop TextDim falls to 3.8:1 where this holds 5.5:1. Faction-free,
             like the dim ink it stands in for. -->
        <SolidColorBrush x:Key="LootMetaBrush" Color="#FFA89C88"/>
    </Styles.Resources>

    <!-- ── The item table ── striped, a hairline under every row, the heaviest line tinted. The stripe and the
         hover fill both come from Classes="detailrow" (Themes/EveUtils.axaml, ET-285) — one definition for
         every dense list in the activity detail screen, not one per section. -->
    <Style Selector="Border.itemrow">
        <Setter Property="Padding" Value="6,4"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="BorderBrush" Value="#08FFFFFF"/>
    </Style>
    <Style Selector="Border.itemrow.top">
        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
    </Style>
    <Style Selector="Border.itemrow TextBlock.itemname">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style Selector="Border.itemrow TextBlock.money">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    </Style>
    <Style Selector="Border.itemrow.top TextBlock.money">
        <Setter Property="Foreground" Value="{StaticResource ValueBrush}"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>
    <Style Selector="Border.itemrow.excluded TextBlock.money">
        <Setter Property="TextDecorations" Value="Strikethrough"/>
    </Style>
    <Style Selector="Border.icontile">
        <Setter Property="Width" Value="20"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="CornerRadius" Value="3"/>
        <Setter Property="ClipToBounds" Value="True"/>
        <Setter Property="Background" Value="{StaticResource BgRowAltBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="TextBlock.meta">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
        <Setter Property="Foreground" Value="{StaticResource LootMetaBrush}"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- ── Badges ── small bordered pills in the mockup's four inks. -->
    <Style Selector="Border.badge">
        <Setter Property="CornerRadius" Value="3"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}"/>
        <Setter Property="Padding" Value="5,0,5,1"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Border.badge > TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
        <Setter Property="FontSize" Value="9"/>
        <Setter Property="LetterSpacing" Value="0.4"/>
        <Setter Property="Foreground" Value="{StaticResource LootMetaBrush}"/>
    </Style>
    <Style Selector="Border.badge.role">
        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
    </Style>
    <Style Selector="Border.badge.role > TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource AccentBrightBrush}"/>
    </Style>
    <Style Selector="Border.badge.excluded">
        <Setter Property="Background" Value="#14EF5A5A"/>
        <Setter Property="BorderBrush" Value="#66EF5A5A"/>
    </Style>
    <Style Selector="Border.badge.excluded > TextBlock">
        <Setter Property="Foreground" Value="{StaticResource RedBrush}"/>
    </Style>
    <Style Selector="Border.badge.repeat">
        <Setter Property="Background" Value="#14C084FC"/>
        <Setter Property="BorderBrush" Value="#66C084FC"/>
    </Style>
    <Style Selector="Border.badge.repeat > TextBlock">
        <Setter Property="Foreground" Value="{StaticResource MagentaBrush}"/>
    </Style>

    <!-- ── Killmail badges (ET-333) ── DESTROYED/DROPPED on a FIT item line, TOP DAMAGE/YOU on an ATTACKERS row
         (FINAL BLOW reuses Border.badge.role above). -->
    <Style Selector="Border.badge.destroyed">
        <Setter Property="Background" Value="#14EF5A5A"/>
        <Setter Property="BorderBrush" Value="#66EF5A5A"/>
    </Style>
    <Style Selector="Border.badge.destroyed > TextBlock">
        <Setter Property="Foreground" Value="{StaticResource RedBrush}"/>
    </Style>
    <Style Selector="Border.badge.dropped">
        <Setter Property="Background" Value="#144ADE80"/>
        <Setter Property="BorderBrush" Value="#664ADE80"/>
    </Style>
    <Style Selector="Border.badge.dropped > TextBlock">
        <Setter Property="Foreground" Value="{StaticResource GreenBrush}"/>
    </Style>
    <Style Selector="Border.badge.top">
        <Setter Property="Background" Value="#14F5B042"/>
        <Setter Property="BorderBrush" Value="#66F5B042"/>
    </Style>
    <Style Selector="Border.badge.top > TextBlock">
        <Setter Property="Foreground" Value="{StaticResource ValueBrush}"/>
    </Style>
    <Style Selector="Border.badge.me">
        <Setter Property="Background" Value="#1AF5B042"/>
        <Setter Property="BorderBrush" Value="#77F5B042"/>
    </Style>
    <Style Selector="Border.badge.me > TextBlock">
        <Setter Property="Foreground" Value="{StaticResource ValueBrush}"/>
    </Style>

    <!-- ── Per character ── the name and subtotal heading every block, LOOT's and CONSUMABLES' alike. -->
    <Style Selector="TextBlock.charname">
        <Setter Property="Foreground" Value="{StaticResource TextBrightBrush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style Selector="TextBlock.subtotal">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- ── Rewrite by hand ── the note under a list, the button that opens the box and the box's own buttons: one
         look for LOOT and CONSUMABLES (ET-334). -->
    <Style Selector="TextBlock.note">
        <Setter Property="Foreground" Value="{StaticResource LootMetaBrush}"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontStyle" Value="Italic"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- ── Buttons ── the mockup's small accent button for the way back in, and the one control Jithran asked to
         be found without looking: rewrite by hand, plated and bordered in the accent on every character's own
         header rather than a ghost at the foot of the list (ET-215 feedback). -->
    <Style Selector="Button.small">
        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextAccentBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="3"/>
        <Setter Property="Padding" Value="8,3"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="FontSize" Value="10"/>
    </Style>
    <Style Selector="Button.small:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BgRowHoverBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrightBrush}"/>
    </Style>
    <Style Selector="Button.small.ghost">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}"/>
    </Style>
    <Style Selector="Button.small:disabled /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
    </Style>
    <Style Selector="Button.rewrite">
        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrightBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="3"/>
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="FontSize" Value="10.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="LetterSpacing" Value="1"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.rewrite:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BgRowHoverBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrightBrush}"/>
    </Style>
    <Style Selector="Button.rewrite:disabled /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
    </Style>
</Styles>
