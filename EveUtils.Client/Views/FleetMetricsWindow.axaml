<v:ChromedWindow xmlns="https://github.com/avaloniaui" xmlns:v="using:EveUtils.Client.Views"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:EveUtils.Client.ViewModels"
        xmlns:ctl="using:EveUtils.Client.Controls"
        xmlns:fleet="using:EveUtils.Client.Fleet"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        xmlns:sys="using:System"
        mc:Ignorable="d" d:DesignWidth="720" d:DesignHeight="560"
        x:Class="EveUtils.Client.Views.FleetMetricsWindow"
        x:DataType="vm:FleetMetricsViewModel"
        x:Name="Root"
        Width="720" Height="560" MinWidth="520" MinHeight="320"
        WindowStartupLocation="CenterOwner"
        Title="Fleet metrics">

    <DockPanel Margin="14">

        <!-- On the CONTENT for the same reason the styles below are: the docked tab is handed this DockPanel, and a
             resource left on the window would not travel with it. -->
        <DockPanel.Resources>
            <!-- The narrowest a grid card may get. Measured, not chosen freely: at 318 the default 720-wide window
                 still fits two cards per row and the graph below keeps roughly the list graph's proportions instead
                 of a flattened band. A MINIMUM, not a size — the row divides whatever is left over these columns
                 (see FillGridPanel), so a card is anywhere from 318 to just under twice that. -->
            <sys:Double x:Key="FleetMetricsCardMinWidth">318</sys:Double>
        </DockPanel.Resources>

        <!-- These styles belong to the CONTENT, not to the window. Docked is the default shell: ModuleHostService
             does not show this window, it lifts this DockPanel out and reparents it into a tab in the main window.
             Anything left on the window is dropped there — and an ItemTemplate that goes missing sends every member
             row to the app-wide ViewLocator, which renders "Not Found: …DpsView" instead of the row. -->
        <DockPanel.Styles>
            <Style Selector="Button.viewtab">
                <Setter Property="FontSize" Value="9.5"/>
                <Setter Property="LetterSpacing" Value="1.4"/>
                <Setter Property="Padding" Value="11,4"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
            </Style>
            <Style Selector="Button.viewtab.active">
                <Setter Property="Foreground" Value="{StaticResource TextBrightBrush}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Style>

            <!-- ET-43's TextBlock.location / .withfc pair lives in Themes/EveUtils.axaml, not here: the DPS pop-out
                 shows the same readout from its own window and would never see a rule scoped to this screen. -->

            <!-- The place a dragged member came from stays visible, faded, for as long as you hold it: you can see
                 what you picked up, and what letting go right here would mean. The row keeps its size, so nothing
                 else on the screen shifts while you drag. Eased, so picking up and putting down read as gestures
                 rather than as the list blinking. -->
            <Style Selector="Border.memberrow">
                <Setter Property="Transitions">
                    <Transitions>
                        <DoubleTransition Property="Opacity" Duration="0:0:0.12"/>
                    </Transitions>
                </Setter>
            </Style>
            <Style Selector="Border.memberrow.dragging">
                <Setter Property="Opacity" Value="0.25"/>
            </Style>

            <!-- One materialised member list, three densities: the layout picks the item template (and, for the grid,
                 the panel) so only the chosen one is ever built. Each template's field set is deliberate — see the
                 hint line, which names what the current density drops. -->
            <Style Selector="ItemsControl.list">
                <Setter Property="ItemTemplate">
                    <Setter.Value>
                        <DataTemplate x:DataType="vm:DpsViewModel">
                            <Border Classes="panel memberrow" Classes.dragging="{Binding IsDragging}" Margin="0,0,0,8" Height="116" Cursor="SizeAll">
                                <!-- The shared fleet-member menu, mounted the same way in all three densities: which
                                     lines it holds is decided in FleetMemberMenu and how a line is drawn in the
                                     app-level item theme, so nothing about the menu itself is repeated here. -->
                                <Border.ContextMenu>
                                    <ContextMenu ItemsSource="{Binding MemberMenu}"
                                                 ItemContainerTheme="{StaticResource FleetMemberMenuItemTheme}"/>
                                </Border.ContextMenu>
                                <Grid ColumnDefinitions="174,*,Auto" Margin="12">
                                    <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Character}" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextBrightBrush}"/>
                                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto">
                                            <TextBlock Grid.Row="0" Grid.Column="0" Classes="mono" FontSize="15"
                                                       Foreground="{DynamicResource AccentBrightBrush}"
                                                       Text="{Binding Dealt, StringFormat='OUT {0}'}"/>
                                            <TextBlock Grid.Row="0" Grid.Column="1" Classes="mono" FontSize="15"
                                                       Foreground="{StaticResource RedBrush}"
                                                       Text="{Binding Received, StringFormat='IN {0}'}"/>
                                            <TextBlock Grid.Row="1" Grid.Column="0" Classes="mono" FontSize="15"
                                                       Foreground="#FF4D90FF"
                                                       Text="{Binding Cap, StringFormat='CAP {0}'}"/>
                                            <TextBlock Grid.Row="1" Grid.Column="1" Classes="mono" FontSize="15"
                                                       Foreground="#FFB07EE0"
                                                       Text="{Binding Neut, StringFormat='NEUT {0}'}"/>
                                        </Grid>
                                        <StackPanel Orientation="Horizontal" Spacing="14">
                                            <TextBlock Classes="location" Classes.withfc="{Binding IsWithCommander}"
                                                       Classes.offline="{Binding IsOffline}"
                                                       FontSize="11"
                                                       IsVisible="{Binding LocationDisplay, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                       Text="{Binding LocationDisplay, StringFormat='◉ {0}'}"
                                                       ToolTip.Tip="Current solar system (location sharing)"/>
                                            <TextBlock FontSize="11" Foreground="#FFE0B25A"
                                                       IsVisible="{Binding HasBounty}"
                                                       Text="{Binding BountyText, StringFormat='◇ {0}'}"
                                                       ToolTip.Tip="Bounty earned this session (bounty sharing)"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <ctl:DpsGraph Grid.Column="1" Margin="10,0,0,0"
                                                  Series="{Binding Series}"
                                                  Revision="{Binding GraphRevision}"
                                                  Markers="{Binding Markers}"/>
                                    <Button Grid.Column="2" Padding="8,3" Margin="10,0,0,0"
                                            VerticalAlignment="Top" ToolTip.Tip="Pop out this graph"
                                            Command="{Binding $parent[ItemsControl].((vm:FleetMetricsViewModel)DataContext).PopOutCommand}"
                                            CommandParameter="{Binding}">
                                        <mi:MaterialIcon Kind="OpenInNew"/>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Grid: cards side by side, every figure the list carries — the bounty included (ET-114). It used to be
                 the one thing this density dropped, on the argument that a session roll-up is not a live combat signal
                 and the header already totals it; the operator wants it per character in every density, so that trade
                 is off. Do not "restore" it: the per-member figure is the point. The figures sit ABOVE the graph
                 rather than beside it: squeezed into a side column the graph loses the vertical range that makes four
                 lines readable, and an unreadable graph is worth less than the members it costs. Fewer cards per
                 screen than a figures-only card is the deliberate price. -->
            <Style Selector="ItemsControl.grid">
                <Setter Property="ItemsPanel">
                    <Setter.Value>
                        <!-- Fills the row instead of leaving a strip of whitespace on the right: as many columns of
                             at least the minimum as fit, the remainder divided over them. The gaps live on the panel
                             rather than on the card's Margin, so the same arithmetic that lays the columns out is the
                             one that accounts for them. -->
                        <ItemsPanelTemplate>
                            <ctl:FillGridPanel MinItemWidth="{StaticResource FleetMetricsCardMinWidth}"
                                               ColumnSpacing="8" RowSpacing="8"/>
                        </ItemsPanelTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="ItemTemplate">
                    <Setter.Value>
                        <DataTemplate x:DataType="vm:DpsViewModel">
                            <!-- No Width and no Margin: the card takes the width and the gaps from the panel above,
                                 whose MinItemWidth is where the 318 now lives. The HEIGHT stays fixed while the width
                                 can grow to just under twice the minimum. Rendered at that widest stand (ET-108) the
                                 graph is 621x100 and all four lines are still cleanly separated — DpsGraph plots at a
                                 fixed time density, so a wider card shows a longer timeline at the same vertical
                                 range rather than the same curve stretched flat. -->
                            <Border Classes="panel memberrow" Classes.dragging="{Binding IsDragging}" Height="176" Cursor="SizeAll">
                                <Border.ContextMenu>
                                    <ContextMenu ItemsSource="{Binding MemberMenu}"
                                                 ItemContainerTheme="{StaticResource FleetMemberMenuItemTheme}"/>
                                </Border.ContextMenu>
                                <Grid RowDefinitions="Auto,Auto,*" Margin="10,8">
                                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" Spacing="1">
                                            <TextBlock Text="{Binding Character}" FontWeight="SemiBold" FontSize="11.5"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{StaticResource TextBrightBrush}"/>
                                            <!-- Location and bounty share the line, next to each other, as they do in
                                                 the list row and the pop-out. The location's column is starred so it
                                                 trims rather than push the ISK figure off a narrow card, but CAPPED so
                                                 that on the widest card (643px, ET-108) the two stay one block instead
                                                 of drifting to opposite edges. 200px is far past the longest thing
                                                 LocationDisplay produces ("◉ location unavailable"), so the cap only
                                                 ever bites on the gap, never on the text. -->
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" MaxWidth="200"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           Classes="location" Classes.withfc="{Binding IsWithCommander}"
                                                           Classes.offline="{Binding IsOffline}"
                                                           FontSize="10.5"
                                                           TextTrimming="CharacterEllipsis"
                                                           IsVisible="{Binding LocationDisplay, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                           Text="{Binding LocationDisplay, StringFormat='◉ {0}'}"
                                                           ToolTip.Tip="Current solar system (location sharing)"/>
                                                <TextBlock Grid.Column="1" FontSize="10.5" Margin="8,0,0,0"
                                                           Foreground="#FFE0B25A"
                                                           IsVisible="{Binding HasBounty}"
                                                           Text="{Binding BountyText, StringFormat='◇ {0}'}"
                                                           ToolTip.Tip="Bounty earned this session (bounty sharing)"/>
                                            </Grid>
                                        </StackPanel>
                                        <Button Grid.Column="1" Padding="6,1" Margin="8,0,0,0"
                                                VerticalAlignment="Top" ToolTip.Tip="Pop out this graph"
                                                Command="{Binding $parent[ItemsControl].((vm:FleetMetricsViewModel)DataContext).PopOutCommand}"
                                                CommandParameter="{Binding}">
                                            <mi:MaterialIcon Classes="icon-sm" Kind="OpenInNew"/>
                                        </Button>
                                    </Grid>
                                    <!-- Same four figures as the list, one size down so all four fit the card width. -->
                                    <Grid Grid.Row="1" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" Margin="0,6,0,0">
                                        <TextBlock Grid.Row="0" Grid.Column="0" Classes="mono" FontSize="12"
                                                   Foreground="{DynamicResource AccentBrightBrush}"
                                                   Text="{Binding Dealt, StringFormat='OUT {0}'}"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" Classes="mono" FontSize="12"
                                                   Foreground="{StaticResource RedBrush}"
                                                   Text="{Binding Received, StringFormat='IN {0}'}"/>
                                        <TextBlock Grid.Row="1" Grid.Column="0" Classes="mono" FontSize="12"
                                                   Foreground="#FF4D90FF"
                                                   Text="{Binding Cap, StringFormat='CAP {0}'}"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Classes="mono" FontSize="12"
                                                   Foreground="#FFB07EE0"
                                                   Text="{Binding Neut, StringFormat='NEUT {0}'}"/>
                                    </Grid>
                                    <ctl:DpsGraph Grid.Row="2" Margin="0,6,0,0" MinHeight="74"
                                                  Series="{Binding Series}"
                                                  Revision="{Binding GraphRevision}"
                                                  Markers="{Binding Markers}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Compact: one line per member, for a fleet you scan rather than read. Carries every figure the list
                 does — the four live ones and the bounty (ET-114) — and gives up only the graph: below this row height
                 a graph reads as noise, and dropping it is what buys the density. The bounty used to go with it, on
                 the argument that a session roll-up is not a live combat signal and the header already totals it; the
                 operator wants it per character in every density, so that trade is off. Do not "restore" it. The
                 pop-out stays: it is the way back to one member's graph without leaving this density. -->
            <Style Selector="ItemsControl.compact">
                <Setter Property="ItemTemplate">
                    <Setter.Value>
                        <DataTemplate x:DataType="vm:DpsViewModel">
                            <Border Classes="memberrow" Classes.dragging="{Binding IsDragging}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="10,4" Cursor="SizeAll">
                                <Border.ContextMenu>
                                    <ContextMenu ItemsSource="{Binding MemberMenu}"
                                                 ItemContainerTheme="{StaticResource FleetMemberMenuItemTheme}"/>
                                </Border.ContextMenu>
                                <!-- Identity and figures stay one tight block on the left however wide the window gets:
                                     a row you scan is a row your eye should not have to travel.

                                     Name and location are starred-with-a-cap rather than fixed at 156/116. At any
                                     width where the whole block fits they hit their caps and the row looks exactly as
                                     it did when they were fixed; below that they give ground first, so the six figures
                                     and the pop-out stay on screen instead of being silently cut off the right-hand
                                     end. That mattered once the bounty arrived (ET-114): the fixed block went from 584
                                     to 676, and measured on a docked tab the row needs ~742px where it used to need
                                     ~650 — a 720-wide tab would have lost NEUT and the pop-out button. The trailing
                                     star is what keeps the button on the right edge on a wide window; the weights
                                     decide who shrinks first when there is not enough to go round. The minimums stop
                                     that from running away: a row of figures nobody can put a name to is worth less
                                     than a trimmed name, so below ~626px the identity holds its ground and the row
                                     goes back to clipping on the right, which is what it did at those widths anyway. -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3*" MinWidth="96" MaxWidth="156"/>
                                        <ColumnDefinition Width="2*" MinWidth="64" MaxWidth="116"/>
                                        <ColumnDefinition Width="82"/>
                                        <ColumnDefinition Width="74"/>
                                        <ColumnDefinition Width="74"/>
                                        <ColumnDefinition Width="82"/>
                                        <ColumnDefinition Width="92"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Character}" FontWeight="SemiBold"
                                               FontSize="12" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{StaticResource TextBrightBrush}"/>
                                    <TextBlock Grid.Column="1" Classes="location" Classes.withfc="{Binding IsWithCommander}"
                                               Classes.offline="{Binding IsOffline}"
                                               FontSize="11" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               IsVisible="{Binding LocationDisplay, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                               Text="{Binding LocationDisplay, StringFormat='◉ {0}'}"
                                               ToolTip.Tip="Current solar system (location sharing)"/>
                                    <TextBlock Grid.Column="2" Classes="mono" FontSize="12" VerticalAlignment="Center"
                                               HorizontalAlignment="Right"
                                               Foreground="{DynamicResource AccentBrightBrush}"
                                               Text="{Binding Dealt, StringFormat='OUT {0}'}"/>
                                    <TextBlock Grid.Column="3" Classes="mono" FontSize="12" VerticalAlignment="Center"
                                               HorizontalAlignment="Right"
                                               Foreground="{StaticResource RedBrush}"
                                               Text="{Binding Received, StringFormat='IN {0}'}"/>
                                    <TextBlock Grid.Column="4" Classes="mono" FontSize="12" VerticalAlignment="Center"
                                               HorizontalAlignment="Right"
                                               Foreground="#FF4D90FF"
                                               Text="{Binding Cap, StringFormat='CAP {0}'}"/>
                                    <TextBlock Grid.Column="5" Classes="mono" FontSize="12" VerticalAlignment="Center"
                                               HorizontalAlignment="Right"
                                               Foreground="#FFB07EE0"
                                               Text="{Binding Neut, StringFormat='NEUT {0}'}"/>
                                    <!-- A FIXED column, not Auto: every row builds its own grid, so an Auto column
                                         would take the chip's own ~70px on a member who has earned something and 0 on
                                         the member below him, and everything to its right would step sideways row by
                                         row. Right-aligned like the figures it follows, at the location's font rather
                                         than the mono of the live figures — it is a session roll-up and reads as the
                                         same chip the list and the pop-out show. 92 is the widest thing CompactIsk
                                         can produce ("◇ 999.99B ISK", ~78) plus a gutter in the figures' own key. -->
                                    <TextBlock Grid.Column="6" FontSize="11" VerticalAlignment="Center"
                                               HorizontalAlignment="Right"
                                               Foreground="#FFE0B25A"
                                               IsVisible="{Binding HasBounty}"
                                               Text="{Binding BountyText, StringFormat='◇ {0}'}"
                                               ToolTip.Tip="Bounty earned this session (bounty sharing)"/>
                                    <Button Grid.Column="8" Padding="6,0" Margin="10,0,0,0"
                                            VerticalAlignment="Center" ToolTip.Tip="Pop out this graph"
                                            Command="{Binding $parent[ItemsControl].((vm:FleetMetricsViewModel)DataContext).PopOutCommand}"
                                            CommandParameter="{Binding}">
                                        <mi:MaterialIcon Classes="icon-sm" Kind="OpenInNew"/>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </DockPanel.Styles>

        <!-- Header: fleet name + roll-up totals -->
        <Border DockPanel.Dock="Top" Classes="panel" Padding="14,12" Margin="0,0,0,12">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="FLEET METRICS" Classes="label" FontSize="9"/>
                    <TextBlock Text="{Binding FleetName}" FontWeight="Bold" FontSize="15"
                               Foreground="{StaticResource TextBrightBrush}"/>
                    <!-- How much of the fleet stands with the FC. Header-level on purpose: it stays put whichever
                         layout the member list below takes. -->
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                        <Border Classes="chip" Classes.good="{Binding CommanderPresence.IsComplete}"
                                Classes.dim="{Binding CommanderPresence.IsUnknown}"
                                ToolTip.Tip="{Binding CommanderPresence.Tooltip}">
                            <TextBlock Text="{Binding CommanderPresence.BadgeText}"/>
                        </Border>
                        <!-- The whole fleet as a pop-out, beside the per-member pop-out buttons in the rows below and
                             marked the same way (ET-72). -->
                        <Button x:Name="PopOutFleetButton" FontSize="9.5" LetterSpacing="1.2"
                                Padding="8,2" VerticalAlignment="Center"
                                Command="{Binding PopOutFleetCommand}"
                                ToolTip.Tip="Pop the fleet out: an always-on-top overlay with the WITH FC ratio, who is taking the most damage and who is being neuted the most">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <mi:MaterialIcon Classes="icon-sm" Kind="OpenInNew"/>
                                <TextBlock Text="FLEET" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
                <Grid Grid.Column="1" ColumnDefinitions="Auto,Auto,Auto,Auto,Auto" VerticalAlignment="Center">
                    <StackPanel Grid.Column="0" Spacing="1" Margin="0,0,18,0" HorizontalAlignment="Right">
                        <TextBlock Text="DEALT" Classes="label" FontSize="9" HorizontalAlignment="Right"/>
                        <TextBlock Text="{Binding DealtTotal}" Classes="mono" FontSize="18"
                                   Foreground="{DynamicResource AccentBrightBrush}" HorizontalAlignment="Right"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="1" Margin="0,0,18,0" HorizontalAlignment="Right">
                        <TextBlock Text="RECEIVED" Classes="label" FontSize="9" HorizontalAlignment="Right"/>
                        <TextBlock Text="{Binding ReceivedTotal}" Classes="mono" FontSize="18"
                                   Foreground="{DynamicResource TextAccentBrush}" HorizontalAlignment="Right"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="1" Margin="0,0,18,0" HorizontalAlignment="Right">
                        <TextBlock Text="MINING" Classes="label" FontSize="9" HorizontalAlignment="Right"/>
                        <TextBlock Text="{Binding MiningTotal}" Classes="mono" FontSize="18"
                                   Foreground="{StaticResource TextDimBrush}" HorizontalAlignment="Right"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3" Spacing="1" Margin="0,0,18,0" HorizontalAlignment="Right">
                        <TextBlock Text="BOUNTY" Classes="label" FontSize="9" HorizontalAlignment="Right"/>
                        <TextBlock Text="{Binding BountyTotal}" Classes="mono" FontSize="18"
                                   Foreground="{StaticResource TextDimBrush}" HorizontalAlignment="Right"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4" Spacing="1" HorizontalAlignment="Right">
                        <TextBlock Text="NEUT" Classes="label" FontSize="9" HorizontalAlignment="Right"/>
                        <TextBlock Text="{Binding NeutTotal}" Classes="mono" FontSize="18"
                                   Foreground="{StaticResource TextDimBrush}" HorizontalAlignment="Right"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- Density switcher + the hint that names what this density leaves out. -->
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="2,0,0,6">
            <TextBlock Grid.Column="0" Text="{Binding LayoutHint}" VerticalAlignment="Center"
                       FontSize="11" Foreground="{DynamicResource TextAccentBrush}" TextWrapping="Wrap"/>
            <Border Grid.Column="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    VerticalAlignment="Center" Margin="12,0,0,0">
                <StackPanel Orientation="Horizontal">
                    <Button Content="LIST" Classes="viewtab" Classes.active="{Binding IsListLayout}"
                            ToolTip.Tip="Full rows: every figure plus the live graph"
                            Command="{Binding SetLayoutCommand}"
                            CommandParameter="{x:Static fleet:FleetMetricsLayout.List}"/>
                    <Button Content="GRID" Classes="viewtab" Classes.active="{Binding IsGridLayout}"
                            ToolTip.Tip="Cards side by side: name, DPS out/in, location and the graph"
                            Command="{Binding SetLayoutCommand}"
                            CommandParameter="{x:Static fleet:FleetMetricsLayout.Grid}"/>
                    <Button Content="COMPACT" Classes="viewtab" Classes.active="{Binding IsCompactLayout}"
                            ToolTip.Tip="One line per member: name, DPS out/in and location"
                            Command="{Binding SetLayoutCommand}"
                            CommandParameter="{x:Static fleet:FleetMetricsLayout.Compact}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Legend for the live combat lines (colours match DpsViewModel's series); nothing to legend without graphs. -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="16" Margin="2,0,0,10"
                    IsVisible="{Binding ShowsGraphs}">
            <StackPanel Orientation="Horizontal" Spacing="5">
                <Border Width="14" Height="3" VerticalAlignment="Center" Background="{DynamicResource AccentBrightBrush}"/>
                <TextBlock Text="DPS out" FontSize="10" Foreground="{StaticResource TextDimBrush}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="5">
                <Border Width="14" Height="3" VerticalAlignment="Center" Background="#FFEF5A5A"/>
                <TextBlock Text="DPS in" FontSize="10" Foreground="{StaticResource TextDimBrush}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="5">
                <Border Width="14" Height="3" VerticalAlignment="Center" Background="#FFB07EE0"/>
                <TextBlock Text="Neut" FontSize="10" Foreground="{StaticResource TextDimBrush}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="5">
                <Border Width="14" Height="3" VerticalAlignment="Center" Background="#FF4D90FF"/>
                <TextBlock Text="Cap" FontSize="10" Foreground="{StaticResource TextDimBrush}"/>
            </StackPanel>
        </StackPanel>

        <!-- The member list, with the drag layer floating over it. The layer never takes a hit, so a drag still
             sees the rows underneath it. -->
        <Panel ClipToBounds="True">
            <ScrollViewer>
                <ItemsControl x:Name="MemberList" ItemsSource="{Binding Members}"
                              Classes.list="{Binding IsListLayout}"
                              Classes.grid="{Binding IsGridLayout}"
                              Classes.compact="{Binding IsCompactLayout}"/>
            </ScrollViewer>

            <Canvas x:Name="DragLayer" IsHitTestVisible="False">
                <!-- What you are holding. It borrows the list's own item template, so the thing under the cursor is
                     the row or card you picked up, in whichever density is showing — and it sits on its own opaque
                     backdrop with an accent edge and a shadow, so it reads as a card lifted off the list rather than
                     as a smear over the one underneath. -->
                <Border x:Name="DragGhost" IsVisible="False" Opacity="0.93"
                        Background="{DynamicResource BgDeepBrush}"
                        BorderBrush="{DynamicResource AccentBrightBrush}" BorderThickness="1"
                        BoxShadow="0 10 26 0 #C0000000">
                    <Border.RenderTransform>
                        <ScaleTransform ScaleX="1.03" ScaleY="1.03"/>
                    </Border.RenderTransform>
                    <ContentControl x:Name="DragGhostContent"
                                    ContentTemplate="{Binding #MemberList.ItemTemplate}"/>
                </Border>
                <!-- Where the member lands if you let go now: a line between two rows, or between two cards. Drawn
                     last, so it stays readable across the ghost — the card in your hand must never hide the answer
                     to "where does this end up". -->
                <Border x:Name="DropMarker" IsVisible="False" CornerRadius="1.5"
                        Background="{DynamicResource AccentBrightBrush}"/>
            </Canvas>
        </Panel>
    </DockPanel>
</v:ChromedWindow>
