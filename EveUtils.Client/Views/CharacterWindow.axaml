<v:ChromedWindow xmlns="https://github.com/avaloniaui" xmlns:v="using:EveUtils.Client.Views"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:EveUtils.Client.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        mc:Ignorable="d" d:DesignWidth="470" d:DesignHeight="560"
        x:Class="EveUtils.Client.Views.CharacterWindow"
        x:DataType="vm:CharacterDialogViewModel"
        x:Name="Root"
        Width="470" Height="560"
        WindowStartupLocation="CenterOwner"
        Title="Character">

    <DockPanel Margin="16">

        <!-- Header: identity + ESI status -->
        <StackPanel DockPanel.Dock="Top" Spacing="3" Margin="0,0,0,12">
            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="16"
                       Foreground="{StaticResource TextBrightBrush}"/>
            <TextBlock Text="{Binding EsiStatus}" FontSize="11"
                       Foreground="{DynamicResource TextAccentBrush}"/>
        </StackPanel>

        <!-- Footer: transient status + Close -->
        <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto" Margin="0,12,0,0">
            <TextBlock Grid.Column="0" Text="{Binding Status}" FontSize="10" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextAccentBrush}" TextWrapping="Wrap"/>
            <Button Grid.Column="1" Content="Close" Click="OnClose" Classes="accent"/>
        </Grid>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="14">

                <!-- Local-only (no ESI, D-129): DPS is visible, but server features need an ESI sign-in first. -->
                <Border Classes="panel" Padding="10,8" IsVisible="{Binding IsLocalOnly}">
                    <TextBlock Text="Local-only character — seen in a gamelog. Its DPS is tracked locally. Sign in with ESI from the main window to couple it to a server."
                               FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextAccentBrush}"/>
                </Border>

                <!-- ESI scopes — re-authenticate via the same scope-selection popup as sign-in (D-88); the user picks
                     which scopes to grant. Data-driven from the scope registry, so it scales as new scopes are added
                     (replaces the former per-scope "+ ADD" buttons). -->
                <StackPanel Spacing="5" IsVisible="{Binding CanCouple}">
                    <TextBlock Text="ESI SCOPES" Classes="label" FontSize="9"/>
                    <!-- The tooltip answers the question this block used to leave open: what does it share right now?
                         Read from the stored grant, so a scope the app wants but never got does not appear. -->
                    <TextBlock Text="Choose which ESI data this character shares — hover to see what it shares now."
                               FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextAccentBrush}"
                               ToolTip.Tip="{Binding ScopesTooltip}"/>
                    <Button Content="Re-authenticate…" FontSize="10"
                            Command="{Binding ReAuthenticateCommand}"/>
                </StackPanel>

                <Separator IsVisible="{Binding CanCouple}"/>

                <!-- Coupled servers (D-105/D-109/D-114) -->
                <StackPanel Spacing="6" IsVisible="{Binding CanCouple}">
                    <TextBlock Text="COUPLED SERVERS" Classes="label" FontSize="9"/>
                    <ItemsControl ItemsSource="{Binding ServerLinks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ServerLinkViewModel">
                                <Border Classes="panel" Padding="8,5" Margin="0,0,0,4">
                                    <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                                        <StackPanel Grid.Column="0" Spacing="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextBrightBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding StatusLabel}" FontSize="10"
                                                       Foreground="{DynamicResource TextAccentBrush}"/>
                                        </StackPanel>
                                        <!-- Only when the server has dropped the session: the way back has to be on the
                                             row that says it is broken, not somewhere the user has to go and find. -->
                                        <Button Grid.Column="1" Classes="rowaction" Content="COUPLE AGAIN" FontSize="9"
                                                Padding="8,2" Margin="6,0,0,0" VerticalAlignment="Center"
                                                IsVisible="{Binding CanRecouple}"
                                                Command="{Binding RecoupleCommand}"
                                                ToolTip.Tip="This server no longer has a session for this character — sign in again to restore the coupling."/>
                                        <Button Grid.Column="2" Classes="rowaction" Padding="8,2" Margin="6,0,0,0"
                                                VerticalAlignment="Center"
                                                Command="{Binding ViewTrustCommand}"
                                                ToolTip.Tip="Server info + cert fingerprint (out-of-band trust check, SEC-13).">
                                            <mi:MaterialIcon Kind="CogOutline"/>
                                        </Button>
                                        <Button Grid.Column="3" Classes="rowaction" Content="DECOUPLE" FontSize="9" Padding="8,2" Margin="4,0,0,0"
                                                VerticalAlignment="Center"
                                                Command="{Binding DecoupleCommand}"
                                                ToolTip.Tip="Revoke this character's session on the server and disconnect (D-109)."/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button HorizontalAlignment="Left"
                            Command="{Binding CoupleCommand}"
                            ToolTip.Tip="Couple this character to a server: enter the address + an optional label, then log in via EVE SSO.">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <mi:MaterialIcon Kind="CloudPlusOutline"/>
                            <TextBlock Text="Couple to server" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Remove character (ET-345): destructive, so last. The confirmation opens in place; an active fleet this
                     character commands answers the click with the way out instead. -->
                <Separator IsVisible="{Binding CanRemove}"/>
                <StackPanel Spacing="8" IsVisible="{Binding CanRemove}">
                    <Button Classes="danger" HorizontalAlignment="Left" Content="Remove character…"
                            IsVisible="{Binding !IsConfirmingRemoval}"
                            Command="{Binding RemoveCharacterCommand}"
                            ToolTip.Tip="Remove this character from this PC: decouple it from its servers, sign it out at CCP and delete its local data."/>
                    <TextBlock Text="{Binding RemovalBlockedReason}" IsVisible="{Binding IsRemovalBlocked}"
                               FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource TextBrush}"/>
                    <Border x:Name="RemovalConfirmation" Classes="panel" Padding="10,8" BorderBrush="{StaticResource RedBrush}"
                            IsVisible="{Binding IsConfirmingRemoval}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{Binding RemovalQuestion}" FontWeight="SemiBold" TextWrapping="Wrap"
                                       Foreground="{StaticResource TextBrightBrush}"/>
                            <TextBlock Text="{Binding RemovalExplanation}" FontSize="11" TextWrapping="Wrap"
                                       Foreground="{StaticResource TextBrush}"/>
                            <TextBlock Text="Its open run is stopped first." FontSize="11"
                                       IsVisible="{Binding RemovalStopsOpenRun}"
                                       Foreground="{StaticResource WarnBrush}"/>
                            <CheckBox Content="Also delete this character's runs and fittings" FontSize="11"
                                      IsChecked="{Binding DeleteRunsAndFittings}"/>
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                <Button Content="Cancel" Command="{Binding CancelRemovalCommand}"
                                        IsEnabled="{Binding !ConfirmRemovalCommand.IsRunning}"/>
                                <Button Classes="danger" Content="Remove" Command="{Binding ConfirmRemovalCommand}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</v:ChromedWindow>
