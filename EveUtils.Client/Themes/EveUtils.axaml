<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:EveUtils.Client.Views"
        xmlns:ctl="using:EveUtils.Client.Controls"
        xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia">

    <Styles.Resources>

        <!-- EVE-Utils design tokens. The neutral text/structural tokens live here; the faction-swappable tokens
             (accent ramp, borders, dividers, glow, row hover/select, header/window gradients, hex brand, rail bg)
             live in Themes/Factions/*.axaml and are merged into Application.Resources by ThemeService (D-183).
             Style setters that consume a swappable token use DynamicResource so a faction swap re-tints live. -->
        <Color x:Key="BgDeepColor">#FF06070A</Color>
        <Color x:Key="BgDeep1Color">#FF030806</Color>
        <Color x:Key="BgDeep2Color">#FF060D0A</Color>

        <SolidColorBrush x:Key="BgDeepBrush" Color="#FF06070A"/>
        <SolidColorBrush x:Key="BgPanelBrush" Color="#F00C100E"/>
        <SolidColorBrush x:Key="BgHeaderBrush" Color="#14000000"/>
        <SolidColorBrush x:Key="BgRowBrush" Color="#05FFFFFF"/>
        <SolidColorBrush x:Key="BgRowAltBrush" Color="#0AFFFFFF"/>

        <!-- A surface that lies OVER the screen rather than in it (ET-291): the runs drawer, and the pinned day
             header that floats above the list. Opaque, unlike BgPanelBrush's 94 %, which let the list show through
             a drawer and took its dim labels below 4.5:1. Neutral in all four factions, like the ink of the ISK
             sources above: what a surface means must not change when the accent does. -->
        <SolidColorBrush x:Key="DrawerSurfaceBrush" Color="#FF0C100E"/>
        <!-- What dims the list behind the drawer. Dark enough that the drawer's own edge reads against it in every
             theme, sheer enough that the selected row stays visible underneath — closing by clicking the list you
             can still see is the whole reason the drawer is 430 px and not the full width (Jithran, 15 Sep). -->
        <SolidColorBrush x:Key="ScrimBrush" Color="#AD02050A"/>
        <!-- A day in the runs activity strip with nothing to shade (ET-292): there, but quieter than any evening that
             earned something. Neutral, since the shaded days are the accent's. -->
        <SolidColorBrush x:Key="StripEmptyBrush" Color="#0DFFFFFF"/>

        <SolidColorBrush x:Key="TextBrush" Color="#FFD8D0C4"/>
        <SolidColorBrush x:Key="TextDimBrush" Color="#FF8A7E6B"/>
        <SolidColorBrush x:Key="TextBrightBrush" Color="#FFF3ECE0"/>
        <!-- Dim text at 9–12 px (ET-292): TextDimBrush measured 4.3–4.5:1 off the renders on the runs strip's weekday
             and legend labels, and 3.5 on the range line's ✕ — an antialiased glyph that small never reaches its own
             colour. The same step below TextBrush the runs pane already carries (ET-291), measured 6.6:1 nominal. -->
        <SolidColorBrush x:Key="TextDimSmallBrush" Color="#FFA0958A"/>

        <!-- Where ISK came from (ET-290, IskSourceBar): one fixed ink per source, the same in every faction theme, so
             a colour names the same source wherever it is drawn. -->
        <SolidColorBrush x:Key="IskBountyBrush" Color="#FFC98500"/>
        <SolidColorBrush x:Key="IskLootBrush" Color="#FF3987E5"/>
        <SolidColorBrush x:Key="IskPayoutBrush" Color="#FF199E70"/>
        <SolidColorBrush x:Key="IskRewardBrush" Color="#FFD55181"/>
        <SolidColorBrush x:Key="IskMiningBrush" Color="#FF9085E9"/>

        <SolidColorBrush x:Key="ValueBrush" Color="#FFF5B042"/>
        <SolidColorBrush x:Key="GreenBrush" Color="#FF4ADE80"/>
        <SolidColorBrush x:Key="RedBrush" Color="#FFEF5A5A"/>
        <SolidColorBrush x:Key="BlueBrush" Color="#FF38BDF8"/>
        <SolidColorBrush x:Key="MagentaBrush" Color="#FFC084FC"/>
        <!-- Same amber as Border.chip.warn below, as a named brush: Border.statuscard.warn needs it as a Setter
             value rather than an attached-property string, which the chip's own warn rule works around locally
             instead (ET-200 — promoted here from what used to be FleetsWindow.axaml's own local WarnBrush). -->
        <SolidColorBrush x:Key="WarnBrush" Color="#FFE0B341"/>

        <FontFamily x:Key="MonoFont">Consolas, Cascadia Mono, monospace</FontFamily>

        <!-- The pop-out title bar's three shapes were StreamGeometry here (ET-73) because the app owned no icon set.
             They come from Material now (ET-74) — see Themes/Icons.axaml, which is the only place an icon comes from. -->
    </Styles.Resources>

    <!-- ── Window ── -->
    <Style Selector="Window">
        <Setter Property="Background" Value="{DynamicResource WindowBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>


    <!-- ── Panel (window chrome box) ── -->
    <Style Selector="Border.panel">
        <Setter Property="Background" Value="{StaticResource BgPanelBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BoxShadow" Value="0 12 32 0 #73000000"/>
    </Style>

    <!-- ── Panel title bar ── -->
    <Style Selector="Border.panel-header">
        <Setter Property="Background" Value="{DynamicResource HeaderGradientBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Padding" Value="12,7"/>
    </Style>

    <Style Selector="TextBlock.panel-title">
        <Setter Property="Foreground" Value="{StaticResource TextBrightBrush}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="LetterSpacing" Value="2.2"/>
    </Style>

    <Style Selector="TextBlock.diamond">
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="FontSize" Value="9"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- ── Section / field labels ── -->
    <Style Selector="TextBlock.label">
        <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="LetterSpacing" Value="1.8"/>
    </Style>

    <Style Selector="TextBlock.metric">
        <Setter Property="Foreground" Value="{DynamicResource AccentBrightBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style Selector="TextBlock.mono">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    </Style>

    <!-- ── Buttons ── -->
    <Style Selector="Button">
        <Setter Property="Background" Value="#22FFFFFF"/>
        <Setter Property="Foreground" Value="{DynamicResource TextAccentBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="Padding" Value="14,7"/>
        <Setter Property="FontSize" Value="11"/>
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrightBrush}"/>
    </Style>
    <Style Selector="Button:disabled /template/ ContentPresenter">
        <Setter Property="Background" Value="#08FFFFFF"/>
        <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
    </Style>
    <!-- Destructive / terminal action (e.g. CONCLUDE) — red so it stands out from neutral/accent buttons. -->
    <Style Selector="Button.danger">
        <Setter Property="Foreground" Value="{StaticResource RedBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource RedBrush}"/>
    </Style>
    <Style Selector="Button.danger:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#22EF5A5A"/>
        <Setter Property="BorderBrush" Value="{StaticResource RedBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrightBrush}"/>
    </Style>
    <!-- Affirmative action (e.g. an invite Accept) — green so it reads as the positive choice next to a red Decline. -->
    <Style Selector="Button.good">
        <Setter Property="Foreground" Value="{StaticResource GreenBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource GreenBrush}"/>
    </Style>
    <Style Selector="Button.good:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#224ADE80"/>
        <Setter Property="BorderBrush" Value="{StaticResource GreenBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrightBrush}"/>
    </Style>
    <!-- Inside an action toast the affirmative/destructive buttons are FILLED (not just outlined) so the choice
         reads at a glance; scoped to .toast-action so the shared .danger button (e.g. CONCLUDE) stays outline-only. -->
    <Style Selector="Button.toast-action.good">
        <Setter Property="Background" Value="{StaticResource GreenBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource GreenBrush}"/>
        <Setter Property="Foreground" Value="#FF06070A"/>
    </Style>
    <!-- The dark label has to be set on the ContentPresenter, the way the pointerover rule already does: set on the
         button alone it never reaches the text, which stayed white on the green at 1.74:1 where 4.5:1 is the floor.
         Dark on this green measures 11.56:1. -->
    <Style Selector="Button.toast-action.good /template/ ContentPresenter">
        <Setter Property="Foreground" Value="#FF06070A"/>
    </Style>
    <Style Selector="Button.toast-action.good:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#FF6BE89B"/>
        <Setter Property="Foreground" Value="#FF06070A"/>
    </Style>
    <Style Selector="Button.toast-action.danger">
        <Setter Property="Background" Value="{StaticResource RedBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource RedBrush}"/>
        <Setter Property="Foreground" Value="#FF06070A"/>
    </Style>
    <Style Selector="Button.toast-action.danger /template/ ContentPresenter">
        <Setter Property="Foreground" Value="#FF06070A"/>
    </Style>
    <Style Selector="Button.toast-action.danger:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#FFF47A7A"/>
        <Setter Property="Foreground" Value="#FF06070A"/>
    </Style>
    <!-- Accent (primary) action, e.g. Settings Save -->
    <Style Selector="Button.accent">
        <Setter Property="Foreground" Value="{StaticResource TextBrightBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
    </Style>

    <!-- Buttons that sit side by side at the end of a list row (ET-82). Left to themselves an icon button and a text
         button take their height from their own content — a 14px icon against ~12px of 9pt text — and end up two
         boxes of different height in the same row. The height belongs to the row, not to what each button happens to
         contain, so it is set here once: 24 also keeps a one-glyph button a comfortable click target.

         The alignment is half the rule, not decoration. A button here is deliberately TALLER than what it holds, and
         this app's buttons content-align to Stretch — so the label is handed the whole content box and draws its line
         at the top of it, leaving the gap underneath. An icon escapes that only because mi|MaterialIcon carries its
         own VerticalAlignment=Center (Themes/Icons.axaml); text has no such rule of its own. Before a shared height
         the box fitted the content exactly and Stretch was invisible, which is why this surfaced with the MinHeight
         rather than before it. -->
    <Style Selector="Button.rowaction">
        <Setter Property="MinHeight" Value="24"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
    </Style>

    <!-- Compact icon-only destructive button (e.g. inbox delete). Borderless line-icon that reads clearly at rest
         (accent text) and turns red with a soft fill on hover. The icon inherits the state colour, so the hover ink
         has to sit on the ContentPresenter: the plain Button:pointerover rule above already sets a bright Foreground
         there, and a red one on the button itself would never reach past it. -->
    <Style Selector="Button.trash">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="3"/>
        <Setter Property="Padding" Value="6,4"/>
        <Setter Property="Foreground" Value="{DynamicResource TextAccentBrush}"/>
    </Style>
    <Style Selector="Button.trash:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#22EF5A5A"/>
        <Setter Property="Foreground" Value="{StaticResource RedBrush}"/>
    </Style>

    <!-- Server-group header (D-105 multi-server aggregation): a section header above each coupled server's fleets. -->
    <Style Selector="Border.server-group-header">
        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Padding" Value="6,3"/>
        <Setter Property="Margin" Value="0,2,0,3"/>
    </Style>
    <Style Selector="TextBlock.server-group-title">
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="9"/>
        <Setter Property="LetterSpacing" Value="1.5"/>
        <Setter Property="Foreground" Value="{DynamicResource TextAccentBrush}"/>
    </Style>

    <!-- ── TextBox ── -->
    <Style Selector="TextBox">
        <Setter Property="Background" Value="#0AFFFFFF"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
    </Style>

    <!-- ── ListBox ── -->
    <Style Selector="ListBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
    </Style>
    <Style Selector="ListBoxItem">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BgRowHoverBrush}"/>
    </Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BgRowSelectedBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrightBrush}"/>
    </Style>

    <!-- ── TabControl ── -->
    <Style Selector="TabControl">
        <Setter Property="Padding" Value="0"/>
    </Style>
    <!-- Tint only the tab STRIP (the TabControl's own header panel, inside its template), not every WrapPanel that
         happens to live in tab CONTENT — a bare "TabControl WrapPanel" descendant selector also matched content
         WrapPanels (e.g. the composition cards' hull thumbnails + role chips), painting a 25% black band over them. -->
    <Style Selector="TabControl /template/ WrapPanel">
        <Setter Property="Background" Value="#40000000"/>
    </Style>
    <Style Selector="TabItem">
        <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,1,0"/>
    </Style>
    <Style Selector="TabItem:selected">
        <Setter Property="Foreground" Value="{StaticResource TextBrightBrush}"/>
        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
    </Style>
    <Style Selector="TabItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
    </Style>

    <!-- ── ProgressBar (fleet bars) ── -->
    <Style Selector="ProgressBar">
        <Setter Property="MinHeight" Value="9"/>
        <Setter Property="Height" Value="9"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="Background" Value="#14FFFFFF"/>
    </Style>

    <!-- ── Status chips (module-shell mockup): small rounded pills for the character card's ESI / server /
         implant badges. Variants: .ok = healthy accent (mockup .chip.esi), .warn = needs attention (amber),
         .good = target reached (green), .dim = inert ("not signed in"). Faction-swappable colours via DynamicResource. ── -->
    <!-- Size and ink are set on the chip as INHERITED text properties rather than on a direct TextBlock child: a chip
         may now hold an icon beside its label (ET-74), and a "> TextBlock" rule reaches neither the icon nor a label
         that has been wrapped in a row to sit next to one. -->
    <Style Selector="Border.chip">
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="7,1,7,2"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextElement.FontSize" Value="9.5"/>
        <Setter Property="TextElement.Foreground" Value="{DynamicResource TextAccentBrush}"/>
    </Style>
    <Style Selector="Border.chip > TextBlock">
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Border.chip.ok">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="TextElement.Foreground" Value="{DynamicResource AccentBrightBrush}"/>
    </Style>
    <!-- The amber is a brush element, not the string "#FFE0B341": an attached-property setter carries no target type
         for the string converter to work from, so the literal silently resolved to nothing and the chip's icon and
         label stayed at the resting accent — a warning chip that read as a healthy one. -->
    <Style Selector="Border.chip.warn">
        <Setter Property="BorderBrush" Value="#8CE0B341"/>
        <Setter Property="TextElement.Foreground">
            <SolidColorBrush Color="#FFE0B341"/>
        </Setter>
    </Style>
    <!-- Red, not amber: something the user has to act on (a server pairing that has lapsed and needs re-pairing),
         as opposed to .warn's "not healthy, but it is fixing itself". -->
    <Style Selector="Border.chip.danger">
        <Setter Property="BorderBrush" Value="{StaticResource RedBrush}"/>
        <Setter Property="TextElement.Foreground" Value="{StaticResource RedBrush}"/>
    </Style>
    <Style Selector="Border.chip.good">
        <Setter Property="BorderBrush" Value="{StaticResource GreenBrush}"/>
        <Setter Property="TextElement.Foreground" Value="{StaticResource GreenBrush}"/>
    </Style>
    <Style Selector="Border.chip.dim">
        <Setter Property="TextElement.Foreground" Value="{StaticResource TextDimBrush}"/>
    </Style>
    <!-- The escalation chip (RO-0/ET-289): the value colour, same amber every other figure in this app uses for
         something the pilot earned or is owed — an escalation is exactly that, a site handed to them. -->
    <Style Selector="Border.chip.esc">
        <Setter Property="BorderBrush" Value="{StaticResource ValueBrush}"/>
        <Setter Property="TextElement.Foreground" Value="{StaticResource ValueBrush}"/>
    </Style>

    <!-- A chip's icon rides at the label's size, not the app default: a chip is 9.5px text, and a 14px icon beside it
         would be the loudest thing on the character card. -->
    <Style Selector="Border.chip mi|MaterialIcon">
        <Setter Property="Width" Value="11"/>
        <Setter Property="Height" Value="11"/>
    </Style>

    <!-- A pilot's hexagon without a portrait: the initial on the soft accent, re-tinted live with the faction. -->
    <Style Selector="ctl|HexPortrait">
        <Setter Property="Fill" Value="{DynamicResource AccentSoftBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AccentBrightBrush}"/>
    </Style>
    <!-- A stack keeps a thin gap of the panel's own colour between two faces that overlap. -->
    <Style Selector="ctl|HexStack">
        <Setter Property="Fill" Value="{DynamicResource AccentSoftBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AccentBrightBrush}"/>
        <Setter Property="Ring" Value="#FF0C100E"/>
    </Style>

    <!-- ── Combat meters (ET-277, design D): the rows of CombatMeters, the UNDER FIRE / NEUTED flags and the
         application verdict chip. In the theme, not on a screen, because the fleet screen (docked or floating) and the
         DPS pop-out all show them and a pop-out inherits nothing (ET-43). None of it takes the faction accent: the
         combat inks are fixed (Controls/CombatInk), and so are these. ── -->
    <Style Selector="Grid.meterrow">
        <Setter Property="Height" Value="17"/>
    </Style>
    <Style Selector="TextBlock.meterlabel">
        <Setter Property="FontSize" Value="9"/>
        <Setter Property="LetterSpacing" Value="1.1"/>
        <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="ctl|MeterBar.meter">
        <Setter Property="Height" Value="7"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="TextBlock.meterfigure">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrightBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="TextBlock.meterdetail">
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="8,0,0,0"/>
    </Style>
    <Style Selector="StackPanel > TextBlock.meterdetail">
        <Setter Property="Margin" Value="0"/>
    </Style>
    <Style Selector="Grid.meterrow > StackPanel">
        <Setter Property="Margin" Value="8,0,0,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style Selector="Border.flag">
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="2"/>
        <Setter Property="Padding" Value="4,0,4,1"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextElement.FontSize" Value="8.5"/>
        <Setter Property="TextElement.FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="Border.flag.fire">
        <Setter Property="BorderBrush" Value="{x:Static ctl:CombatInk.In}"/>
        <Setter Property="Background" Value="#1FEF5A5A"/>
        <Setter Property="TextElement.Foreground" Value="{x:Static ctl:CombatInk.In}"/>
    </Style>
    <Style Selector="Border.flag.neut">
        <Setter Property="BorderBrush" Value="{x:Static ctl:CombatInk.Neut}"/>
        <Setter Property="Background" Value="#249085E9"/>
        <Setter Property="TextElement.Foreground">
            <SolidColorBrush Color="#FFB9B1F2"/>
        </Setter>
    </Style>

    <!-- The verdict chip is status, not a series: glyph + word + colour, never colour alone. SWEET SPOT green, OK the
         neutral text ink, ADJUST the app's warning amber, and "not enough shots" / "n/a" dim. -->
    <Style Selector="Border.verdict">
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="7,1,7,2"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextElement.FontSize" Value="9.5"/>
        <Setter Property="TextElement.FontWeight" Value="SemiBold"/>
        <Setter Property="BorderBrush" Value="#73D8D0C4"/>
        <Setter Property="Background" Value="#0FD8D0C4"/>
        <Setter Property="TextElement.Foreground" Value="{StaticResource TextBrush}"/>
    </Style>
    <Style Selector="Border.verdict.sweet">
        <Setter Property="BorderBrush" Value="{StaticResource GreenBrush}"/>
        <Setter Property="Background" Value="#1A4ADE80"/>
        <Setter Property="TextElement.Foreground" Value="{StaticResource GreenBrush}"/>
    </Style>
    <Style Selector="Border.verdict.adjust">
        <Setter Property="BorderBrush" Value="{StaticResource WarnBrush}"/>
        <Setter Property="Background" Value="#1FE0B341"/>
        <Setter Property="TextElement.Foreground" Value="{StaticResource WarnBrush}"/>
    </Style>
    <Style Selector="Border.verdict.unjudged">
        <Setter Property="BorderBrush" Value="#808A7E6B"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="TextElement.Foreground" Value="{StaticResource TextDimBrush}"/>
        <Setter Property="TextElement.FontWeight" Value="Normal"/>
    </Style>

    <!-- A card's left edge reports its state, as in design D: red while under fire, violet while neuted. -->
    <Style Selector="Border.cardedge">
        <Setter Property="Width" Value="3"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="Border.cardedge.neuted">
        <Setter Property="Background" Value="{x:Static ctl:CombatInk.Neut}"/>
    </Style>
    <Style Selector="Border.cardedge.underfire">
        <Setter Property="Background" Value="{x:Static ctl:CombatInk.In}"/>
    </Style>

    <!-- ── Status card: one card per character, naming what is true of them right now (ET-200) ──
         Application-level because it is not one screen's idea: Fleets' "who is in an active fleet right now" band
         and Runs' "who is tracking what right now" band are the same shape — a bordered card, a coloured left edge
         for the state, a name/what/where text stack, a big monospace clock — laid out with FillGridPanel. Moved
         here from FleetsWindow.axaml (ET-161/ET-170), which had the only copy, rather than let Runs stand up a
         second one beside it (ET-200). Named for the job, not for either caller: neither screen owns "lane".

         The default (no modifier) is the state a screen cares to draw attention to — an active fleet in Fleets, a
         running timer in Runs — full opacity, the accent edge. `.idle` is the quiet counterpart: dimmed as a whole
         (background AND text together, so the ink-to-background ratio inside the card does not change, only how
         much the card asks to be looked at) with a dim edge. `.warn` is Fleets' own third state ("active, but in a
         DIFFERENT fleet") and is here for any caller that needs an amber accent — Runs has no such state and never
         sets it. -->
    <Style Selector="Border.statuscard">
        <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Background" Value="#06FFFFFF"/>
        <Setter Property="Padding" Value="8,7"/>
    </Style>
    <Style Selector="Border.statuscard.idle">
        <Setter Property="Opacity" Value="0.74"/>
    </Style>
    <!-- The 2px edge is a second border inside the card, so its colour is a class and not the border's. -->
    <Style Selector="Border.statuscardedge">
        <Setter Property="Width" Value="2"/>
        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <!-- Pulled out to the card's own edge: the negative margin undoes the card's padding on that side. -->
        <Setter Property="Margin" Value="-8,-7,6,-7"/>
    </Style>
    <Style Selector="Border.statuscardedge.idle">
        <Setter Property="Background" Value="{StaticResource TextDimBrush}"/>
    </Style>
    <Style Selector="Border.statuscardedge.warn">
        <Setter Property="Background" Value="{StaticResource WarnBrush}"/>
    </Style>
    <Style Selector="TextBlock.statuscardname">
        <Setter Property="Foreground" Value="{StaticResource TextBrightBrush}"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style Selector="TextBlock.statuscardwhat">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style Selector="TextBlock.statuscardwhere">
        <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
        <Setter Property="FontSize" Value="9.5"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Setter Property="Margin" Value="0,1,0,7"/>
    </Style>
    <Style Selector="TextBlock.statuscardclock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
        <Setter Property="FontSize" Value="19"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource AccentBrightBrush}"/>
        <Setter Property="VerticalAlignment" Value="Bottom"/>
    </Style>
    <!-- A card without room for extra rows drops the "where" line and shrinks name/what/clock — the mockup's
         758 px lane: no third line, a 15px clock. -->
    <Style Selector="Border.statuscard.slim TextBlock.statuscardclock">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="Margin" Value="0,4,0,0"/>
    </Style>
    <Style Selector="Border.statuscard.slim TextBlock.statuscardwhere">
        <Setter Property="IsVisible" Value="False"/>
    </Style>
    <Style Selector="Border.statuscard.slim TextBlock.statuscardwhat">
        <Setter Property="FontSize" Value="10"/>
    </Style>
    <Style Selector="Border.statuscard.slim TextBlock.statuscardname">
        <Setter Property="FontSize" Value="11"/>
    </Style>
    <Style Selector="Border.statuscard.warn TextBlock.statuscardclock">
        <Setter Property="Foreground" Value="{StaticResource WarnBrush}"/>
    </Style>
    <Style Selector="Border.statuscard.idle TextBlock.statuscardclock">
        <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
    </Style>

    <!-- ── A fleet member's solar system (ET-43) ──
         Application-level on purpose: this readout appears in the fleet-metrics rows AND in the DPS pop-out, which
         is its own window and inherits nothing from the screen that opened it. One rule here means one colour, and
         .withfc reuses the badge's green above so "standing with the FC" reads the same wherever it is shown.
         Wearers must not set Foreground themselves — a local value beats a style setter and would never turn green. -->
    <Style Selector="TextBlock.location">
        <Setter Property="Foreground" Value="{DynamicResource TextAccentBrush}"/>
    </Style>
    <Style Selector="TextBlock.location.withfc">
        <Setter Property="Foreground" Value="{StaticResource GreenBrush}"/>
    </Style>
    <!-- A pilot of ours who is not in game (ET-71). Not scoped to .location, because the per-character metrics
         window shows the same readout without the accent colour — one rule for "we know they are not there",
         wherever it is said. Declared after .withfc so it wins if both were ever set at once: an offline member has
         no location to stand anywhere with, and a green "offline" is the exact confusion this exists to remove. -->
    <Style Selector="TextBlock.offline">
        <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
    </Style>

    <!-- ── Borderless window chrome (D-143): custom title bar + window buttons ── -->
    <Style Selector="Border.titlebar">
        <Setter Property="Background" Value="#EA080604"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
    </Style>
    <Style Selector="Button.winbtn">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="Width" Value="46"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
    </Style>
    <Style Selector="Button.winbtn:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrightBrush}"/>
    </Style>
    <Style Selector="Button.winclose:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#FFCC4444"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>

    <!-- ── Pop-out overlay chrome (ET-73): the three title-bar buttons ──
         Opacity, pin and close are one set and now look like one: same square, same size, same weight, all three
         an icon. The pin used to be a ToggleButton with no style of its own, so it fell through to the stock Fluent
         theme — a rounded, accent-filled pill with the word PIN in it, between two small squares.

         Application-level because both pop-out windows are windows of their own and inherit nothing from anything
         (the ET-43 rule). Small and quiet on purpose: this chrome lies over the game and must never weigh more than
         the readout underneath it. -->
    <Style Selector="Button.overlaybtn, ToggleButton.overlaybtn">
        <Setter Property="Width" Value="22"/>
        <Setter Property="Height" Value="22"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="Background" Value="#22FFFFFF"/>
        <Setter Property="Foreground" Value="{DynamicResource TextAccentBrush}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
    </Style>
    <!-- Every state's ink is set on the ContentPresenter, not on the button. An icon takes its colour by inheritance
         (MaterialIcon and TextBlock both do), and the stock Fluent theme sets its own Foreground ON THE PRESENTER for
         :pointerover and :checked — a rule one level up loses to it. That is not theory: the pinned tack rendered
         near-white on the accent square until these moved down, which is the state the button exists to report. -->
    <Style Selector="Button.overlaybtn:pointerover /template/ ContentPresenter,
                     ToggleButton.overlaybtn:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrightBrush}"/>
    </Style>

    <!-- Pinned. The word PIN carried the on-state before; an icon on its own cannot, so the whole square fills with
         the faction accent and the glyph inverts to near-black. That is deliberately the loudest thing this chrome
         can do: a solid bright block reads as on against ANY game background, at any window size, where a tinted
         border or a brighter glyph would be lost over a nebula or a station backdrop. It is also the one state worth
         being loud about — "is my window still on top" is the entire question that button exists to answer.
         The stock theme's own :checked fill is overridden here, or it would put its rounded blue back. -->
    <Style Selector="ToggleButton.overlaybtn:checked /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentBrightBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrightBrush}"/>
        <Setter Property="Foreground" Value="#FF06070A"/>
    </Style>
    <Style Selector="ToggleButton.overlaybtn:checked:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource TextBrightBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource TextBrightBrush}"/>
        <Setter Property="Foreground" Value="#FF06070A"/>
    </Style>

    <!-- Close keeps the red hover the rest of the app's window chrome has, so the one button you cannot undo is the
         one button that says so before you press it. -->
    <Style Selector="Button.overlaybtn.overlayclose:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#FFCC4444"/>
        <Setter Property="BorderBrush" Value="#FFCC4444"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>

    <!-- ── Module-shell rail (D-182): monochrome icon launcher + per-module item ── -->
    <Style Selector="Border.rail">
        <Setter Property="Background" Value="{DynamicResource RailBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,1,0"/>
    </Style>
    <Style Selector="Button.railitem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
        <Setter Property="BorderThickness" Value="3,0,0,0"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="Padding" Value="4,11"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.railitem:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    </Style>
    <!-- Active module: accent text + soft fill + an inset accent edge (mockup box-shadow:inset 3px). -->
    <Style Selector="Button.railitem.active">
        <Setter Property="Foreground" Value="{DynamicResource AccentBrightBrush}"/>
        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
    </Style>
    <Style Selector="Button.railitem.active /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AccentBrightBrush}"/>
    </Style>
    <Style Selector="Border.rail-divider">
        <Setter Property="Height" Value="1"/>
        <Setter Property="Background" Value="{DynamicResource DividerBrush}"/>
        <Setter Property="Margin" Value="14,5"/>
    </Style>

    <!-- ── Docked module host tab strip (D-182) ── -->
    <Style Selector="ListBox.hosttabs">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
    </Style>
    <Style Selector="ListBox.hosttabs ListBoxItem">
        <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="BorderThickness" Value="0,0,1,0"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="CornerRadius" Value="0"/>
    </Style>
    <Style Selector="ListBox.hosttabs ListBoxItem:selected">
        <Setter Property="Foreground" Value="{StaticResource TextBrightBrush}"/>
    </Style>
    <Style Selector="ListBox.hosttabs ListBoxItem:selected /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
    </Style>

    <!-- The tab-strip overflow flyout (ET-157): same tab look, laid out as a vertical list instead. -->
    <Style Selector="ListBox.hosttabs-overflow">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="4"/>
        <Setter Property="MaxHeight" Value="320"/>
    </Style>
    <Style Selector="ListBox.hosttabs-overflow ListBoxItem">
        <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="CornerRadius" Value="0"/>
    </Style>
    <Style Selector="Button.tabclose">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="Padding" Value="3,1"/>
        <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
    </Style>
    <Style Selector="Button.tabclose:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource RedBrush}"/>
    </Style>

    <!-- ── The fleet screens' navigation bar (ET-171) ──

         One strip, the same on every fleet screen: where you can go from here on the left, what this screen is about
         on the right of it, and the screen's own actions after that. It lives here rather than in each window's own
         DockPanel.Styles for the reason ET-42 wrote down — a rule left on a window is dropped when the module host
         lifts the content out to dock it, so the docked tab and the floating window would not look alike. An
         app-level style is seen from both.

         It sits between the window chrome and the screen's header on purpose: the header says which fleet this is,
         the bar says where this fleet's other screens are. -->
    <Style Selector="Border.fleetnav">
        <Setter Property="Background" Value="#04FFFFFF"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Padding" Value="12,6"/>
    </Style>

    <!-- Quiet until pointed at, like the overview's own row buttons: navigation is not the thing you came for. -->
    <Style Selector="Button.navlink">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="Padding" Value="8,3"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="LetterSpacing" Value="1.1"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.navlink:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BgRowHoverBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrightBrush}"/>
    </Style>

    <!-- The trail: FLEETS › <this fleet> › THIS SCREEN. With several fleet tabs open, all of them titled FLEET
         something, this is where the screen says which fleet you are looking at without you having to read the tab
         you arrived through — and in a floating window there is no tab to read at all. -->
    <Style Selector="TextBlock.crumb">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
        <Setter Property="FontSize" Value="9.5"/>
        <Setter Property="LetterSpacing" Value="1.2"/>
        <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <!-- The leaf: where you are. Bright, and not a button — you are already here. -->
    <Style Selector="TextBlock.crumb.here">
        <Setter Property="Foreground" Value="{DynamicResource AccentBrightBrush}"/>
    </Style>
    <!-- An earlier step, which is a place you can go back to. Underlined dotted so it reads as a link at 9.5px,
         where a colour difference alone does not carry. -->
    <Style Selector="Button.crumblink">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="Padding" Value="1,0"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
        <Setter Property="FontSize" Value="9.5"/>
        <Setter Property="LetterSpacing" Value="1.2"/>
        <Setter Property="Foreground" Value="{DynamicResource TextAccentBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.crumblink:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrightBrush}"/>
    </Style>

    <!-- DataGrid (Avalonia.Controls.DataGrid, added for the FITS fit-browser, D-148). The Fluent DataGrid
         theme is included in App.axaml; these tweaks blend it into the dark EVE panel look. -->
    <Style Selector="DataGrid">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="RowBackground" Value="Transparent"/>
    </Style>
    <Style Selector="DataGridColumnHeader">
        <Setter Property="Foreground" Value="{DynamicResource TextAccentBrush}"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="DataGridCell">
        <Setter Property="Foreground" Value="{StaticResource TextBrightBrush}"/>
        <Setter Property="FontSize" Value="11"/>
    </Style>

    <!-- ── Menu / dropdown / context-menu polish (D-188) ── -->
    <!-- The popup chrome (dark background, accent border, corner radius) + item hover/text colours come from the
         per-faction MenuFlyout* resource keys in Themes/Factions/*.axaml, so they re-tint live with the faction.
         These selectors add what has no resource key: item spacing, a rounded hover highlight, accent-tinted icon
         glyphs, and a non-interactive section header (TextBlock.menuHeader) for menus that want one. Applies app-wide
         to every MenuFlyout, ContextMenu and Menu dropdown. -->
    <Style Selector="MenuItem">
        <Setter Property="Padding" Value="6,4"/>
    </Style>
    <Style Selector="MenuItem:selected /template/ Border#PART_LayoutRoot">
        <Setter Property="CornerRadius" Value="3"/>
    </Style>
    <Style Selector="MenuItem /template/ ContentControl#PART_IconPresenter TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
    </Style>
    <Style Selector="MenuItem /template/ ContentControl#PART_IconPresenter PathIcon">
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
    </Style>
    <Style Selector="MenuFlyoutPresenter TextBlock.menuHeader, ContextMenu TextBlock.menuHeader">
        <Setter Property="Margin" Value="10,7,10,3"/>
        <Setter Property="FontSize" Value="9"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="LetterSpacing" Value="1.6"/>
        <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
    </Style>

    <!-- ── Tooltips (D-188) ── dark themed card with an accent border + breathing room, matching the menus. -->
    <Style Selector="ToolTip">
        <Setter Property="Background" Value="{DynamicResource BgPanelBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="11,9"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="MaxWidth" Value="420"/>
    </Style>

    <!-- ── Toast notifications ── dark card with the faction gold border + a faction-accent severity strip, matching
         the menus/tooltips. Per the Avalonia 12.0.4 NotificationCard template the background/border have no named
         template part (they bind the control's own Background/BorderBrush), so they're set on the control itself; the
         thin severity strip is Panel#PART_HeaderBar — recoloured to the faction accent for success/info so toasts read
         as "ours", while errors/warnings keep their semantic red/amber. Live re-tint via DynamicResource. -->
    <Style Selector="NotificationCard">
        <Setter Property="Background" Value="{DynamicResource BgPanelBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <!-- Roomier than the content's own cap (ToastActionContent.ContentWidthCap), so the card is never the
             tighter of the two constraints. -->
        <Setter Property="MaxWidth" Value="420"/>
    </Style>
    <!-- Compact action-toast buttons (Button.toast-action): the default form-button sizing overflows the card. The
         height floor lives on the ContentPresenter inside the button template, so it is cleared there; content inset +
         card width are handled in ToastActionContent itself (the card gives custom content no padding). -->
    <Style Selector="Button.toast-action">
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Padding" Value="9,2"/>
        <Setter Property="FontSize" Value="10"/>
    </Style>
    <Style Selector="Button.toast-action /template/ ContentPresenter">
        <Setter Property="MinHeight" Value="0"/>
    </Style>
    <!-- The dismiss cross on an action card: chromeless, so it reads as part of the card rather than as a fourth
         answer next to the buttons. Dim until pointed at, the way a close affordance should be. -->
    <Style Selector="Button.toast-dismiss">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="Padding" Value="3"/>
        <Setter Property="Opacity" Value="0.45"/>
    </Style>
    <Style Selector="Button.toast-dismiss:pointerover">
        <Setter Property="Opacity" Value="1"/>
    </Style>
    <Style Selector="Button.toast-dismiss /template/ ContentPresenter">
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="NotificationCard:success /template/ Panel#PART_HeaderBar">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
    </Style>
    <Style Selector="NotificationCard:information /template/ Panel#PART_HeaderBar">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
    </Style>

    <!-- ── Collapsible sections ── the shape ActivityWindow gave the run readout: a flat full-width header row with a
         caret that turns, a fixed-width monospaced title, the summary hard right so a folded section still answers
         for itself, and an indented body of key/value lines under it. Here rather than in one window because the
         activity detail (ET-162) is the same readout unfolded and must not put a second look beside it.
         ActivityWindow still carries its own identical copy in its DockPanel.Styles, which shadows these without
         changing anything; that copy can be dropped in one block once nothing else is open on that file. -->
    <Style Selector="ToggleButton.section">
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="Padding" Value="14,9"/>
    </Style>
    <!-- State ink goes on the presenter: the stock Fluent theme sets its own there for :pointerover and :checked,
         and a rule one level up loses to it. -->
    <Style Selector="ToggleButton.section:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BgRowHoverBrush}"/>
    </Style>
    <Style Selector="ToggleButton.section:checked /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="ToggleButton.section:checked:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BgRowHoverBrush}"/>
    </Style>

    <Style Selector="TextBlock.caret">
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="FontSize" Value="9"/>
        <Setter Property="Width" Value="9"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="RenderTransform" Value="none"/>
    </Style>
    <Style Selector="ToggleButton.section:checked TextBlock.caret">
        <Setter Property="RenderTransform" Value="rotate(90deg)"/>
    </Style>
    <Style Selector="TextBlock.sectiontitle">
        <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="LetterSpacing" Value="1.8"/>
        <Setter Property="Width" Value="96"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="TextBlock.sectionsummary">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrightBrush}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="TextAlignment" Value="Right"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style Selector="Border.sectionbody">
        <Setter Property="Background" Value="{StaticResource BgRowBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Padding" Value="37,2,14,13"/>
    </Style>

    <!-- ── One shared row style for every dense list on the activity detail screen (ET-285): MINING, ENEMIES,
         LOOT, BOUNTY, FLEET, HOMEFRONT. A wide table with many rows is hard to scan by eye alone (Jithran,
         2026-09-14); a faint zebra stripe plus a hover fill is enough to tell one row from its neighbour without
         drawing attention to itself. Each section's own row view-model carries IsAlternate (index % 2 of the
         row's own final list); :pointerover needs no binding at all. Declared in this order so a hovered alt row
         still gets the hover fill: Avalonia resolves an equally-specific tie by declaration order, and a hovered
         alt row ties ".alt" against ":pointerover", so :pointerover coming last is what wins.

         Duplicated once for Border and once for Grid rather than one class-only selector: Border.Background and
         Grid.Background (via Panel) are two independently registered AvaloniaProperties, not one shared through a
         common base, so an untyped ".detailrow" selector cannot resolve which "Background" it is setting
         (AVLN2200). Both halves reference the same two brushes below, so the one thing that actually varies
         between sections — the colour — still lives in exactly one place. -->
    <Style Selector="Border.detailrow">
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="Border.detailrow.alt">
        <Setter Property="Background" Value="{StaticResource BgRowAltBrush}"/>
    </Style>
    <Style Selector="Border.detailrow:pointerover">
        <Setter Property="Background" Value="{DynamicResource BgRowHoverBrush}"/>
    </Style>
    <Style Selector="Grid.detailrow">
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="Grid.detailrow.alt">
        <Setter Property="Background" Value="{StaticResource BgRowAltBrush}"/>
    </Style>
    <Style Selector="Grid.detailrow:pointerover">
        <Setter Property="Background" Value="{DynamicResource BgRowHoverBrush}"/>
    </Style>

    <!-- ── One typography rule per kind of row, applied the same way in every section (ET-285):
         · a NAME (character, ore, item, enemy) — Classes="charname", bright, normal weight, no letter-spacing.
         · a LABEL (SITE, LOCATION, TOTAL, a column header) — Classes="label" (or Grid.kv's own nth-child(1) below,
           which is the same look) — dim, small, letter-spaced caps.
         · an AMOUNT (ISK, a count, a quantity) — Classes="money" (or the section's own numeric variant, e.g.
           MINING's cellnum) — bright, right-aligned, monospace.
         Before this ticket, BOUNTY's and ENEMIES' name column sat inside a "kv" grid built for label/value pairs
         (SITE, LOCATION), so the name inherited the label's letter-spaced small caps — the exact inconsistency
         Jithran's screenshots showed against FLEET's plain names. Fixed at the call site (a name is never inside
         a "kv" grid now), not by carving an exception into "kv" itself.

         "money"/"money.total"/"totals" moved here from ActivityDetailWindow.axaml's own Styles (ET-285 round 2):
         that scoped them to the detail screen alone, which was fine for BOUNTY/ENEMIES/MINING/FLEET/HOMEFRONT's own
         TOTAL rows (those view-models only ever render inside the detail screen) but not for LOOT's GROUP TOTAL —
         ActivityLootView is shared with the live run window, where these classes resolved to nothing and left
         LOOT's own bespoke "grouptotal" Border as the only thing giving it a look at all. Global now, so LOOT's
         total reads the same as everyone else's total in both places at once. -->
    <Style Selector="TextBlock.money">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrightBrush}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="TextAlignment" Value="Right"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="TextBlock.money.total">
        <Setter Property="Foreground" Value="{DynamicResource AccentBrightBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>
    <Style Selector="Border.totals">
        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="Margin" Value="0,2,0,4"/>
    </Style>

    <!-- ColumnDefinitions is not a styled property, so the columns stay on each Grid; everything else about a
         key/value line lives here. The label carries the letterspacing, the value carries the ink. -->
    <Style Selector="Grid.kv">
        <Setter Property="Margin" Value="0,3"/>
    </Style>
    <Style Selector="Grid.kv > TextBlock:nth-child(1)">
        <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="LetterSpacing" Value="1.8"/>
    </Style>
    <Style Selector="Grid.kv > TextBlock:nth-child(2)">
        <Setter Property="Foreground" Value="{StaticResource TextBrightBrush}"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="TextAlignment" Value="Right"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <!-- ET-226 fixed this once for the TYPE row alone (an icon beside its name) by restating brightness, size and
         right alignment locally; ET-253 found the same gap on BONUS ISK (a figure beside a countdown chip) and
         fixes it here instead, structurally: a value that is not a bare TextBlock still gets the same treatment,
         whatever it turns out to be. TextElement.Foreground/FontSize are attached and inherited, so an inner
         TextBlock that sets neither of its own (the plain value text) picks them up; one that already carries its
         own colour (a chip's countdown text, styled by Border.chip) keeps it, since that is the nearer ancestor. -->
    <Style Selector="Grid.kv > StackPanel:nth-child(2)">
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="TextElement.Foreground" Value="{StaticResource TextBrightBrush}"/>
        <Setter Property="TextElement.FontSize" Value="11.5"/>
    </Style>

    <!-- Where a section says what it does NOT know, and why. -->
    <Style Selector="TextBlock.hint">
        <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
        <Setter Property="FontSize" Value="9.5"/>
        <Setter Property="LineHeight" Value="14"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,6,0,0"/>
    </Style>

    <!-- ── One row per character (HOMEFRONT and FLEET, run window and detail screen alike, ET-271/272) ──
         Here rather than in each section view: the four views draw the same row, and two copies of a style drift. -->
    <!-- "Local" and the accent bar say which characters are this client's own — the one thing it knows. -->
    <Style Selector="Border.localtag">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="4,0,4,1"/>
        <Setter Property="Margin" Value="6,0,0,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Border.localtag TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource AccentBrightBrush}"/>
        <Setter Property="FontSize" Value="9"/>
        <Setter Property="LetterSpacing" Value="1.2"/>
    </Style>
    <Style Selector="Border.localbar">
        <Setter Property="Width" Value="2"/>
        <Setter Property="Margin" Value="0,2,6,2"/>
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="Border.localbar.on">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
    </Style>
    <Style Selector="TextBlock.charname">
        <Setter Property="Foreground" Value="{StaticResource TextBrightBrush}"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <!-- What the evidence says, beside the name: a hint, never the decision itself. -->
    <Style Selector="TextBlock.rowhint">
        <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
        <Setter Property="FontSize" Value="9.5"/>
        <Setter Property="Margin" Value="8,0,0,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style Selector="TextBlock.rowhint.warn">
        <Setter Property="Foreground" Value="{StaticResource WarnBrush}"/>
    </Style>
    <!-- A figure on a row: the word dim, the number bright, so a line of three figures still reads at a glance. -->
    <Style Selector="TextBlock.figlabel">
        <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
        <Setter Property="FontSize" Value="9.5"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="TextBlock.figvalue">
        <Setter Property="Foreground" Value="{StaticResource TextBrightBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Margin" Value="4,0,0,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- ── A switch of a few words (HOMEFRONT's outcome, ET-271) ── one lit, the rest quiet; clicking another moves
         it. Joined into one bar, so it reads as one control with a position rather than as three buttons. -->
    <Style Selector="Button.seg">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,3"/>
        <Setter Property="Margin" Value="-1,0,0,0"/>
        <Setter Property="FontSize" Value="10.5"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.seg:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BgRowHoverBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrightBrush}"/>
    </Style>
    <Style Selector="Button.seg.on /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrightBrush}"/>
    </Style>
    <!-- Lit is said in weight too, not by a tint alone. -->
    <Style Selector="Button.seg.on">
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="ZIndex" Value="1"/>
    </Style>
    <Style Selector="Button.seg.on.bad /template/ ContentPresenter">
        <Setter Property="Background" Value="#33EF5A5A"/>
        <Setter Property="BorderBrush" Value="{StaticResource RedBrush}"/>
    </Style>

    <!-- ── A figure that opens an editor when clicked (a homefront payout, ET-271) ── reads as the number it is, with
         a dotted rule under it that says it can be clicked, rather than as a field waiting to be filled. -->
    <Style Selector="Button.amount">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrightBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.amount:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AccentBrightBrush}"/>
    </Style>
    <!-- A typed figure stays marked as one: accent ink, so it is never mistaken for the table's own. -->
    <Style Selector="Button.amount.corrected">
        <Setter Property="Foreground" Value="{DynamicResource AccentBrightBrush}"/>
    </Style>
    <Style Selector="TextBox.amountedit">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Padding" Value="4,1"/>
        <Setter Property="Width" Value="96"/>
        <Setter Property="TextAlignment" Value="Right"/>
    </Style>
    <!-- Focused, the theme would paint the box near-white under light text; it stays the window's own dark. -->
    <Style Selector="TextBox.amountedit:focus /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="#1AFFFFFF"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
    </Style>
    <Style Selector="TextBox.amountedit:focus">
        <Setter Property="Foreground" Value="{StaticResource TextBrightBrush}"/>
    </Style>
    <!-- A quiet word that acts — "leave out of loot split" — shown on the row under the pointer only. -->
    <Style Selector="Button.rowlink">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="FontSize" Value="9.5"/>
        <Setter Property="Foreground" Value="{DynamicResource AccentBrightBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.rowlink:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="TextBlock.TextDecorations" Value="Underline"/>
        <Setter Property="Foreground" Value="{DynamicResource AccentBrightBrush}"/>
    </Style>

</Styles>
